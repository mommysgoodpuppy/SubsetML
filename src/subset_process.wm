/* @subsetml
from "./subset_result.sml" import * as SubsetResult;
from "./subset_host.sml" import * as SubsetHost;
from "./subset_io.sml" import * as SubsetIo;
from "./subset_list.sml" import * as SubsetList;
*/

// Process arguments are host byte strings; exit accepts success/failure only.

from "./subset_result.wm" import * as SubsetResult;
from "./subset_host.wm" import * as SubsetHost;
from "./subset_io.wm" import * as SubsetIo;
from "./subset_list.wm" import * as SubsetList;

let arguments = () => {
  SubsetResult.andThen(
    SubsetResult.mapError(SubsetHost.arguments(), (message) => { SubsetIo.HostError(message) }),
    (values) => {
      SubsetList.traverse(
        values,
        (value) => {
          SubsetResult.map(SubsetIo.bytes(value), (bytes) => { value })
        }
      )
    }
  )
};
// Exit never returns, including in the portable type system.
let exit = (success) => {
  let void = SubsetHost.exit(success);
  let rec unreachable = () => { unreachable() };
  unreachable()
};
