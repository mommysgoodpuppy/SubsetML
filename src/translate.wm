/* Whole-file translation. By spec M1 a file has at most one structure, so each SubsetML file
   becomes one Workman module: `structure FooBar` in foo_bar.sml becomes foo_bar.wm, and the
   file's other top-level declarations join the module. */

from "./subset_option_value.wm" import * as SubsetOptionValue;
from "./syntax.wm" import * as Syntax;
from "./sml_list.wm" import * as SmlList;
from "./subset_list.wm" import * as SubsetList;
from "./compiler_text.wm" import * as CompilerText;
from "./subset_char.wm" import * as SubsetChar;
from "./subset_bool.wm" import * as SubsetBool;
from "./unify.wm" import * as Unify;
from "./types.wm" import * as Types;
from "./basis.wm" import * as Basis;
from "./elab.wm" import * as Elab;
from "./doc.wm" import * as Doc;
from "./wm_print.wm" import * as WmPrint;
from "./subset_string.wm" import * as SubsetString;
from "./wm_lexer.wm" import * as WmLexer;
from "./backend_names.wm" import * as BackendNames;
from "./env.wm" import * as Env;
from "./sml_print.wm" import * as SmlPrint;
from "./wm_parse.wm" import * as WmParse;

export from "./subset_option_value.wm" import *;

export from "./syntax.wm" import *;

// ---------------------------------------------------------------------------------------
// The structures a phrase refers to: the first qualifier of each long identifier.

let head = match {
  [] => { [] },
  [q, .._] => { [q] }
};

let concatMap = (f, xs) => { SmlList.concat(SmlList.map(f)(xs)) };

let rec tyQuals = match {
  TyVar(_) => { [] },
  TyCon(args, (Var(qs), _)) => { SubsetList.append(head(qs), concatMap(tyQuals, args)) },
  TyTuple(ts) => { concatMap(tyQuals, ts) },
  TyArrow(a, b) => { SubsetList.append(tyQuals(a), tyQuals(b)) },
  TyRecord(fields) => { concatMap((_, t) => { tyQuals(t) }, fields) }
};

let rec patQuals = match {
  PWild => { [] },
  PScon(_, _) => { [] },
  PId(_, (Var(qs), _)) => { head(qs) },
  PPinned(_, (Var(qs), _)) => { head(qs) },
  PComputed(_, e) => { expQuals(e) },
  PRecord(_, fields) => { concatMap((_, p) => { patQuals(p) }, fields) },
  PTuple(ps) => { concatMap(patQuals, ps) },
  PList(ps) => { concatMap(patQuals, ps) },
  PApp(_, (Var(qs), _), p) => { SubsetList.append(head(qs), patQuals(p)) },
  PTyped(p, t) => { SubsetList.append(patQuals(p), tyQuals(t)) }
}

and expQuals = match {
  EScon(_, _) => { [] },
  EId(_, (Var(qs), _)) => { head(qs) },
  ERecord(_, fields) => { concatMap((_, e) => { expQuals(e) }, fields) },
  ESelect(_, _) => { [] },
  ECopy(_, source, target, t) => {
    SubsetList.concat([expQuals(source), expQuals(target), tyQuals(t)])
  },
  ETuple(es) => { concatMap(expQuals, es) },
  EList(es) => { concatMap(expQuals, es) },
  ESeq(es) => { concatMap(expQuals, es) },
  ELet(ds, es) => {
    SubsetList.append(concatMap(decQuals, ds), concatMap(expQuals, es))
  },
  EApp(f, a) => { SubsetList.append(expQuals(f), expQuals(a)) },
  ETyped(e, t) => { SubsetList.append(expQuals(e), tyQuals(t)) },
  EAndalso(a, b) => { SubsetList.append(expQuals(a), expQuals(b)) },
  EOrelse(a, b) => { SubsetList.append(expQuals(a), expQuals(b)) },
  EIf(c, a, b) => { SubsetList.concat([expQuals(c), expQuals(a), expQuals(b)]) },
  ECase(e, rules) => { SubsetList.append(expQuals(e), ruleQuals(rules)) },
  EFn(rules) => { ruleQuals(rules) }
}

and ruleQuals = (rules) => {
  concatMap((p, e) => { SubsetList.append(patQuals(p), expQuals(e)) }, rules)
}

and decQuals = match {
  DVal(_, _, plain, recs) => { ruleQuals(SubsetList.append(plain, recs)) },
  DType(_, binds) => { concatMap((_, _, t) => { tyQuals(t) }, binds) },
  DDatatype(_, binds) => {
    concatMap(
      (_, _, cons) => {
        concatMap(
          match {
            (_, _, None) => { [] },
            (_, _, Some(t)) => { tyQuals(t) }
          },
          cons
        )
      },
      binds
    )
  },
  DOpen(_, ids) => { concatMap(head, ids) },
  DLocal(_, hidden, body) => { concatMap(decQuals, SubsetList.append(hidden, body)) }
};

let decPos = match {
  DVal(p, _, _, _) => { p },
  DType(p, _) => { p },
  DDatatype(p, _) => { p },
  DOpen(p, _) => { p },
  DLocal(p, _, _) => { p }
};

// ---------------------------------------------------------------------------------------
/* Dropping a qualifier. Outside its structure, `Main.main` refers to a binding of the same
   Workman module, where it is plain `main`. */

let unqualify = (self, id) => {
  match(id) {
    ([q, ..rest], Var(x)) => { if (q == self) { (rest, x) } else { id } },
    _ => { id }
  }
};

let rec tyStrip = (self, t) => {
  match(t) {
    TyVar(_) => { t },
    TyCon(args, id) => {
      TyCon(SmlList.map((a) => { tyStrip(self, a) })(args), unqualify(self, id))
    },
    TyTuple(ts) => { TyTuple(SmlList.map((a) => { tyStrip(self, a) })(ts)) },
    TyArrow(a, b) => { TyArrow(tyStrip(self, a), tyStrip(self, b)) },
    TyRecord(fields) => {
      TyRecord(SmlList.map((l, a) => { (l, tyStrip(self, a)) })(fields))
    }
  }
};

let rec patStrip = (self, p) => {
  let go = (q) => { patStrip(self, q) };
  match(p) {
    PId(pos, id) => { PId(pos, unqualify(self, id)) },
    PRecord(pos, fields) => { PRecord(pos, SmlList.map((l, q) => { (l, go(q)) })(fields)) },
    PTuple(ps) => { PTuple(SmlList.map(go)(ps)) },
    PList(ps) => { PList(SmlList.map(go)(ps)) },
    PApp(pos, id, q) => { PApp(pos, unqualify(self, id), go(q)) },
    PTyped(q, t) => { PTyped(go(q), tyStrip(self, t)) },
    _ => { p }
  }
};

let rec expStrip = (self, e) => {
  let go = (x) => { expStrip(self, x) };
  let rules = (rs) => { SmlList.map((p, x) => { (patStrip(self, p), go(x)) })(rs) };
  match(e) {
    EId(pos, id) => { EId(pos, unqualify(self, id)) },
    ERecord(pos, fields) => { ERecord(pos, SmlList.map((l, x) => { (l, go(x)) })(fields)) },
    ETuple(es) => { ETuple(SmlList.map(go)(es)) },
    EList(es) => { EList(SmlList.map(go)(es)) },
    ESeq(es) => { ESeq(SmlList.map(go)(es)) },
    ELet(ds, es) => {
      ELet(SmlList.map((d) => { decStrip(self, d) })(ds), SmlList.map(go)(es))
    },
    EApp(f, a) => { EApp(go(f), go(a)) },
    ETyped(x, t) => { ETyped(go(x), tyStrip(self, t)) },
    ECopy(p, source, target, t) => { ECopy(p, go(source), go(target), tyStrip(self, t)) },
    EAndalso(a, b) => { EAndalso(go(a), go(b)) },
    EOrelse(a, b) => { EOrelse(go(a), go(b)) },
    EIf(c, a, b) => { EIf(go(c), go(a), go(b)) },
    ECase(x, rs) => { ECase(go(x), rules(rs)) },
    EFn(rs) => { EFn(rules(rs)) },
    _ => { e }
  }
}

and decStrip = (self, d) => {
  let rules = (rs) => {
    SmlList.map((p, x) => { (patStrip(self, p), expStrip(self, x)) })(rs)
  };
  match(d) {
    DVal(pos, vs, plain, recs) => { DVal(pos, vs, rules(plain), rules(recs)) },
    DType(pos, binds) => {
      DType(pos, SmlList.map((vs, n, t) => { (vs, n, tyStrip(self, t)) })(binds))
    },
    DDatatype(pos, binds) => {
      DDatatype(
        pos,
        SmlList.map((vs, n, cons) => {
          (
            vs,
            n,
            SmlList.map(match {
              (Var(cp), Var(c), None) => { (cp, c, None) },
              (Var(cp), Var(c), Some(t)) => { (cp, c, Some(tyStrip(self, t))) }
            })(cons)
          )
        })(binds)
      )
    },
    DOpen(_, _) => { d },
    DLocal(pos, hidden, body) => {
      DLocal(
        pos,
        SmlList.map((d) => { decStrip(self, d) })(hidden),
        SmlList.map((d) => { decStrip(self, d) })(body)
      )
    }
  }
};

// ---------------------------------------------------------------------------------------
/* Coding conventions (docs/conventions.md). Breaking one gives a warning, because the
   Workman output would be invalid or mean something else. */

// Workman keywords that SML treats as ordinary identifiers.
let wmKeywords = ["match", "record", "from", "import", "void"];

let isUpper = (s) => { CompilerText.firstIs(s, SubsetChar.isUpper) };

// Every identifier written in a phrase, with the nearest known position.
let rec patNames = (pos, p) => {
  match(p) {
    PId(q, (_, Var(x))) => { [(q, x)] },
    PRecord(q, fields) => { concatMap((l, f) => { [(q, l), ..patNames(q, f)] }, fields) },
    PTuple(ps) => { concatMap((f) => { patNames(pos, f) }, ps) },
    PList(ps) => { concatMap((f) => { patNames(pos, f) }, ps) },
    PApp(q, (_, Var(c)), f) => { [(q, c), ..patNames(q, f)] },
    PTyped(f, _) => { patNames(pos, f) },
    _ => { [] }
  }
};

let rec expNames = (pos, e) => {
  let go = (x) => { expNames(pos, x) };
  match(e) {
    EId(q, (_, Var(x))) => { [(q, x)] },
    ERecord(q, fields) => { concatMap((l, x) => { [(q, l), ..expNames(q, x)] }, fields) },
    ESelect(q, l) => { [(q, l)] },
    ECopy(_, source, target, _) => { SubsetList.append(go(source), go(target)) },
    ETuple(es) => { concatMap(go, es) },
    EList(es) => { concatMap(go, es) },
    ESeq(es) => { concatMap(go, es) },
    ELet(ds, es) => {
      SubsetList.append(concatMap(decNames, ds), concatMap(go, es))
    },
    EApp(f, a) => { SubsetList.append(go(f), go(a)) },
    ETyped(x, _) => { go(x) },
    EAndalso(a, b) => { SubsetList.append(go(a), go(b)) },
    EOrelse(a, b) => { SubsetList.append(go(a), go(b)) },
    EIf(c, a, b) => { SubsetList.concat([go(c), go(a), go(b)]) },
    ECase(x, rules) => { SubsetList.append(go(x), ruleNames(pos, rules)) },
    EFn(rules) => { ruleNames(pos, rules) },
    EScon(_, _) => { [] }
  }
}

and ruleNames = (pos, rules) => {
  concatMap((p, e) => { SubsetList.append(patNames(pos, p), expNames(pos, e)) }, rules)
}

and decNames = match {
  DVal(pos, _, plain, recs) => { ruleNames(pos, SubsetList.append(plain, recs)) },
  DType(pos, binds) => { SmlList.map((_, tycon, _) => { (pos, tycon) })(binds) },
  DDatatype(pos, binds) => {
    concatMap(
      (_, tycon, cons) => {
        [(pos, tycon), ..SmlList.map((cp, c, _) => { (cp, c) })(cons)]
      },
      binds
    )
  },
  DOpen(_, _) => { [] },
  DLocal(_, hidden, body) => { concatMap(decNames, SubsetList.append(hidden, body)) }
};

// Warnings for one module's declarations and expressions.
let conventionWarnings = (decs, exps) => {
  let keyword = (pos, x) => {
    if (SmlList.exists((k) => { k == x })(wmKeywords)) {
      [(pos, "`" ++ x ++ "` is a Workman keyword; the translation will not parse")]
    } else { [] }
  };
  let casing = match {
    DType(pos, binds) => {
      concatMap(
        (_, tycon, _) => {
          if (isUpper(tycon)) { [(pos, "type `" ++ tycon ++ "` should start lowercase")] } else { [] }
        },
        binds
      )
    },
    DDatatype(pos, binds) => {
      concatMap(
        (_, tycon, cons) => {
          SubsetList.append(
            if (isUpper(tycon)) { [(pos, "type `" ++ tycon ++ "` should start lowercase")] } else { [] },
            concatMap(
              (cp, c, _) => {
                if (isUpper(c)) { [] } else { [(cp, "constructor `" ++ c ++ "` should start uppercase")] }
              },
              cons
            )
          )
        },
        binds
      )
    },
    _ => { [] }
  };
  SubsetList.append(
    concatMap(
      keyword,
      SubsetList.append(concatMap(decNames, decs), concatMap((e) => { expNames(0, e) }, exps))
    ),
    concatMap(casing, decs)
  )
};

let distinct = (xs) => {
  SmlList.foldl((x, acc) => {
    if (SmlList.exists((y) => { y == x })(acc)) { acc } else { SubsetList.append(acc, [x]) }
  })([])(xs)
};

// ---------------------------------------------------------------------------------------
// Files

// The file name without directory and extension.
let baseName = (path) => {
  let file = match(SmlList.rev(CompilerText.fields(path, (c) => { c == '/' }))) {
    [last, .._] => { last },
    [] => { path }
  };
  if (CompilerText.isSuffix(file, ".sml")) { CompilerText.slice(file, 0, CompilerText.size(file) - 4) } else { file }
};

// The file's structure name, or "" when it has none.
let structureOf = (prog) => {
  concatMap(
    match {
      TopDecs(sds) => {
        concatMap(
          match {
            SStructure(_, binds) => { SmlList.map((name, _, _) => { name })(binds) },
            SDec(_) => { [] }
          },
          sds
        )
      },
      TopExp(_, _) => { [] }
    },
    prog
  )
};

let structureAliases = (prog) => {
  concatMap(
    match {
      TopDecs(sds) => {
        concatMap(
          match {
            SStructure(_, binds) => { concatMap((_, aliases, _) => { aliases }, binds) },
            SDec(_) => { [] }
          },
          sds
        )
      },
      TopExp(_, _) => { [] }
    },
    prog
  )
};

type Result = Output<String, String, List<(Pos, String)>> | TranslateError<String>; // file name, contents, warnings

/* The file as one module: its structure's name ("" if none), and its phrases in source
   order, with the structure's declarations in place and other phrases unqualified. */
let module = (prog) => {
  let self = match(structureOf(prog)) {
    [name, .._] => { name },
    [] => { "" }
  };
  let phrases = concatMap(
    match {
      TopDecs(sds) => {
        concatMap(
          match {
            SStructure(_, binds) => {
              concatMap((_, _, ds) => { SmlList.map((d) => { TopDecs([SDec(d)]) })(ds) }, binds)
            },
            SDec(d) => { [TopDecs([SDec(decStrip(self, d))])] }
          },
          sds
        )
      },
      TopExp(p, e) => {
        [TopDecs([SDec(DVal(p, [], [(PId(p, ([], "it")), expStrip(self, e))], []))])]
      }
    },
    prog
  );
  (self, phrases)
};

// The declarations and expressions of a module's phrases.
let parts = (phrases) => {
  (
    concatMap(
      match {
        TopDecs(sds) => {
          concatMap(
            match {
              SDec(d) => { [d] },
              SStructure(_, _) => { [] }
            },
            sds
          )
        },
        TopExp(_, _) => { [] }
      },
      phrases
    ),
    concatMap(
      match {
        TopExp(_, e) => { [e] },
        TopDecs(_) => { [] }
      },
      phrases
    )
  )
};

/* Declaration forms without a WM representation are errors, including inside functions.
   Expression compatibility operators remain supported independently of declarations. */
let declarationGaps = (structures, prog) => {
  let rec expressions = (es) => { concatMap(expression, es) }
  and rules = (rs) => {
    SubsetList.append(
      expressions(SmlList.map((_, e) => { e })(rs)),
      concatMap((p, _) => { patterns(p) }, rs)
    )
  }
  and expression = (e) => {
    match(e) {
      EScon(_) => { [] },
      EId(_) => { [] },
      ESelect(_) => { [] },
      ERecord(_, fields) => { expressions(SmlList.map((_, e) => { e })(fields)) },
      ETuple(es) => { expressions(es) },
      EList(es) => { expressions(es) },
      ESeq(es) => { expressions(es) },
      ELet(ds, es) => {
        SubsetList.append(concatMap(declaration, ds), expressions(es))
      },
      EApp(a, b) => { expressions([a, b]) },
      ETyped(e, _) => { expression(e) },
      EAndalso(a, b) => { expressions([a, b]) },
      EOrelse(a, b) => { expressions([a, b]) },
      EIf(a, b, c) => { expressions([a, b, c]) },
      ECase(e, rs) => { SubsetList.append(expression(e), rules(rs)) },
      EFn(rs) => { rules(rs) },
      ECopy(_, a, b, _) => { expressions([a, b]) }
    }
  }
  and patterns = (p) => {
    match(p) {
      PTyped(p, _) => { patterns(p) },
      PRecord(_, fs) => { concatMap((_, p) => { patterns(p) }, fs) },
      PTuple(ps) => { concatMap(patterns, ps) },
      PList(ps) => { concatMap(patterns, ps) },
      PApp(_, _, p) => { patterns(p) },
      _ => { [] }
    }
  }
  and declaration = (d) => {
    match(d) {
      DVal(_, variables, plain, recs) => {
        SubsetList.append(
          if (SubsetBool.not(SmlList.null(variables))) { ["explicit val type variables"] } else {
            if (if (SubsetBool.not(SmlList.null(plain))) { SubsetBool.not(SmlList.null(recs)) } else { false }) { ["mixed plain/recursive val bindings"] } else { [] }
          },
          rules(SubsetList.append(plain, recs))
        )
      },
      DType(_, binds) => {
        if (if (match(binds) {
          [] => { false },
          [_] => { false },
          _ => { true }
        }) {
          SmlList.exists((_, _, t) => {
            match(t) {
              TyRecord(_) => { true },
              _ => { false }
            }
          })(binds)
        } else { false }) { ["type groups containing records"] } else { [] }
      },
      DDatatype(_) => { [] },
      DOpen(_, ids) => {
        if (SmlList.all((id) => { SmlList.exists((s) => { [s] == id })(structures) })(ids)) { [] } else { ["open of a non-project structure"] }
      },
      // Workman has no local blocks: only a structure-level `local` translates (to `private`).
      DLocal(_) => { ["`local` declarations inside expressions"] }
    }
  };
  let rec moduleDeclaration = (d) => {
    match(d) {
      DLocal(_, hidden, body) => {
        concatMap(moduleDeclaration, SubsetList.append(hidden, body))
      },
      _ => { declaration(d) }
    }
  };
  let top = (td) => {
    match(td) {
      TopExp(_, e) => { expression(e) },
      TopDecs(ds) => {
        concatMap(
          match {
            SDec(d) => { moduleDeclaration(d) },
            SStructure(_, binds) => {
              concatMap((_, _, ds) => { concatMap(moduleDeclaration, ds) }, binds)
            }
          },
          ds
        )
      }
    }
  };
  concatMap(top, prog)
};

/* SML closes an unresolved numeric class to int; Workman closes it to Number. A program that
   relies on either default would change meaning in translation, so it must annotate. An int
   constant is never such a site: it is int in SML and printed as an I32 ascription. */
let defaultedSite = (st) => {
  let rec unresolved = (t) => {
    match(Unify.prune(st, t)) {
      Types.TCon(_, ts) => { SmlList.exists(unresolved)(ts) },
      Types.TVar(v) => {
        match(Unify.lookup(st, v)) {
          Unify.Free(Types.KClass(_), _) => { SubsetBool.not(Unify.literalVar(st, v)) },
          _ => { false }
        }
      },
      Types.TArrow(a, b) => { if (unresolved(a)) { true } else { unresolved(b) } },
      Types.TRecord(fs) => { SmlList.exists((_, t) => { unresolved(t) })(fs) },
      _ => { false }
    }
  };
  let Unify.State(_, _, _, _, sites) = st;
  match(sites) {
    None => { None },
    Some(xs) => {
      match(SmlList.mapPartial(match {
        Unify.Defaulted(pos) => { Some(pos) },
        Unify.Operand(pos, t) => { if (unresolved(t)) { Some(pos) } else { None } },
        Unify.Literal(_) => { None }
      })(xs)) {
        [] => { None },
        [pos, .._] => { Some(pos) }
      }
    }
  }
};

let defaultedMessage = "a numeric operation whose type only a default decides (SML int, Workman Real64); annotate it as int or real";

let wmNumbers = (st) => {
  match(defaultedSite(st)) {
    None => { Unify.Ok(void, st) },
    Some(pos) => { Unify.Err(defaultedMessage, pos) }
  }
};

// Bottom-up rewrites of a program's expressions (f) and patterns (g).
let rec mapPat = (g, p) => {
  let go = (x) => { mapPat(g, x) };
  g(match(p) {
    PRecord(q, fs) => { PRecord(q, SmlList.map((l, x) => { (l, go(x)) })(fs)) },
    PTuple(ps) => { PTuple(SmlList.map(go)(ps)) },
    PList(ps) => { PList(SmlList.map(go)(ps)) },
    PApp(q, id, x) => { PApp(q, id, go(x)) },
    PTyped(x, t) => { PTyped(go(x), t) },
    _ => { p }
  })
};

let rec mapExp = (f, g, e) => {
  let go = (x) => { mapExp(f, g, x) };
  let rules = (rs) => { SmlList.map((p, x) => { (mapPat(g, p), go(x)) })(rs) };
  f(match(e) {
    ERecord(p, fs) => { ERecord(p, SmlList.map((l, x) => { (l, go(x)) })(fs)) },
    ETuple(es) => { ETuple(SmlList.map(go)(es)) },
    EList(es) => { EList(SmlList.map(go)(es)) },
    ESeq(es) => { ESeq(SmlList.map(go)(es)) },
    ELet(ds, es) => {
      ELet(SmlList.map((d) => { mapDec(f, g, d) })(ds), SmlList.map(go)(es))
    },
    EApp(a, b) => { EApp(go(a), go(b)) },
    ETyped(x, t) => { ETyped(go(x), t) },
    ECopy(p, source, target, t) => { ECopy(p, go(source), go(target), t) },
    EAndalso(a, b) => { EAndalso(go(a), go(b)) },
    EOrelse(a, b) => { EOrelse(go(a), go(b)) },
    EIf(c, a, b) => { EIf(go(c), go(a), go(b)) },
    ECase(x, rs) => { ECase(go(x), rules(rs)) },
    EFn(rs) => { EFn(rules(rs)) },
    _ => { e }
  })
}

and mapDec = (f, g, d) => {
  match(d) {
    DVal(p, vs, plain, recs) => {
      let rules = (rs) => {
        SmlList.map((pat, e) => { (mapPat(g, pat), mapExp(f, g, e)) })(rs)
      };
      DVal(p, vs, rules(plain), rules(recs))
    },
    DLocal(p, hidden, body) => {
      DLocal(
        p,
        SmlList.map((d) => { mapDec(f, g, d) })(hidden),
        SmlList.map((d) => { mapDec(f, g, d) })(body)
      )
    },
    _ => { d }
  }
};

let mapProgramWith = (f, g, prog) => {
  SmlList.map(match {
    TopDecs(sds) => {
      TopDecs(SmlList.map(match {
        SDec(d) => { SDec(mapDec(f, g, d)) },
        SStructure(p, binds) => {
          SStructure(
            p,
            SmlList.map((n, aliases, ds) => { (n, aliases, SmlList.map((d) => { mapDec(f, g, d) })(ds)) })(binds)
          )
        }
      })(sds))
    },
    TopExp(p, e) => { TopExp(p, mapExp(f, g, e)) }
  })(prog)
};

let mapProgram = (f, prog) => { mapProgramWith(f, (p) => { p }, prog) };

// The structure that owns a sized numeric type: `Word16` for `Word16.word`.
let sizedStructure = (t) => {
  match(t) {
    Types.TCon(n, []) => {
      if (SmlList.exists((m) => { Unify.sameName(n, m) })([Types.int64Name, ..Types.wordNames])) {
        Some(CompilerText.slice(Types.nameOf(n), 0, CompilerText.size(Types.nameOf(n)) - 5))
      } else { None }
    },
    _ => { None }
  }
};

/* Workman spells `div` and `mod` per type: an operation the elaboration resolved to a word
   type or Int64.int names that structure's function, `Word16.div`. */
let sizedDivision = (st, prog) => {
  let Unify.State(_, _, _, _, sites) = st;
  let resolved = SmlList.mapPartial((site) => {
    match(site) {
      Unify.Operand(p, t) => {
        match(Unify.prune(st, t)) {
          Types.TArrow(_, result) => {
            match(sizedStructure(Unify.prune(st, result))) {
              Some(q) => { Some(p, q) },
              None => { None }
            }
          },
          _ => { None }
        }
      },
      _ => { None }
    }
  })(match(sites) {
    Some(xs) => { xs },
    None => { [] }
  });
  let rewrite = (e) => {
    match(e) {
      EId(p, ([], Var(opr))) => {
        if (if (opr == "div") { true } else { opr == "mod" }) {
          match(SmlList.find((q, _) => { p == q })(resolved)) {
            Some(found) => {
              let (_, owner) = found;
              EId(p, ([owner], opr))
            },
            None => { e }
          }
        } else { e }
      },
      _ => { e }
    }
  };
  mapProgram(rewrite, prog)
};

// Translates one parsed file. `structures` names every structure of the program.
let toWm = (structures, path, src, source, comments) => {
  /* The file's standalone elaboration, when its environment can be resolved, decides
     numeric defaults and the per-type spelling of `div` and `mod`. */
  let lenient = match(Basis.initial) {
    Unify.Err(_) => { None },
    Unify.Ok(basis, _) => {
      match(Elab.program(basis, source, Unify.lenient)) {
        Unify.Err(_) => { None },
        Unify.Ok(_, st) => { Some(st) }
      }
    }
  };
  let prog = match(lenient) {
    Some(st) => { sizedDivision(st, source) },
    None => { source }
  };
  let (self, phrases) = module(prog);
  let (decs, exps) = parts(phrases);
  let used = distinct(SubsetList.append(concatMap(decQuals, decs), concatMap(expQuals, exps)));
  let start = match(prog) {
    [TopDecs([SStructure(p, _), .._]), .._] => { p },
    _ => { 0 }
  };
  let aliases = structureAliases(prog);
  let isAlias = (q) => { SmlList.exists((_, name, _) => { name == q })(aliases) };
  let imports = SubsetList.append(
    SmlList.map((q) => {
      Doc.atom(start, "from \"./" ++ WmPrint.fileName(q) ++ "\" import * as " ++ q ++ ";")
    })(SmlList.filter((q) => {
      if (if (q != self) { SubsetBool.not(isAlias(q)) } else { false }) { SmlList.exists((s) => { s == q })(structures) } else { false }
    })(used)),
    SmlList.map((p, name, target) => {
      Doc.atom(
        p,
        "export from \"./" ++ WmPrint.fileName(target) ++ "\" import * as " ++ name ++ ";"
      )
    })(aliases)
  );
  // Reject a numeric default when the file's standalone environment can be resolved.
  let defaulted = match(lenient) {
    None => { false },
    Some(st) => {
      match(defaultedSite(st)) {
        Some(_) => { true },
        None => { false }
      }
    }
  };
  let gaps = SubsetList.append(
    declarationGaps(structures, phrases),
    if (defaulted) { [defaultedMessage] } else { [] }
  );
  let doc = if (SmlList.null(gaps)) {
    Doc.stack(SmlList.map((td) => { WmPrint.topdec(structures, td) })(phrases))
  } else { Doc.text("") };
  let body = match(imports) {
    [] => { doc },
    _ => { Doc.stack([Doc.stack(imports), Doc.text(""), doc]) }
  };
  let expected = WmPrint.fileName(self);
  if (SubsetBool.not(SmlList.null(gaps))) {
    TranslateError(path ++ ": unsupported WM translation: " ++ SubsetString.concatWith(gaps, ", ") ++ "; embedded SML declarations are not supported")
  } else {
    if (if (self != "") { expected != baseName(path) ++ ".wm" } else { false }) {
      TranslateError(path ++ ": structure " ++ self ++ " must be in a file named " ++ CompilerText.slice(expected, 0, CompilerText.size(expected) - 3) ++ ".sml")
    } else {
      Output(
        baseName(path) ++ ".wm",
        WmLexer.generatedHeader(baseName(path)) ++ Doc.render(src, comments, WmPrint.commentStyle, body),
        conventionWarnings(decs, exps)
      )
    }
  }
};

// Traverse expressions without changing source positions or declaration layout.

/* Native source spelling is a backend mapping, not a change to WM names or FFI keys.
   One project-wide prefix is absent from every input byte string. */
let keywordPrefix = BackendNames.prefix;

// Compatibility entry: the source-list backend uses project-wide binding resolution.
let keywordProgram = (prefix, prog) => {
  let (prog, _, _) = BackendNames.module("", [], prog, BackendNames.Supply(prefix, 0, []));
  prog
};

/* Workman equality is ambiguous until elaboration. Only a scalar real comparison is
   rewritten; a second, strict elaboration rejects every remaining invalid SML equality. */
/* Whether the module's environment has a structure: the reader's Basis spellings need theirs,
   and translation without the SubsetML Basis keeps the SML Basis spellings. */
let hasStructure = (env, name) => {
  match(Env.structureAt(env, [name])) {
    Some(_) => { true },
    None => { false }
  }
};

/* A type, with a numeric class that only literals decided closed to Workman's literal
   default: Int32 for integer literals, Real64 for real ones. */
let decided = (st, t) => {
  match(Unify.prune(st, t)) {
    Types.TVar(v) => {
      match(Unify.lookup(st, v)) {
        Unify.Free(Types.KClass(names), _) => {
          let has = (m) => { SmlList.exists((n) => { Unify.sameName(n, m) })(names) };
          if (has(Types.intName)) { Types.TCon(Types.intName, []) } else {
            if (has(Types.realName)) { Types.TCon(Types.realName, []) } else { Types.TVar(v) }
          }
        },
        _ => { Types.TVar(v) }
      }
    },
    Var(resolved) => { resolved }
  }
};

let realEquality = (env, st, prog) => {
  let Unify.State(_, _, _, _, sites) = st;
  let positions = SmlList.mapPartial(match {
    Unify.Operand(p, t) => {
      match(decided(st, t)) {
        Types.TCon(n, []) => {
          if (Unify.sameName(n, Types.realName)) { Some(p) } else { None }
        },
        _ => { None }
      }
    },
    _ => { None }
  })(match(sites) {
    Some(xs) => { xs },
    None => { [] }
  });
  let rewrite = (e) => {
    match(e) {
      EApp(EId(p, ([], Var(opr))), a) => {
        if (if (if (opr == "=") { true } else { opr == "<>" }) { SmlList.exists((q) => { p == q })(positions) } else { false }) {
          if (hasStructure(env, "SubsetReal64")) {
            let equal = EApp(EId(p, (["SubsetReal64"], "equal")), a);
            if (opr == "=") { equal } else { EApp(EId(p, (["SubsetBool"], "not")), equal) }
          } else {
            EApp(EId(p, (["Real"], if (opr == "=") { "==" } else { "!=" })), a)
          }
        } else { e }
      },
      _ => { e }
    }
  };
  mapProgram(rewrite, prog)
};

/* A record update read from Workman, `.{ ..source, x = e }`, once the source's record type is
   known: `let val u = source val x' = e in {x = x', y = #y u, ...} end`. The source and the
   replacements are evaluated once, in source order. */
let recordUpdates = (st, prog) => {
  let Unify.State(_, _, _, _, sites) = st;
  let resolved = SmlList.mapPartial((site) => {
    match(site) {
      Unify.Operand(p, t) => {
        match(Unify.prune(st, t)) {
          Types.TArrow(a, _) => {
            match(Unify.prune(st, a)) {
              Types.TRecord(fields) => { Some(p, SmlList.map((l, _) => { l })(fields)) },
              _ => { None }
            }
          },
          _ => { None }
        }
      },
      _ => { None }
    }
  })(match(sites) {
    Some(xs) => { xs },
    None => { [] }
  });
  let update = (check) => {
    match(check) {
      EList([EApp(ESelect(_, label), _), value]) => { Some(label, value) },
      _ => { None }
    }
  };
  let rewrite = (e) => {
    match(e) {
      EApp(
        EId(p, ([], "`update")),
        ELet([DVal(q, [], [(PId(_, ([], Var(u))), Var(source))], [])], items)
      ) => {
        match(SmlList.find((r, _) => { p == r })(resolved), SubsetList.reverse(items)) {
          (Some(found), [_, ..reversedChecks]) => {
            let (_, labels) = found;
            let updates = SmlList.mapPartial(update)(SubsetList.reverse(reversedChecks));
            let temporary = (label) => { u ++ "_" ++ label };
            let bindings = SmlList.map((label, value) => { DVal(q, [], [(PId(p, ([], temporary(label))), value)], []) })(updates);
            let fieldFor = (label) => {
              if (SmlList.exists((l, _) => { l == label })(updates)) { (label, EId(p, ([], temporary(label)))) } else { (label, EApp(ESelect(p, label), EId(p, ([], u)))) }
            };
            ELet(
              [DVal(q, [], [(PId(p, ([], u)), source)], []), ..bindings],
              [ERecord(p, SmlList.map(fieldFor)(labels))]
            )
          },
          _ => { e }
        }
      },
      _ => { e }
    }
  };
  mapProgram(rewrite, prog)
};

// A backtick string's `${ e }`: the text of e by its resolved type.
/* Workman's `%`, once its operand type is known: `SubsetInt32.rem` or `SubsetReal64.rem`.
   Int64 is MLton-only, like the other sized numbers, and keeps `Int64.rem`. */
let remainders = (env, st, prog) => {
  let Unify.State(_, _, _, _, sites) = st;
  let resolved = SmlList.mapPartial((site) => {
    match(site) {
      Unify.Operand(p, t) => {
        match(Unify.prune(st, t)) {
          Types.TArrow(_, r) => {
            match(decided(st, r)) {
              Types.TCon(n, []) => { Some(p, n) },
              _ => { None }
            }
          },
          _ => { None }
        }
      },
      _ => { None }
    }
  })(match(sites) {
    Some(xs) => { xs },
    None => { [] }
  });
  let integer = (p) => {
    EId(
      p,
      (
        if (hasStructure(env, "SubsetInt32")) { ["SubsetInt32"] } else { ["Int"] },
        "rem"
      )
    )
  };
  let rewrite = (e) => {
    match(e) {
      EId(p, ([], "`not")) => {
        EId(
          p,
          if (hasStructure(env, "SubsetBool")) { (["SubsetBool"], "not") } else { ([], "not") }
        )
      },
      EId(p, ([], "`rem")) => {
        match(SmlList.find((q, _) => { p == q })(resolved)) {
          // Operands that are only literals: Workman's literal default, Int32.
          None => { integer(p) },
          Some(found) => {
            let (_, n) = found;
            if (Unify.sameName(n, Types.realName)) {
              EId(
                p,
                (
                  if (hasStructure(env, "SubsetReal64")) { ["SubsetReal64"] } else { ["Real"] },
                  "rem"
                )
              )
            } else {
              if (Unify.sameName(n, Types.int64Name)) { EId(p, (["Int64"], "rem")) } else { integer(p) }
            }
          }
        }
      },
      _ => { e }
    }
  };
  mapProgram(rewrite, prog)
};

/* Workman's display of a value as text, as `print` and backtick strings show it: a function
   from the type's values to their text, or NONE for a type with no portable display. */
let displayOf = (st) => {
  let text = (p, value) => { EScon(p, SString(value)) };
  let rec join = (p, pieces) => {
    match(pieces) {
      [] => { text(p, "") },
      [only] => { only },
      [first, ..rest] => { EApp(EId(p, ([], "^")), ETuple([first, join(p, rest)])) }
    }
  };
  let name = (depth, index) => {
    "printValue" ++ CompilerText.natural(depth) ++ "_" ++ CompilerText.natural(index)
  };
  let named = (t, n) => { Types.nameOf(n) == t };
  // A function from the type's values to their display, or NONE.
  let rec display = (p, depth, t) => {
    let variable = (index) => { (p, ([], name(depth, index))) };
    let apply = (f, index) => { EApp(f, EId(variable(index))) };
    let one = (body) => { Some(EFn([(PId(variable(0)), body)])) };
    match(decided(st, t)) {
      Types.TCon(n, []) => {
        if (Unify.sameName(n, Types.stringName)) { one(EId(variable(0))) } else {
          if (Unify.sameName(n, Types.charName)) { Some(EId(p, (["SubsetString"], "fromChar"))) } else {
            if (Unify.sameName(n, Types.intName)) { Some(EId(p, (["SubsetInt32"], "toString"))) } else {
              if (Unify.sameName(n, Types.int64Name)) { Some(EId(p, (["Int64"], "toString"))) } else {
                if (Unify.sameName(n, Types.realName)) { Some(EId(p, (["SubsetReal64"], "toString"))) } else {
                  if (Unify.sameName(n, Types.boolName)) {
                    one(EIf(EId(variable(0)), text(p, "true"), text(p, "false")))
                  } else { None }
                }
              }
            }
          }
        }
      },
      Types.TRecord([]) => { Some(EFn([(PWild, text(p, "void"))])) },
      Types.TRecord(fields) => {
        let tuple = SmlList.exists((l, _) => { l == "1" })(fields);
        let rec parts = (fields, index) => {
          match(fields) {
            [] => { Some([]) },
            [(Var(label), Var(ft)), ..rest] => {
              match(display(p, depth + 1, ft), parts(rest, index + 1)) {
                (Some(f), Some(more)) => { Some([(label, index, f), ..more]) },
                _ => { None }
              }
            }
          }
        };
        match(parts(fields, 0)) {
          None => { None },
          Some(ps) => {
            let shown = SmlList.map((label, index, f) => {
              if (tuple) { apply(f, index) } else { join(p, [text(p, label ++ " = "), apply(f, index)]) }
            })(ps);
            let rec separated = (xs) => {
              match(xs) {
                [] => { [] },
                [x] => { [x] },
                [x, ..rest] => { [x, text(p, ", "), ..separated(rest)] }
              }
            };
            let pattern = if (tuple) {
              PTuple(SmlList.map((_, index, _) => { PId(variable(index)) })(ps))
            } else {
              PRecord(p, SmlList.map((label, index, _) => { (label, PId(variable(index))) })(ps))
            };
            Some(EFn([
              (
                pattern,
                join(
                  p,
                  SubsetList.concat([
                    [text(p, if (tuple) { "(" } else { "{ " })],
                    separated(shown),
                    [text(p, if (tuple) { ")" } else { " }" })]
                  ])
                )
              )
            ]))
          }
        }
      },
      Types.TCon(n, [element]) => {
        if (Unify.sameName(n, Types.listName)) {
          match(display(p, depth + 1, element)) {
            None => { None },
            Some(f) => {
              one(join(
                p,
                [
                  text(p, "["),
                  EApp(
                    EId(p, (["SubsetString"], "concatWith")),
                    ETuple([
                      EApp(EId(p, (["SubsetList"], "map")), ETuple([EId(variable(0)), f])),
                      text(p, ", ")
                    ])
                  ),
                  text(p, "]")
                ]
              ))
            }
          }
        } else {
          if (named("option", n)) {
            match(display(p, depth + 1, element)) {
              None => { None },
              Some(f) => {
                Some(EFn([
                  (
                    PApp(p, (["SubsetOptionValue"], "SOME"), PId(variable(0))),
                    join(p, [text(p, "Some("), apply(f, 0), text(p, ")")])
                  ),
                  (PId(p, (["SubsetOptionValue"], "NONE")), text(p, "None"))
                ]))
              }
            }
          } else { None }
        }
      },
      Types.TCon(n, [okType, errType]) => {
        if (named("result", n)) {
          match(display(p, depth + 1, okType), display(p, depth + 1, errType)) {
            (Some(f), Some(g)) => {
              Some(EFn([
                (
                  PApp(p, (["SubsetResultValue"], "Ok"), PId(variable(0))),
                  join(p, [text(p, "Ok("), apply(f, 0), text(p, ")")])
                ),
                (
                  PApp(p, (["SubsetResultValue"], "Err"), PId(variable(0))),
                  join(p, [text(p, "Err("), apply(g, 0), text(p, ")")])
                )
              ]))
            },
            _ => { None }
          }
        } else { None }
      },
      _ => { None }
    }
  };
  display
};

/* Workman's `print`, once its argument type is known: `SubsetIo.printLine` of the value's
   display, as Workman shows it. Text and characters appear as they are, numbers as Workman
   writes them, `void` as `void`, and tuples, lists, records, Option and Result structurally:
   `(1, a)`, `[1, 2]`, `{ x = 1 }`, `Some(2)`. A tuple argument is several arguments,
   `print(a, b)`. A type with no display here keeps the marker, which the target check reports. */
let printing = (env, st, prog) => {
  let Unify.State(_, _, _, _, sites) = st;
  let resolved = SmlList.mapPartial((site) => {
    match(site) {
      Unify.Operand(p, t) => {
        match(Unify.prune(st, t)) {
          Types.TArrow(a, _) => { Some(p, a) },
          _ => { None }
        }
      },
      _ => { None }
    }
  })(match(sites) {
    Some(xs) => { xs },
    None => { [] }
  });
  let display = displayOf(st);
  let line = (p, shown) => { EApp(EId(p, (["SubsetIo"], "printLine")), shown) };
  let rewrite = (e) => {
    match(e) {
      // Without the SubsetML Basis, `print` is SML's, on text.
      EId(p, ([], "`print")) => {
        if (SubsetBool.not(hasStructure(env, "SubsetIo"))) { EId(p, ([], "print")) } else {
          match(SmlList.find((q, _) => { p == q })(resolved)) {
            None => { e },
            Some(found) => {
              let (_, t) = found;
              match(display(p, 0, t)) {
                None => { e },
                Some(f) => {
                  EFn([
                    (PId(p, ([], "printArgument")), line(p, EApp(f, EId(p, ([], "printArgument")))))
                  ])
                }
              }
            }
          }
        }
      },
      EApp(EId(p, ([], "`print")), value) => {
        if (SubsetBool.not(hasStructure(env, "SubsetIo"))) { EApp(EId(p, ([], "print")), value) } else {
          match(SmlList.find((q, _) => { p == q })(resolved)) {
            None => { e },
            Some(found) => {
              let (_, t) = found;
              match(display(p, 0, t)) {
                None => { e },
                Some(f) => { line(p, EApp(f, value)) }
              }
            }
          }
        }
      },
      _ => { e }
    }
  };
  mapProgram(rewrite, prog)
};

let templateText = (env, st, prog) => {
  let Unify.State(_, _, _, _, sites) = st;
  let resolved = SmlList.mapPartial((site) => {
    match(site) {
      Unify.Operand(p, t) => {
        match(Unify.prune(st, t)) {
          Types.TArrow(a, _) => { Some(p, a) },
          _ => { None }
        }
      },
      _ => { None }
    }
  })(match(sites) {
    Some(xs) => { xs },
    None => { [] }
  });
  let display = displayOf(st);
  let call = (p, path, e) => { EApp(EId(p, path), e) };
  let spelled = (structureName, name, fallback) => {
    if (hasStructure(env, structureName)) { ([structureName], name) } else { fallback }
  };
  let rewrite = (e) => {
    match(e) {
      EApp(EId(p, ([], "`show")), value) => {
        match(SmlList.find((q, _) => { p == q })(resolved)) {
          None => { e },
          Some(found) => {
            let (_, t) = found;
            // Other types show as `print` shows them, with the Basis.
            let shown = () => {
              if (SubsetBool.not(hasStructure(env, "SubsetList"))) { e } else {
                match(display(p, 0, t)) {
                  None => { e },
                  Some(f) => { EApp(f, value) }
                }
              }
            };
            match(decided(st, t)) {
              Types.TCon(n, []) => {
                let is = (m) => { Unify.sameName(n, m) };
                if (is(Types.stringName)) { value } else {
                  if (is(Types.charName)) {
                    call(p, spelled("SubsetString", "fromChar", (["String"], "str")), value)
                  } else {
                    if (is(Types.intName)) {
                      call(p, spelled("SubsetInt32", "toString", (["Int"], "toString")), value)
                    } else {
                      if (is(Types.int64Name)) { call(p, (["Int64"], "toString"), value) } else {
                        if (is(Types.realName)) {
                          call(p, spelled("SubsetReal64", "toString", (["Real"], "toString")), value)
                        } else {
                          if (is(Types.boolName)) {
                            EIf(value, EScon(p, SString("true")), EScon(p, SString("false")))
                          } else { shown() }
                        }
                      }
                    }
                  }
                }
              },
              _ => { shown() }
            }
          }
        }
      },
      _ => { e }
    }
  };
  mapProgram(rewrite, prog)
};

/* A Workman integer literal whose context made it real or a word is printed as an SML real or
   word constant: `1` as `1.0`, `0x1F` as `0wx1F`. */
let realLiterals = (st, prog) => {
  let Unify.State(_, _, _, _, sites) = st;
  let isWord = (n) => {
    SmlList.exists((m) => { Unify.sameName(n, m) })(Types.wordNames)
  };
  let isReal = (n) => {
    if (Unify.sameName(n, Types.realName)) { true } else { Unify.sameName(n, Types.real32Name) }
  };
  let kinds = SmlList.mapPartial((site) => {
    match(site) {
      Unify.Literal(p, t) => {
        match(Unify.prune(st, t)) {
          Types.TCon(n, []) => {
            if (isReal(n)) { Some(p, true) } else { if (isWord(n)) { Some(p, false) } else { None } }
          },
          _ => { None }
        }
      },
      _ => { None }
    }
  })(match(sites) {
    Some(xs) => { xs },
    None => { [] }
  });
  let hex = (text) => {
    SubsetList.exists(CompilerText.characters(text), (c) => { c == 'x' })
  };
  let constant = (p, c) => {
    match(c, SmlList.find((q, _) => { p == q })(kinds)) {
      (SInt(text), Some(_, true)) => { if (hex(text)) { c } else { SReal(text ++ ".0") } },
      (SInt(text), Some(_, false)) => {
        if (if (CompilerText.size(text) > 0) { CompilerText.slice(text, 0, 1) == "~" } else { false }) { c } else {
          if (hex(text)) { SWord("0wx" ++ CompilerText.drop(text, 2)) } else { SWord("0w" ++ text) }
        }
      },
      _ => { c }
    }
  };
  let rewrite = (e) => {
    match(e) {
      EScon(p, c) => { EScon(p, constant(p, c)) },
      _ => { e }
    }
  };
  let pattern = (pat) => {
    match(pat) {
      PScon(p, c) => { PScon(p, constant(p, c)) },
      _ => { pat }
    }
  };
  mapProgramWith(rewrite, pattern, prog)
};

/* WM can generalize a pure function-field alias; SML selector applications cannot.
   Probe in the declaration's actual environment, then wrap only a known function.
   The probe state is discarded: the emitted expression is elaborated normally, so
   captured monomorphic variables keep their levels and ordinary partial applications
   retain their source restriction. This first pass handles module-level bindings. */
let portableValues = (env, prog, st) => {
  let used = concatMap(
    match {
      TopDecs(sds) => {
        concatMap(
          match {
            SDec(d) => { decNames(d) },
            SStructure(_, bs) => { concatMap((_, _, ds) => { concatMap(decNames, ds) }, bs) }
          },
          sds
        )
      },
      TopExp(p, e) => { expNames(p, e) }
    },
    prog
  );
  let fresh = (n) => { BackendNames.avoid(SmlList.map((_, x) => { x })(used), n) };
  let rec options = (xs) => {
    match(xs) {
      [] => { Some([]) },
      [None, .._] => { None },
      [Some(x), ..rest] => {
        match(options(rest)) {
          Some(xs) => { Some([x, ..xs]) },
          None => { None }
        }
      }
    }
  };
  /* Find a visible nominal constructor, including imported datatypes. Only identity
     aliases qualify: an alias with permuted/fixed arguments is not a spelling for it. */
  let typeName = (env, nominal) => {
    let rec identity = (i, args) => {
      match(args) {
        [] => { true },
        [Types.TGen(j), ..rest] => { if (i == j) { identity(i + 1, rest) } else { false } },
        _ => { false }
      }
    };
    let rec find = match {
      (Env.Env(structures, types, _), Var(path)) => {
        let rec localType = (types, seen) => {
          match(types) {
            [] => { None },
            [(Var(n), Env.TyStr(arity, body, _)), ..rest] => {
              if (SmlList.exists((x) => { x == n })(seen)) { localType(rest, seen) } else {
                match(body) {
                  Types.TCon(name, args) => {
                    if (if (if (Unify.sameName(name, nominal)) { arity == Types.arityOf(nominal) } else { false }) { identity(0, args) } else { false }) { Some(path, n) } else { localType(rest, [n, ..seen]) }
                  },
                  _ => { localType(rest, [n, ..seen]) }
                }
              }
            }
          }
        };
        let rec imported = (structures, seen) => {
          match(structures) {
            [] => { None },
            [(Var(n), (Var(body), _)), ..rest] => {
              if (SmlList.exists((x) => { x == n })(seen)) { imported(rest, seen) } else {
                match(find(body, SubsetList.append(path, [n]))) {
                  Some(id) => { Some(id) },
                  None => { imported(rest, [n, ..seen]) }
                }
              }
            }
          }
        };
        match(localType(types, [])) {
          Some(id) => { Some(id) },
          None => { imported(structures, []) }
        }
      }
    };
    if (Types.stampOf(nominal) < Types.firstStamp) { Some([], Types.nameOf(nominal)) } else { find(env, []) }
  };
  let copy = (env, p, source, target, layout, st) => {
    match(layout) {
      TyCon(parameters, id) => {
        let variables = concatMap(
          match {
            TyVar(v) => { [v] },
            _ => { [] }
          },
          parameters
        );
        Unify.bind(Elab.exp((env, 1, []), source, st))((sourceType) => (probe) => {
          Unify.bind(Elab.mapRes(
            (v, probe) => {
              let (t, probe) = Unify.fresh(probe, Types.KPlain, 1);
              Unify.Ok((v, t), probe)
            },
            variables,
            probe
          ))((arguments) => (probe) => {
            Unify.bind(Elab.elabTy(env, (v) => { Env.assoc(v, arguments) }, p, layout, probe))((layoutType) => (probe) => {
              Unify.bind(Elab.unifyAt(probe, p, "copied layout", layoutType, sourceType))((_) => (probe) => {
                Unify.bind(Elab.closeDeclaration(0, probe))((_) => (probe) => {
                  let rec syntaxType = (t) => {
                    match(Unify.prune(probe, t)) {
                      Types.TVar(v) => {
                        match(Unify.lookup(probe, v)) {
                          Unify.Free(kind, level) => {
                            if (level <= 0) { None } else {
                              match(kind) {
                                Types.KClass(_) => { None },
                                _ => {
                                  Some(TyVar((match(kind) {
                                    Types.KEq => { "''" },
                                    _ => { "'" }
                                  }) ++ fresh("subsetmlCopy" ++ CompilerText.natural(p) ++ "Variable" ++ CompilerText.natural(v))))
                                }
                              }
                            }
                          },
                          _ => { None }
                        }
                      },
                      Types.TRigid(_) => { None },
                      Types.TGen(_) => { None },
                      Types.TArrow(a, b) => {
                        match(syntaxType(a), syntaxType(b)) {
                          (Some(a), Some(b)) => { Some(TyArrow(a, b)) },
                          _ => { None }
                        }
                      },
                      Types.TCon(n, args) => {
                        match(typeName(env, n), options(SmlList.map(syntaxType)(args))) {
                          (Some(id), Some(args)) => { Some(TyCon(args, id)) },
                          _ => { None }
                        }
                      },
                      Types.TRecord([]) => { Some(TyCon([], ([], "unit"))) },
                      Types.TRecord(fields) => {
                        match(Types.tupleComponents(fields)) {
                          Some(types) => {
                            match(options(SmlList.map(syntaxType)(types))) {
                              Some(types) => { Some(TyTuple(types)) },
                              None => { None }
                            }
                          },
                          None => { None }
                        }
                      }
                    }
                  };
                  let inferred = options(SmlList.map((_, t) => { syntaxType(t) })(arguments));
                  let expanded = match(target) {
                    ERecord(q, fields) => {
                      ERecord(
                        q,
                        SmlList.map((label, value) => {
                          let argument = fresh("subsetmlCopy" ++ CompilerText.natural(p) ++ "_" ++ label);
                          (label, EFn([(PId(p, ([], argument)), EApp(value, EId(p, ([], argument))))]))
                        })(fields)
                      )
                    },
                    _ => { target }
                  };
                  Unify.Ok(
                    match(inferred) {
                      Some(args) => { ETyped(expanded, TyCon(args, id)) },
                      None => { source }
                    },
                    st
                  )
                })
              })
            })
          })
        })
      },
      _ => { Unify.Ok(source, st) }
    }
  };
  let expression = (env, p, e, st) => {
    match(e) {
      ECopy(p, source, target, layout) => { copy(env, p, source, target, layout, st) },
      EApp(ESelect(_, _), EId(_, _)) => {
        Unify.bind(Elab.exp((env, 1, []), e, st))((t) => (probe) => {
          Unify.bind(Elab.closeDeclaration(0, probe))((_) => (probe) => {
            match(Unify.prune(probe, t)) {
              Types.TArrow(_, _) => {
                let arg = fresh("subsetmlAlias" ++ CompilerText.natural(p));
                Unify.Ok(EFn([(PId(p, ([], arg)), EApp(e, EId(p, ([], arg))))]), st)
              },
              _ => { Unify.Ok(e, st) }
            }
          })
        })
      },
      _ => { Unify.Ok(e, st) }
    }
  };
  let rec declaration = (env, d, st) => {
    match(d) {
      DVal(p, vs, [(Var(pattern), Var(e))], []) => {
        match(pattern) {
          PId(_, ([], _)) => {
            Unify.bind(expression(env, p, e, st))((e) => (st) => { Unify.Ok(DVal(p, vs, [(pattern, e)], []), st) })
          },
          _ => { Unify.Ok(d, st) }
        }
      },
      /* Workman's `private`: rewrite both parts, each in its scope. The probe state is
         discarded; the caller elaborates the rewritten `local` itself. */
      DLocal(p, hidden, body) => {
        Unify.bind(declarations(env, hidden, st))((private, hidden') => (probe) => {
          Unify.bind(declarations(Env.plus(env, private), body, probe))((_, body') => (_) => { Unify.Ok(DLocal(p, hidden', body'), st) })
        })
      },
      _ => { Unify.Ok(d, st) }
    }
  }
  and declarations = (env, ds, st) => {
    match(ds) {
      [] => { Unify.Ok((Env.empty, []), st) },
      [d, ..rest] => {
        Unify.bind(declaration(env, d, st))((d) => (st) => {
          Unify.bind(Elab.dec((env, 0, []), d, st))((delta) => (st) => {
            Unify.bind(declarations(Env.plus(env, delta), rest, st))((more, rest) => (st) => { Unify.Ok((Env.plus(delta, more), [d, ..rest]), st) })
          })
        })
      }
    }
  };
  let structureDec = (env, sd, st) => {
    match(sd) {
      SDec(d) => {
        Unify.bind(declaration(env, d, st))((d) => (st) => {
          Unify.bind(Elab.dec((env, 0, []), d, st))((delta) => (st) => { Unify.Ok((delta, SDec(d)), st) })
        })
      },
      SStructure(p, bs) => {
        Unify.bind(Elab.foldRes(
          ((delta, output), (n, aliases, ds), st) => {
            Unify.bind(Elab.structureAliases(env, aliases, st))((nested) => (st) => {
              Unify.bind(declarations(Env.plus(env, nested), ds, st))((body, ds) => (st) => {
                Unify.Ok(
                  (
                    Env.plus(delta, Env.withStructure(n, Env.plus(nested, body), false)),
                    SubsetList.append(output, [(n, aliases, ds)])
                  ),
                  st
                )
              })
            })
          },
          (Env.empty, []),
          bs,
          st
        ))((delta, bs) => (st) => { Unify.Ok((delta, SStructure(p, bs)), st) })
      }
    }
  };
  let rec structures = (env, sds, st) => {
    match(sds) {
      [] => { Unify.Ok((Env.empty, []), st) },
      [sd, ..rest] => {
        Unify.bind(structureDec(env, sd, st))((delta, sd) => (st) => {
          Unify.bind(structures(Env.plus(env, delta), rest, st))((more, rest) => (st) => { Unify.Ok((Env.plus(delta, more), [sd, ..rest]), st) })
        })
      }
    }
  };
  let rec phrases = (env, prog, st) => {
    match(prog) {
      [] => { Unify.Ok((env, []), st) },
      [td, ..rest] => {
        Unify.bind(match(td) {
          TopDecs(sds) => {
            Unify.bind(structures(env, sds, st))((delta, sds) => (st) => { Unify.Ok((delta, TopDecs(sds)), st) })
          },
          _ => {
            Unify.bind(Elab.topdec(env, td, st))((delta) => (st) => { Unify.Ok((delta, td), st) })
          }
        })((delta, td) => (st) => {
          Unify.bind(phrases(Env.plus(env, delta), rest, st))((env, rest) => (st) => { Unify.Ok((env, [td, ..rest]), st) })
        })
      }
    }
  };
  phrases(env, prog, st)
};

/* Check dependencies before a module, regardless of the command-line order. Every
   recovery starts with its dependency closure, so unrelated input files remain independent. */
let recover = (modules, target) => {
  // A round trip reproduces the SML it started from, so the reader keeps SML's spellings.
  let smlSpelling = Env.Env([], [], []);
  let nameOfModule = (_, _, prog, _) => {
    match(structureOf(prog)) {
      [n, .._] => { n },
      [] => { "" }
    }
  };
  let rec decDeps = (d) => {
    match(d) {
      DOpen(_, ids) => { concatMap(head, ids) },
      _ => { decQuals(d) }
    }
  };
  let deps = (_, _, prog, _) => {
    distinct(concatMap(
      match {
        TopDecs(sds) => {
          concatMap(
            match {
              SDec(d) => { decDeps(d) },
              SStructure(_, bs) => {
                concatMap(
                  (_, aliases, ds) => {
                    SubsetList.append(SmlList.map((_, _, target) => { target })(aliases), concatMap(decDeps, ds))
                  },
                  bs
                )
              }
            },
            sds
          )
        },
        TopExp(_, e) => { expQuals(e) }
      },
      prog
    ))
  };
  let rec order = (item, visiting, done, acc) => {
    let name = nameOfModule(item);
    if (SmlList.exists((n) => { n == name })(done)) { Unify.Ok((done, acc), Unify.initial) } else {
      if (SmlList.exists((n) => { n == name })(visiting)) { Unify.Err("cyclic module dependency involving " ++ name, 0) } else {
        let needed = SmlList.filter((m) => {
          if (nameOfModule(m) != name) { SmlList.exists((n) => { n == nameOfModule(m) })(deps(item)) } else { false }
        })(modules);
        let rec walk = match {
          ([], Var(done), Var(acc)) => {
            Unify.Ok(([name, ..done], SubsetList.append(acc, [item])), Unify.initial)
          },
          ([m, ..rest], Var(done), Var(acc)) => {
            Unify.bind(order(m, [name, ..visiting], done, acc))((done, acc) => (_) => { walk(rest, done, acc) })
          }
        };
        walk(needed, done, acc)
      }
    }
  };
  let rec elaborate = match {
    (_, [], Var(st), Var(acc)) => { Unify.Ok(acc, st) },
    (
      Var(env),
      [(Var(path), Var(src), Var(prog), Var(comments)), ..rest],
      Var(st),
      Var(acc)
    ) => {
      let Unify.State(vars, next, sels, recs, _) = st;
      Unify.bind(portableValues(env, prog, Unify.State(vars, next, sels, recs, Some([]))))((env, prog) => (st) => {
        Unify.bind(wmNumbers(st))((_) => (st) => {
          elaborate(
            env,
            rest,
            st,
            SubsetList.append(
              acc,
              [
                (
                  path,
                  src,
                  recordUpdates(
                    st,
                    printing(
                      smlSpelling,
                      st,
                      remainders(
                        smlSpelling,
                        st,
                        templateText(smlSpelling, st, realLiterals(st, realEquality(smlSpelling, st, prog)))
                      )
                    )
                  ),
                  comments
                )
              ]
            )
          )
        })
      })
    }
  };
  let rec strict = match {
    (_, [], Var(st)) => { Unify.Ok(void, st) },
    (Var(env), [(_, _, Var(prog), _), ..rest], Var(st)) => {
      Unify.bind(Elab.program(env, prog, st))((env) => (st) => { strict(env, rest, st) })
    }
  };
  Unify.bind(order(target, [], [], []))((_, ordered) => (_) => {
    let prefix = BackendNames.prefix(SmlList.map((path, src, _, _) => { (path, src) })(ordered));
    let (planned, names) = BackendNames.project(prefix, SmlList.map((m) => { (nameOfModule(m), deps(m), m) })(ordered));
    let ordered = SmlList.map((_, _, m) => { m })(planned);
    match(BackendNames.failure(names)) {
      Some(_, p, message) => { Unify.Err(message, p) },
      None => {
        Unify.bind(Basis.initial)((basis) => (_) => {
          Unify.bind(elaborate(basis, ordered, Unify.lenient, []))((rewritten) => (_) => {
            Unify.bind(strict(basis, rewritten, Unify.initial))((_) => (st) => {
              match(SmlList.find((m) => { nameOfModule(m) == nameOfModule(target) })(rewritten)) {
                Some(m) => { Unify.Ok(m, st) },
                None => { Unify.Err("missing translated module", 0) }
              }
            })
          })
        })
      }
    }
  })
};

/* Modules arrive in resolved dependency order. Each checker sees only direct imports;
   cache owned structure environments, never an importer's ambient environment. */
/* A project error names its module ahead of the message, so the caller can report it at the
   module's own source position; `unlocated` splits the two again. */
let located = (path, message) => { path ++ "\n" ++ message };
let unlocated = (message) => {
  match(CompilerText.fields(message, (c) => { c == '\n' })) {
    [path, first, ..rest] => { Some(path, SubsetString.concatWith([first, ..rest], "\n")) },
    _ => { None }
  }
};

let recoverProjectWithRuntime = (runtime, modules) => {
  let working = (basis, cache, dependencies) => {
    SmlList.foldl((name, result) => {
      Unify.bind(result)((env) => (st) => {
        match(SmlList.find((key, _) => { key == name })(cache)) {
          None => { Unify.Err("missing resolved dependency " ++ name, 0) },
          Some(_, body) => {
            Unify.Ok(Env.plus(env, Env.withStructure(name, body, false)), st)
          }
        }
      })
    })(Unify.Ok(basis, Unify.initial))(dependencies)
  };
  let own = (env, name) => {
    match(Env.structureAt(env, [name])) {
      None => { Unify.Err("missing translated structure " ++ name, 0) },
      Some(body, _) => {
        let selected = match(runtime) {
          Some(key) => { key == name },
          None => { false }
        };
        let valid = match(Env.value(body, ([], "panic"))) {
          Some(
            ([Types.KPlain], Types.TArrow(Types.TCon(tn, []), Types.TGen(index))),
            Env.SValue
          ) => {
            if (Types.stampOf(tn) == Types.stampOf(Types.stringName)) { index == 0 } else { false }
          },
          _ => { false }
        };
        if (if (selected) { SubsetBool.not(valid) } else { false }) {
          Unify.Err("panic runtime must export panic : string -> 'a", 0)
        } else { Unify.Ok(body, Unify.initial) }
      }
    }
  };
  let rec rewrite = (basis, remaining, cache, st, acc) => {
    match(remaining) {
      [] => { Unify.Ok(SmlList.rev(acc), st) },
      [
        (Var(name), Var(dependencies), (Var(path), Var(src), Var(prog), Var(cs))),
        ..rest
      ] => {
        Unify.bind(working(basis, cache, dependencies))((env) => (_) => {
          let Unify.State(vars, next, sels, recs, _) = st;
          match(Unify.bind(portableValues(env, prog, Unify.State(vars, next, sels, recs, Some([]))))((exports, rewritten) => (next) => {
            Unify.bind(wmNumbers(next))((_) => (next) => {
              Unify.bind(own(exports, name))((body) => (_) => { Unify.Ok((body, rewritten), next) })
            })
          })) {
            Unify.Err(message, pos) => { Unify.Err(located(path, message), pos) },
            Unify.Ok((Var(body), Var(rewritten)), next) => {
              rewrite(
                basis,
                rest,
                [(name, body), ..cache],
                next,
                [
                  (
                    name,
                    dependencies,
                    (
                      path,
                      src,
                      recordUpdates(
                        next,
                        printing(
                          env,
                          next,
                          remainders(
                            env,
                            next,
                            templateText(env, next, realLiterals(next, realEquality(env, next, rewritten)))
                          )
                        )
                      ),
                      cs
                    )
                  ),
                  ..acc
                ]
              )
            }
          }
        })
      }
    }
  };
  let rec strict = (basis, remaining, cache, st) => {
    match(remaining) {
      [] => { Unify.Ok(void, st) },
      [(Var(name), Var(dependencies), (Var(path), _, Var(prog), _)), ..rest] => {
        Unify.bind(working(basis, cache, dependencies))((env) => (_) => {
          match(Unify.bind(Elab.programExports(env, prog, st))((exports) => (next) => {
            Unify.bind(own(exports, name))((body) => (_) => { Unify.Ok(body, next) })
          })) {
            Unify.Err(message, pos) => { Unify.Err(located(path, message), pos) },
            Unify.Ok(body, next) => { strict(basis, rest, [(name, body), ..cache], next) }
          }
        })
      }
    }
  };
  Unify.bind(Basis.initial)((basis) => (_) => {
    Unify.bind(rewrite(basis, modules, [], Unify.lenient, []))((rewritten) => (_) => {
      Unify.bind(strict(basis, rewritten, [], Unify.initial))((_) => (st) => { Unify.Ok(SmlList.map((_, _, m) => { m })(rewritten), st) })
    })
  })
};

let recoverProject = (modules) => { recoverProjectWithRuntime(None, modules) };

// A Workman module as SubsetML: its declarations become the structure named by the file.
let fromWmNamed = (name, aliases, src, decs, exps, comments) => {
  /* Imports disappear from the AST. Anchor the structure before them, so comments
     between an import and the first declaration stay inside the structure. */
  let first = match(WmLexer.lex(src)) {
    WmLexer.Tokens([(WmLexer.WKey("from"), Var(p)), .._], _) => { Some(p) },
    WmLexer.Tokens([(WmLexer.WName(["export"]), Var(p)), (WmLexer.WKey("from"), _), .._], _) => { Some(p) },
    _ => {
      match(decs) {
        [d, .._] => { Some(decPos(d)) },
        [] => { None }
      }
    }
  };
  let structureLine = match(first) {
    Some(p) => { Doc.atom(p, "structure " ++ name ++ " = struct") },
    None => { Doc.text("structure " ++ name ++ " = struct") }
  };
  let structureDoc = Doc.stack([
    structureLine,
    Doc.indent(
      2,
      Doc.stack(SubsetList.append(
        SmlList.map((p, alias, target) => { Doc.atom(p, "structure " ++ alias ++ " = " ++ target) })(aliases),
        SmlList.map(SmlPrint.dec)(decs)
      ))
    ),
    Doc.text("end")
  ]);
  let expDocs = SmlList.map((e) => { Doc.cat(SmlPrint.exp(e), Doc.text(";")) })(exps);
  let doc = match(expDocs) {
    [] => { structureDoc },
    _ => { Doc.stack([Doc.cat(structureDoc, Doc.text(";")), ..expDocs]) }
  };
  Doc.render(src, comments, SmlPrint.commentStyle, doc)
};

let fromWm = (path, src, decs, exps, comments) => {
  fromWmNamed(
    WmParse.structureName(path),
    WmParse.structureAliases(src),
    src,
    decs,
    exps,
    comments
  )
};

// Reprints a parsed file as SubsetML.
let toSml = (src, prog, comments) => {
  // A declaration phrase needs its `;` when an expression phrase follows (Definition §8).
  let rec phrases = match {
    [] => { [] },
    [TopDecs(sds), TopExp(pos, e), ..rest] => {
      [
        Doc.cat(SmlPrint.topdec(TopDecs(sds)), Doc.text(";")),
        ..phrases([TopExp(pos, e), ..rest])
      ]
    },
    [td, ..rest] => { [SmlPrint.topdec(td), ..phrases(rest)] }
  };
  Doc.render(src, comments, SmlPrint.commentStyle, Doc.stack(phrases(prog)))
};
