/* Whole-file translation. By spec M1 a file has at most one structure, so each SubsetML file
   becomes one Workman module: `structure FooBar` in foo_bar.sml becomes foo_bar.wm, and the
   file's other top-level declarations join the module. */

from "./subset_option_value.wm" import * as SubsetOptionValue;
from "./syntax.wm" import * as Syntax;
from "./sml_list.wm" import * as SmlList;
from "./subset_list.wm" import * as SubsetList;
from "./compiler_text.wm" import * as CompilerText;
from "./subset_char.wm" import * as SubsetChar;
from "./subset_bool.wm" import * as SubsetBool;
from "./unify.wm" import * as Unify;
from "./types.wm" import * as Types;
from "./doc.wm" import * as Doc;
from "./wm_print.wm" import * as WmPrint;
from "./basis.wm" import * as Basis;
from "./elab.wm" import * as Elab;
from "./subset_string.wm" import * as SubsetString;
from "./wm_lexer.wm" import * as WmLexer;
from "./backend_names.wm" import * as BackendNames;
from "./env.wm" import * as Env;
from "./sml_print.wm" import * as SmlPrint;
from "./wm_parse.wm" import * as WmParse;

from "./subset_option_value.wm" import *;

from "./syntax.wm" import *;

// ---------------------------------------------------------------------------------------
// The structures a phrase refers to: the first qualifier of each long identifier.

let head = match {
  [] => { [] },
  [q, .._] => { [q] }
};

let concatMap = (f, xs) => { SmlList.concat(SmlList.map(f)(xs)) };

let rec tyQuals = match {
  TyVar(_) => { [] },
  TyCon(args, (Var(qs), _)) => { SubsetList.append(head(qs), concatMap(tyQuals, args)) },
  TyTuple(ts) => { concatMap(tyQuals, ts) },
  TyArrow(a, b) => { SubsetList.append(tyQuals(a), tyQuals(b)) },
  TyRecord(fields) => { concatMap((_, t) => { tyQuals(t) }, fields) }
};

let rec patQuals = match {
  PWild => { [] },
  PScon(_, _) => { [] },
  PId(_, (Var(qs), _)) => { head(qs) },
  PPinned(_, (Var(qs), _)) => { head(qs) },
  PRecord(_, fields) => { concatMap((_, p) => { patQuals(p) }, fields) },
  PTuple(ps) => { concatMap(patQuals, ps) },
  PList(ps) => { concatMap(patQuals, ps) },
  PApp(_, (Var(qs), _), p) => { SubsetList.append(head(qs), patQuals(p)) },
  PTyped(p, t) => { SubsetList.append(patQuals(p), tyQuals(t)) }
};

let rec expQuals = match {
  EScon(_, _) => { [] },
  EId(_, (Var(qs), _)) => { head(qs) },
  ERecord(_, fields) => { concatMap((_, e) => { expQuals(e) }, fields) },
  ESelect(_, _) => { [] },
  ECopy(_, source, target, t) => {
    SubsetList.concat([expQuals(source), expQuals(target), tyQuals(t)])
  },
  ETuple(es) => { concatMap(expQuals, es) },
  EList(es) => { concatMap(expQuals, es) },
  ESeq(es) => { concatMap(expQuals, es) },
  ELet(ds, es) => {
    SubsetList.append(concatMap(decQuals, ds), concatMap(expQuals, es))
  },
  EApp(f, a) => { SubsetList.append(expQuals(f), expQuals(a)) },
  ETyped(e, t) => { SubsetList.append(expQuals(e), tyQuals(t)) },
  EAndalso(a, b) => { SubsetList.append(expQuals(a), expQuals(b)) },
  EOrelse(a, b) => { SubsetList.append(expQuals(a), expQuals(b)) },
  EIf(c, a, b) => { SubsetList.concat([expQuals(c), expQuals(a), expQuals(b)]) },
  ECase(e, rules) => { SubsetList.append(expQuals(e), ruleQuals(rules)) },
  EFn(rules) => { ruleQuals(rules) }
}

and ruleQuals = (rules) => {
  concatMap((p, e) => { SubsetList.append(patQuals(p), expQuals(e)) }, rules)
}

and decQuals = match {
  DVal(_, _, plain, recs) => { ruleQuals(SubsetList.append(plain, recs)) },
  DType(_, binds) => { concatMap((_, _, t) => { tyQuals(t) }, binds) },
  DDatatype(_, binds) => {
    concatMap(
      (_, _, cons) => {
        concatMap(
          match {
            (_, _, None) => { [] },
            (_, _, Some(t)) => { tyQuals(t) }
          },
          cons
        )
      },
      binds
    )
  },
  DOpen(_, ids) => { concatMap(head, ids) }
};

let decPos = match {
  DVal(p, _, _, _) => { p },
  DType(p, _) => { p },
  DDatatype(p, _) => { p },
  DOpen(p, _) => { p }
};

// ---------------------------------------------------------------------------------------
/* Dropping a qualifier. Outside its structure, `Main.main` refers to a binding of the same
   Workman module, where it is plain `main`. */

let unqualify = (self, id) => {
  match(id) {
    ([q, ..rest], Var(x)) => { if (q == self) { (rest, x) } else { id } },
    _ => { id }
  }
};

let rec tyStrip = (self, t) => {
  match(t) {
    TyVar(_) => { t },
    TyCon(args, id) => {
      TyCon(SmlList.map((a) => { tyStrip(self, a) })(args), unqualify(self, id))
    },
    TyTuple(ts) => { TyTuple(SmlList.map((a) => { tyStrip(self, a) })(ts)) },
    TyArrow(a, b) => { TyArrow(tyStrip(self, a), tyStrip(self, b)) },
    TyRecord(fields) => {
      TyRecord(SmlList.map((l, a) => { (l, tyStrip(self, a)) })(fields))
    }
  }
};

let rec patStrip = (self, p) => {
  let go = (q) => { patStrip(self, q) };
  match(p) {
    PId(pos, id) => { PId(pos, unqualify(self, id)) },
    PRecord(pos, fields) => { PRecord(pos, SmlList.map((l, q) => { (l, go(q)) })(fields)) },
    PTuple(ps) => { PTuple(SmlList.map(go)(ps)) },
    PList(ps) => { PList(SmlList.map(go)(ps)) },
    PApp(pos, id, q) => { PApp(pos, unqualify(self, id), go(q)) },
    PTyped(q, t) => { PTyped(go(q), tyStrip(self, t)) },
    _ => { p }
  }
};

let rec expStrip = (self, e) => {
  let go = (x) => { expStrip(self, x) };
  let rules = (rs) => { SmlList.map((p, x) => { (patStrip(self, p), go(x)) })(rs) };
  match(e) {
    EId(pos, id) => { EId(pos, unqualify(self, id)) },
    ERecord(pos, fields) => { ERecord(pos, SmlList.map((l, x) => { (l, go(x)) })(fields)) },
    ETuple(es) => { ETuple(SmlList.map(go)(es)) },
    EList(es) => { EList(SmlList.map(go)(es)) },
    ESeq(es) => { ESeq(SmlList.map(go)(es)) },
    ELet(ds, es) => {
      ELet(SmlList.map((d) => { decStrip(self, d) })(ds), SmlList.map(go)(es))
    },
    EApp(f, a) => { EApp(go(f), go(a)) },
    ETyped(x, t) => { ETyped(go(x), tyStrip(self, t)) },
    ECopy(p, source, target, t) => { ECopy(p, go(source), go(target), tyStrip(self, t)) },
    EAndalso(a, b) => { EAndalso(go(a), go(b)) },
    EOrelse(a, b) => { EOrelse(go(a), go(b)) },
    EIf(c, a, b) => { EIf(go(c), go(a), go(b)) },
    ECase(x, rs) => { ECase(go(x), rules(rs)) },
    EFn(rs) => { EFn(rules(rs)) },
    _ => { e }
  }
}

and decStrip = (self, d) => {
  let rules = (rs) => {
    SmlList.map((p, x) => { (patStrip(self, p), expStrip(self, x)) })(rs)
  };
  match(d) {
    DVal(pos, vs, plain, recs) => { DVal(pos, vs, rules(plain), rules(recs)) },
    DType(pos, binds) => {
      DType(pos, SmlList.map((vs, n, t) => { (vs, n, tyStrip(self, t)) })(binds))
    },
    DDatatype(pos, binds) => {
      DDatatype(
        pos,
        SmlList.map((vs, n, cons) => {
          (
            vs,
            n,
            SmlList.map(match {
              (Var(cp), Var(c), None) => { (cp, c, None) },
              (Var(cp), Var(c), Some(t)) => { (cp, c, Some(tyStrip(self, t))) }
            })(cons)
          )
        })(binds)
      )
    },
    DOpen(_, _) => { d }
  }
};

// ---------------------------------------------------------------------------------------
/* Coding conventions (docs/conventions.md). Breaking one gives a warning, because the
   Workman output would be invalid or mean something else. */

// Workman keywords that SML treats as ordinary identifiers.
let wmKeywords = ["match", "record", "from", "import", "void"];

let isUpper = (s) => { CompilerText.firstIs(s, SubsetChar.isUpper) };

// Every identifier written in a phrase, with the nearest known position.
let rec patNames = (pos, p) => {
  match(p) {
    PId(q, (_, Var(x))) => { [(q, x)] },
    PRecord(q, fields) => { concatMap((l, f) => { [(q, l), ..patNames(q, f)] }, fields) },
    PTuple(ps) => { concatMap((f) => { patNames(pos, f) }, ps) },
    PList(ps) => { concatMap((f) => { patNames(pos, f) }, ps) },
    PApp(q, (_, Var(c)), f) => { [(q, c), ..patNames(q, f)] },
    PTyped(f, _) => { patNames(pos, f) },
    _ => { [] }
  }
};

let rec expNames = (pos, e) => {
  let go = (x) => { expNames(pos, x) };
  match(e) {
    EId(q, (_, Var(x))) => { [(q, x)] },
    ERecord(q, fields) => { concatMap((l, x) => { [(q, l), ..expNames(q, x)] }, fields) },
    ESelect(q, l) => { [(q, l)] },
    ECopy(_, source, target, _) => { SubsetList.append(go(source), go(target)) },
    ETuple(es) => { concatMap(go, es) },
    EList(es) => { concatMap(go, es) },
    ESeq(es) => { concatMap(go, es) },
    ELet(ds, es) => {
      SubsetList.append(concatMap(decNames, ds), concatMap(go, es))
    },
    EApp(f, a) => { SubsetList.append(go(f), go(a)) },
    ETyped(x, _) => { go(x) },
    EAndalso(a, b) => { SubsetList.append(go(a), go(b)) },
    EOrelse(a, b) => { SubsetList.append(go(a), go(b)) },
    EIf(c, a, b) => { SubsetList.concat([go(c), go(a), go(b)]) },
    ECase(x, rules) => { SubsetList.append(go(x), ruleNames(pos, rules)) },
    EFn(rules) => { ruleNames(pos, rules) },
    EScon(_, _) => { [] }
  }
}

and ruleNames = (pos, rules) => {
  concatMap((p, e) => { SubsetList.append(patNames(pos, p), expNames(pos, e)) }, rules)
}

and decNames = match {
  DVal(pos, _, plain, recs) => { ruleNames(pos, SubsetList.append(plain, recs)) },
  DType(pos, binds) => { SmlList.map((_, tycon, _) => { (pos, tycon) })(binds) },
  DDatatype(pos, binds) => {
    concatMap(
      (_, tycon, cons) => {
        [(pos, tycon), ..SmlList.map((cp, c, _) => { (cp, c) })(cons)]
      },
      binds
    )
  },
  DOpen(_, _) => { [] }
};

// Warnings for one module's declarations and expressions.
let conventionWarnings = (decs, exps) => {
  let keyword = (pos, x) => {
    if (SmlList.exists((k) => { k == x })(wmKeywords)) {
      [(pos, "`" ++ x ++ "` is a Workman keyword; the translation will not parse")]
    } else { [] }
  };
  let casing = match {
    DType(pos, binds) => {
      concatMap(
        (_, tycon, _) => {
          if (isUpper(tycon)) { [(pos, "type `" ++ tycon ++ "` should start lowercase")] } else { [] }
        },
        binds
      )
    },
    DDatatype(pos, binds) => {
      concatMap(
        (_, tycon, cons) => {
          SubsetList.append(
            if (isUpper(tycon)) { [(pos, "type `" ++ tycon ++ "` should start lowercase")] } else { [] },
            concatMap(
              (cp, c, _) => {
                if (isUpper(c)) { [] } else { [(cp, "constructor `" ++ c ++ "` should start uppercase")] }
              },
              cons
            )
          )
        },
        binds
      )
    },
    _ => { [] }
  };
  SubsetList.append(
    concatMap(
      keyword,
      SubsetList.append(concatMap(decNames, decs), concatMap((e) => { expNames((0: I32), e) }, exps))
    ),
    concatMap(casing, decs)
  )
};

let distinct = (xs) => {
  SmlList.foldl((x, acc) => {
    if (SmlList.exists((y) => { y == x })(acc)) { acc } else { SubsetList.append(acc, [x]) }
  })([])(xs)
};

// ---------------------------------------------------------------------------------------
// Files

// The file name without directory and extension.
let baseName = (path) => {
  let file = match(SmlList.rev(CompilerText.fields(path, (c) => { c == '/' }))) {
    [last, .._] => { last },
    [] => { path }
  };
  if (CompilerText.isSuffix(file, ".sml")) {
    CompilerText.slice(file, (0: I32), CompilerText.size(file) - (4: I32))
  } else { file }
};

// The file's structure name, or "" when it has none.
let structureOf = (prog) => {
  concatMap(
    match {
      TopDecs(sds) => {
        concatMap(
          match {
            SStructure(_, binds) => { SmlList.map((name, _) => { name })(binds) },
            SDec(_) => { [] }
          },
          sds
        )
      },
      TopExp(_, _) => { [] }
    },
    prog
  )
};

type Result = Output<String, String, List<(Pos, String)>> | TranslateError<String>; // file name, contents, warnings

/* The file as one module: its structure's name ("" if none), and its phrases in source
   order, with the structure's declarations in place and other phrases unqualified. */
let module = (prog) => {
  let self = match(structureOf(prog)) {
    [name, .._] => { name },
    [] => { "" }
  };
  let phrases = concatMap(
    match {
      TopDecs(sds) => {
        concatMap(
          match {
            SStructure(_, binds) => {
              concatMap((_, ds) => { SmlList.map((d) => { TopDecs([SDec(d)]) })(ds) }, binds)
            },
            SDec(d) => { [TopDecs([SDec(decStrip(self, d))])] }
          },
          sds
        )
      },
      TopExp(p, e) => {
        [TopDecs([SDec(DVal(p, [], [(PId(p, ([], "it")), expStrip(self, e))], []))])]
      }
    },
    prog
  );
  (self, phrases)
};

// The declarations and expressions of a module's phrases.
let parts = (phrases) => {
  (
    concatMap(
      match {
        TopDecs(sds) => {
          concatMap(
            match {
              SDec(d) => { [d] },
              SStructure(_, _) => { [] }
            },
            sds
          )
        },
        TopExp(_, _) => { [] }
      },
      phrases
    ),
    concatMap(
      match {
        TopExp(_, e) => { [e] },
        TopDecs(_) => { [] }
      },
      phrases
    )
  )
};

/* Declaration forms without a WM representation are errors, including inside functions.
   Expression compatibility operators remain supported independently of declarations. */
let declarationGaps = (structures, prog) => {
  let rec expressions = (es) => { concatMap(expression, es) }
  and rules = (rs) => {
    SubsetList.append(
      expressions(SmlList.map((_, e) => { e })(rs)),
      concatMap((p, _) => { patterns(p) }, rs)
    )
  }
  and expression = (e) => {
    match(e) {
      EScon(_) => { [] },
      EId(_) => { [] },
      ESelect(_) => { [] },
      ERecord(_, fields) => { expressions(SmlList.map((_, e) => { e })(fields)) },
      ETuple(es) => { expressions(es) },
      EList(es) => { expressions(es) },
      ESeq(es) => { expressions(es) },
      ELet(ds, es) => {
        SubsetList.append(concatMap(declaration, ds), expressions(es))
      },
      EApp(a, b) => { expressions([a, b]) },
      ETyped(e, _) => { expression(e) },
      EAndalso(a, b) => { expressions([a, b]) },
      EOrelse(a, b) => { expressions([a, b]) },
      EIf(a, b, c) => { expressions([a, b, c]) },
      ECase(e, rs) => { SubsetList.append(expression(e), rules(rs)) },
      EFn(rs) => { rules(rs) },
      ECopy(_, a, b, _) => { expressions([a, b]) }
    }
  }
  and patterns = (p) => {
    match(p) {
      PTyped(p, _) => { patterns(p) },
      PRecord(_, fs) => { concatMap((_, p) => { patterns(p) }, fs) },
      PTuple(ps) => { concatMap(patterns, ps) },
      PList(ps) => { concatMap(patterns, ps) },
      PApp(_, _, p) => { patterns(p) },
      _ => { [] }
    }
  }
  and declaration = (d) => {
    match(d) {
      DVal(_, variables, plain, recs) => {
        SubsetList.append(
          if (SubsetBool.not(SmlList.null(variables))) { ["explicit val type variables"] } else {
            if (if (SubsetBool.not(SmlList.null(plain))) { SubsetBool.not(SmlList.null(recs)) } else { false }) { ["mixed plain/recursive val bindings"] } else { [] }
          },
          rules(SubsetList.append(plain, recs))
        )
      },
      DType(_, binds) => {
        if (if (match(binds) {
          [] => { false },
          [_] => { false },
          _ => { true }
        }) {
          SmlList.exists((_, _, t) => {
            match(t) {
              TyRecord(_) => { true },
              _ => { false }
            }
          })(binds)
        } else { false }) { ["type groups containing records"] } else { [] }
      },
      DDatatype(_) => { [] },
      DOpen(_, ids) => {
        if (SmlList.all((id) => { SmlList.exists((s) => { [s] == id })(structures) })(ids)) { [] } else { ["open of a non-project structure"] }
      }
    }
  };
  let top = (td) => {
    match(td) {
      TopExp(_, e) => { expression(e) },
      TopDecs(ds) => {
        concatMap(
          match {
            SDec(d) => { declaration(d) },
            SStructure(_, binds) => { concatMap((_, ds) => { concatMap(declaration, ds) }, binds) }
          },
          ds
        )
      }
    }
  };
  concatMap(top, prog)
};

/* SML closes an unresolved numeric class to int; Workman closes it to Number. A program that
   relies on either default would change meaning in translation, so it must annotate. An int
   constant is never such a site: it is int in SML and printed as an I32 ascription. */
let defaultedSite = (st) => {
  let rec unresolved = (t) => {
    match(Unify.prune(st, t)) {
      Types.TCon(_, ts) => { SmlList.exists(unresolved)(ts) },
      Types.TVar(v) => {
        match(Unify.lookup(st, v)) {
          Unify.Free(Types.KClass(_), _) => { true },
          _ => { false }
        }
      },
      Types.TArrow(a, b) => { if (unresolved(a)) { true } else { unresolved(b) } },
      Types.TRecord(fs) => { SmlList.exists((_, t) => { unresolved(t) })(fs) },
      _ => { false }
    }
  };
  let Unify.State(_, _, _, _, sites) = st;
  match(sites) {
    None => { None },
    Some(xs) => {
      match(SmlList.mapPartial(match {
        Unify.Defaulted(pos) => { Some(pos) },
        Unify.Operand(pos, t) => { if (unresolved(t)) { Some(pos) } else { None } }
      })(xs)) {
        [] => { None },
        [pos, .._] => { Some(pos) }
      }
    }
  }
};

let defaultedMessage = "a numeric operation whose type only a default decides (SML int, Workman Number); annotate it as int or real";

let wmNumbers = (st) => {
  match(defaultedSite(st)) {
    None => { Unify.Ok(void, st) },
    Some(pos) => { Unify.Err(defaultedMessage, pos) }
  }
};

// Translates one parsed file. `structures` names every structure of the program.
let toWm = (structures, path, src, prog, comments) => {
  let (self, phrases) = module(prog);
  let (decs, exps) = parts(phrases);
  let used = distinct(SubsetList.append(concatMap(decQuals, decs), concatMap(expQuals, exps)));
  let start = match(prog) {
    [TopDecs([SStructure(p, _), .._]), .._] => { p },
    _ => { (0: I32) }
  };
  let imports = SmlList.map((q) => {
    Doc.atom(start, "from \"./" ++ WmPrint.fileName(q) ++ "\" import * as " ++ q ++ ";")
  })(SmlList.filter((q) => {
    if (q != self) { SmlList.exists((s) => { s == q })(structures) } else { false }
  })(used));
  // Reject a numeric default when the file's standalone environment can be resolved.
  let defaulted = match(Basis.initial) {
    Unify.Err(_) => { false },
    Unify.Ok(basis, _) => {
      match(Elab.program(basis, prog, Unify.lenient)) {
        Unify.Err(_) => { false },
        Unify.Ok(_, st) => {
          match(defaultedSite(st)) {
            Some(_) => { true },
            None => { false }
          }
        }
      }
    }
  };
  let gaps = SubsetList.append(
    declarationGaps(structures, phrases),
    if (defaulted) { [defaultedMessage] } else { [] }
  );
  let doc = if (SmlList.null(gaps)) {
    Doc.stack(SmlList.map((td) => { WmPrint.topdec(structures, td) })(phrases))
  } else { Doc.text("") };
  let body = match(imports) {
    [] => { doc },
    _ => { Doc.stack([Doc.stack(imports), Doc.text(""), doc]) }
  };
  let expected = WmPrint.fileName(self);
  if (SubsetBool.not(SmlList.null(gaps))) {
    TranslateError(path ++ ": unsupported WM translation: " ++ SubsetString.concatWith(gaps, ", ") ++ "; embedded SML declarations are not supported")
  } else {
    if (if (self != "") { expected != baseName(path) ++ ".wm" } else { false }) {
      TranslateError(path ++ ": structure " ++ self ++ " must be in a file named " ++ CompilerText.slice(expected, (0: I32), CompilerText.size(expected) - (3: I32)) ++ ".sml")
    } else {
      Output(
        baseName(path) ++ ".wm",
        WmLexer.generatedHeader(baseName(path)) ++ Doc.render(src, comments, WmPrint.commentStyle, body),
        conventionWarnings(decs, exps)
      )
    }
  }
};

// Traverse expressions without changing source positions or declaration layout.
let rec mapExp = (f, e) => {
  let go = (x) => { mapExp(f, x) };
  let rules = (rs) => { SmlList.map((p, x) => { (p, go(x)) })(rs) };
  f(match(e) {
    ERecord(p, fs) => { ERecord(p, SmlList.map((l, x) => { (l, go(x)) })(fs)) },
    ETuple(es) => { ETuple(SmlList.map(go)(es)) },
    EList(es) => { EList(SmlList.map(go)(es)) },
    ESeq(es) => { ESeq(SmlList.map(go)(es)) },
    ELet(ds, es) => {
      ELet(SmlList.map((d) => { mapDec(f, d) })(ds), SmlList.map(go)(es))
    },
    EApp(a, b) => { EApp(go(a), go(b)) },
    ETyped(x, t) => { ETyped(go(x), t) },
    ECopy(p, source, target, t) => { ECopy(p, go(source), go(target), t) },
    EAndalso(a, b) => { EAndalso(go(a), go(b)) },
    EOrelse(a, b) => { EOrelse(go(a), go(b)) },
    EIf(c, a, b) => { EIf(go(c), go(a), go(b)) },
    ECase(x, rs) => { ECase(go(x), rules(rs)) },
    EFn(rs) => { EFn(rules(rs)) },
    _ => { e }
  })
}

and mapDec = (f, d) => {
  match(d) {
    DVal(p, vs, plain, recs) => {
      let rules = (rs) => { SmlList.map((pat, e) => { (pat, mapExp(f, e)) })(rs) };
      DVal(p, vs, rules(plain), rules(recs))
    },
    _ => { d }
  }
};

let mapProgram = (f, prog) => {
  SmlList.map(match {
    TopDecs(sds) => {
      TopDecs(SmlList.map(match {
        SDec(d) => { SDec(mapDec(f, d)) },
        SStructure(p, binds) => {
          SStructure(
            p,
            SmlList.map((n, ds) => { (n, SmlList.map((d) => { mapDec(f, d) })(ds)) })(binds)
          )
        }
      })(sds))
    },
    TopExp(p, e) => { TopExp(p, mapExp(f, e)) }
  })(prog)
};

/* Native source spelling is a backend mapping, not a change to WM names or FFI keys.
   One project-wide prefix is absent from every input byte string. */
let keywordPrefix = BackendNames.prefix;

// Compatibility entry: the source-list backend uses project-wide binding resolution.
let keywordProgram = (prefix, prog) => {
  let (prog, _, _) = BackendNames.module("", [], prog, BackendNames.Supply(prefix, (0: I32), []));
  prog
};

/* Workman equality is ambiguous until elaboration. Only a scalar real comparison is
   rewritten; a second, strict elaboration rejects every remaining invalid SML equality. */
let realEquality = (st, prog) => {
  let Unify.State(_, _, _, _, sites) = st;
  let positions = SmlList.mapPartial(match {
    Unify.Operand(p, t) => {
      match(Unify.prune(st, t)) {
        Types.TCon(n, []) => {
          if (Unify.sameName(n, Types.realName)) { Some(p) } else { None }
        },
        _ => { None }
      }
    },
    Unify.Defaulted(_) => { None }
  })(match(sites) {
    Some(xs) => { xs },
    None => { [] }
  });
  let rewrite = (e) => {
    match(e) {
      EApp(EId(p, ([], Var(opr))), a) => {
        if (if (if (opr == "=") { true } else { opr == "<>" }) { SmlList.exists((q) => { p == q })(positions) } else { false }) {
          EApp(EId(p, (["Real"], if (opr == "=") { "==" } else { "!=" })), a)
        } else { e }
      },
      _ => { e }
    }
  };
  mapProgram(rewrite, prog)
};

/* WM can generalize a pure function-field alias; SML selector applications cannot.
   Probe in the declaration's actual environment, then wrap only a known function.
   The probe state is discarded: the emitted expression is elaborated normally, so
   captured monomorphic variables keep their levels and ordinary partial applications
   retain their source restriction. This first pass handles module-level bindings. */
let portableValues = (env, prog, st) => {
  let used = concatMap(
    match {
      TopDecs(sds) => {
        concatMap(
          match {
            SDec(d) => { decNames(d) },
            SStructure(_, bs) => { concatMap((_, ds) => { concatMap(decNames, ds) }, bs) }
          },
          sds
        )
      },
      TopExp(p, e) => { expNames(p, e) }
    },
    prog
  );
  let fresh = (n) => { BackendNames.avoid(SmlList.map((_, x) => { x })(used), n) };
  let rec options = (xs) => {
    match(xs) {
      [] => { Some([]) },
      [None, .._] => { None },
      [Some(x), ..rest] => {
        match(options(rest)) {
          Some(xs) => { Some([x, ..xs]) },
          None => { None }
        }
      }
    }
  };
  /* Find a visible nominal constructor, including imported datatypes. Only identity
     aliases qualify: an alias with permuted/fixed arguments is not a spelling for it. */
  let typeName = (env, nominal) => {
    let rec identity = (i, args) => {
      match(args) {
        [] => { true },
        [Types.TGen(j), ..rest] => { if (i == j) { identity(i + (1: I32), rest) } else { false } },
        _ => { false }
      }
    };
    let rec find = match {
      (Env.Env(structures, types, _), Var(path)) => {
        let rec localType = (types, seen) => {
          match(types) {
            [] => { None },
            [(Var(n), Env.TyStr(arity, body, _)), ..rest] => {
              if (SmlList.exists((x) => { x == n })(seen)) { localType(rest, seen) } else {
                match(body) {
                  Types.TCon(name, args) => {
                    if (if (if (Unify.sameName(name, nominal)) { arity == Types.arityOf(nominal) } else { false }) { identity((0: I32), args) } else { false }) { Some(path, n) } else { localType(rest, [n, ..seen]) }
                  },
                  _ => { localType(rest, [n, ..seen]) }
                }
              }
            }
          }
        };
        let rec imported = (structures, seen) => {
          match(structures) {
            [] => { None },
            [(Var(n), (Var(body), _)), ..rest] => {
              if (SmlList.exists((x) => { x == n })(seen)) { imported(rest, seen) } else {
                match(find(body, SubsetList.append(path, [n]))) {
                  Some(id) => { Some(id) },
                  None => { imported(rest, [n, ..seen]) }
                }
              }
            }
          }
        };
        match(localType(types, [])) {
          Some(id) => { Some(id) },
          None => { imported(structures, []) }
        }
      }
    };
    if (Types.stampOf(nominal) < Types.firstStamp) { Some([], Types.nameOf(nominal)) } else { find(env, []) }
  };
  let copy = (env, p, source, target, layout, st) => {
    match(layout) {
      TyCon(parameters, id) => {
        let variables = concatMap(
          match {
            TyVar(v) => { [v] },
            _ => { [] }
          },
          parameters
        );
        Unify.bind(Elab.exp((env, (1: I32), []), source, st))((sourceType) => (probe) => {
          Unify.bind(Elab.mapRes(
            (v, probe) => {
              let (t, probe) = Unify.fresh(probe, Types.KPlain, (1: I32));
              Unify.Ok((v, t), probe)
            },
            variables,
            probe
          ))((arguments) => (probe) => {
            Unify.bind(Elab.elabTy(env, (v) => { Env.assoc(v, arguments) }, p, layout, probe))((layoutType) => (probe) => {
              Unify.bind(Elab.unifyAt(probe, p, "copied layout", layoutType, sourceType))((_) => (probe) => {
                Unify.bind(Elab.closeDeclaration((0: I32), probe))((_) => (probe) => {
                  let rec syntaxType = (t) => {
                    match(Unify.prune(probe, t)) {
                      Types.TVar(v) => {
                        match(Unify.lookup(probe, v)) {
                          Unify.Free(kind, level) => {
                            if (level <= (0: I32)) { None } else {
                              match(kind) {
                                Types.KClass(_) => { None },
                                _ => {
                                  Some(TyVar((match(kind) {
                                    Types.KEq => { "''" },
                                    _ => { "'" }
                                  }) ++ fresh("subsetmlCopy" ++ CompilerText.natural(p) ++ "Variable" ++ CompilerText.natural(v))))
                                }
                              }
                            }
                          },
                          _ => { None }
                        }
                      },
                      Types.TRigid(_) => { None },
                      Types.TGen(_) => { None },
                      Types.TArrow(a, b) => {
                        match(syntaxType(a), syntaxType(b)) {
                          (Some(a), Some(b)) => { Some(TyArrow(a, b)) },
                          _ => { None }
                        }
                      },
                      Types.TCon(n, args) => {
                        match(typeName(env, n), options(SmlList.map(syntaxType)(args))) {
                          (Some(id), Some(args)) => { Some(TyCon(args, id)) },
                          _ => { None }
                        }
                      },
                      Types.TRecord([]) => { Some(TyCon([], ([], "unit"))) },
                      Types.TRecord(fields) => {
                        match(Types.tupleComponents(fields)) {
                          Some(types) => {
                            match(options(SmlList.map(syntaxType)(types))) {
                              Some(types) => { Some(TyTuple(types)) },
                              None => { None }
                            }
                          },
                          None => { None }
                        }
                      }
                    }
                  };
                  let inferred = options(SmlList.map((_, t) => { syntaxType(t) })(arguments));
                  let expanded = match(target) {
                    ERecord(q, fields) => {
                      ERecord(
                        q,
                        SmlList.map((label, value) => {
                          let argument = fresh("subsetmlCopy" ++ CompilerText.natural(p) ++ "_" ++ label);
                          (label, EFn([(PId(p, ([], argument)), EApp(value, EId(p, ([], argument))))]))
                        })(fields)
                      )
                    },
                    _ => { target }
                  };
                  Unify.Ok(
                    match(inferred) {
                      Some(args) => { ETyped(expanded, TyCon(args, id)) },
                      None => { source }
                    },
                    st
                  )
                })
              })
            })
          })
        })
      },
      _ => { Unify.Ok(source, st) }
    }
  };
  let expression = (env, p, e, st) => {
    match(e) {
      ECopy(p, source, target, layout) => { copy(env, p, source, target, layout, st) },
      EApp(ESelect(_, _), EId(_, _)) => {
        Unify.bind(Elab.exp((env, (1: I32), []), e, st))((t) => (probe) => {
          Unify.bind(Elab.closeDeclaration((0: I32), probe))((_) => (probe) => {
            match(Unify.prune(probe, t)) {
              Types.TArrow(_, _) => {
                let arg = fresh("subsetmlAlias" ++ CompilerText.natural(p));
                Unify.Ok(EFn([(PId(p, ([], arg)), EApp(e, EId(p, ([], arg))))]), st)
              },
              _ => { Unify.Ok(e, st) }
            }
          })
        })
      },
      _ => { Unify.Ok(e, st) }
    }
  };
  let declaration = (env, d, st) => {
    match(d) {
      DVal(p, vs, [(Var(pattern), Var(e))], []) => {
        match(pattern) {
          PId(_, ([], _)) => {
            Unify.bind(expression(env, p, e, st))((e) => (st) => { Unify.Ok(DVal(p, vs, [(pattern, e)], []), st) })
          },
          _ => { Unify.Ok(d, st) }
        }
      },
      _ => { Unify.Ok(d, st) }
    }
  };
  let rec declarations = (env, ds, st) => {
    match(ds) {
      [] => { Unify.Ok((Env.empty, []), st) },
      [d, ..rest] => {
        Unify.bind(declaration(env, d, st))((d) => (st) => {
          Unify.bind(Elab.dec((env, (0: I32), []), d, st))((delta) => (st) => {
            Unify.bind(declarations(Env.plus(env, delta), rest, st))((more, rest) => (st) => { Unify.Ok((Env.plus(delta, more), [d, ..rest]), st) })
          })
        })
      }
    }
  };
  let structureDec = (env, sd, st) => {
    match(sd) {
      SDec(d) => {
        Unify.bind(declaration(env, d, st))((d) => (st) => {
          Unify.bind(Elab.dec((env, (0: I32), []), d, st))((delta) => (st) => { Unify.Ok((delta, SDec(d)), st) })
        })
      },
      SStructure(p, bs) => {
        Unify.bind(Elab.foldRes(
          ((delta, output), (n, ds), st) => {
            Unify.bind(declarations(env, ds, st))((body, ds) => (st) => {
              Unify.Ok(
                (
                  Env.plus(delta, Env.withStructure(n, body, false)),
                  SubsetList.append(output, [(n, ds)])
                ),
                st
              )
            })
          },
          (Env.empty, []),
          bs,
          st
        ))((delta, bs) => (st) => { Unify.Ok((delta, SStructure(p, bs)), st) })
      }
    }
  };
  let rec structures = (env, sds, st) => {
    match(sds) {
      [] => { Unify.Ok((Env.empty, []), st) },
      [sd, ..rest] => {
        Unify.bind(structureDec(env, sd, st))((delta, sd) => (st) => {
          Unify.bind(structures(Env.plus(env, delta), rest, st))((more, rest) => (st) => { Unify.Ok((Env.plus(delta, more), [sd, ..rest]), st) })
        })
      }
    }
  };
  let rec phrases = (env, prog, st) => {
    match(prog) {
      [] => { Unify.Ok((env, []), st) },
      [td, ..rest] => {
        Unify.bind(match(td) {
          TopDecs(sds) => {
            Unify.bind(structures(env, sds, st))((delta, sds) => (st) => { Unify.Ok((delta, TopDecs(sds)), st) })
          },
          _ => {
            Unify.bind(Elab.topdec(env, td, st))((delta) => (st) => { Unify.Ok((delta, td), st) })
          }
        })((delta, td) => (st) => {
          Unify.bind(phrases(Env.plus(env, delta), rest, st))((env, rest) => (st) => { Unify.Ok((env, [td, ..rest]), st) })
        })
      }
    }
  };
  phrases(env, prog, st)
};

/* Check dependencies before a module, regardless of the command-line order. Every
   recovery starts with its dependency closure, so unrelated input files remain independent. */
let recover = (modules, target) => {
  let nameOfModule = (_, _, prog, _) => {
    match(structureOf(prog)) {
      [n, .._] => { n },
      [] => { "" }
    }
  };
  let rec decDeps = (d) => {
    match(d) {
      DOpen(_, ids) => { concatMap(head, ids) },
      _ => { decQuals(d) }
    }
  };
  let deps = (_, _, prog, _) => {
    distinct(concatMap(
      match {
        TopDecs(sds) => {
          concatMap(
            match {
              SDec(d) => { decDeps(d) },
              SStructure(_, bs) => { concatMap((_, ds) => { concatMap(decDeps, ds) }, bs) }
            },
            sds
          )
        },
        TopExp(_, e) => { expQuals(e) }
      },
      prog
    ))
  };
  let rec order = (item, visiting, done, acc) => {
    let name = nameOfModule(item);
    if (SmlList.exists((n) => { n == name })(done)) { Unify.Ok((done, acc), Unify.initial) } else {
      if (SmlList.exists((n) => { n == name })(visiting)) {
        Unify.Err("cyclic module dependency involving " ++ name, (0: I32))
      } else {
        let needed = SmlList.filter((m) => {
          if (nameOfModule(m) != name) { SmlList.exists((n) => { n == nameOfModule(m) })(deps(item)) } else { false }
        })(modules);
        let rec walk = match {
          ([], Var(done), Var(acc)) => {
            Unify.Ok(([name, ..done], SubsetList.append(acc, [item])), Unify.initial)
          },
          ([m, ..rest], Var(done), Var(acc)) => {
            Unify.bind(order(m, [name, ..visiting], done, acc))((done, acc) => (_) => { walk(rest, done, acc) })
          }
        };
        walk(needed, done, acc)
      }
    }
  };
  let rec elaborate = match {
    (_, [], Var(st), Var(acc)) => { Unify.Ok(acc, st) },
    (
      Var(env),
      [(Var(path), Var(src), Var(prog), Var(comments)), ..rest],
      Var(st),
      Var(acc)
    ) => {
      let Unify.State(vars, next, sels, recs, _) = st;
      Unify.bind(portableValues(env, prog, Unify.State(vars, next, sels, recs, Some([]))))((env, prog) => (st) => {
        Unify.bind(wmNumbers(st))((_) => (st) => {
          elaborate(
            env,
            rest,
            st,
            SubsetList.append(acc, [(path, src, realEquality(st, prog), comments)])
          )
        })
      })
    }
  };
  let rec strict = match {
    (_, [], Var(st)) => { Unify.Ok(void, st) },
    (Var(env), [(_, _, Var(prog), _), ..rest], Var(st)) => {
      Unify.bind(Elab.program(env, prog, st))((env) => (st) => { strict(env, rest, st) })
    }
  };
  Unify.bind(order(target, [], [], []))((_, ordered) => (_) => {
    let prefix = BackendNames.prefix(SmlList.map((path, src, _, _) => { (path, src) })(ordered));
    let (planned, names) = BackendNames.project(prefix, SmlList.map((m) => { (nameOfModule(m), deps(m), m) })(ordered));
    let ordered = SmlList.map((_, _, m) => { m })(planned);
    match(BackendNames.failure(names)) {
      Some(_, p, message) => { Unify.Err(message, p) },
      None => {
        Unify.bind(Basis.initial)((basis) => (_) => {
          Unify.bind(elaborate(basis, ordered, Unify.lenient, []))((rewritten) => (_) => {
            Unify.bind(strict(basis, rewritten, Unify.initial))((_) => (st) => {
              match(SmlList.find((m) => { nameOfModule(m) == nameOfModule(target) })(rewritten)) {
                Some(m) => { Unify.Ok(m, st) },
                None => { Unify.Err("missing translated module", (0: I32)) }
              }
            })
          })
        })
      }
    }
  })
};

/* Modules arrive in resolved dependency order. Each checker sees only direct imports;
   cache owned structure environments, never an importer's ambient environment. */
let recoverProjectWithRuntime = (runtime, modules) => {
  let working = (basis, cache, dependencies) => {
    SmlList.foldl((name, result) => {
      Unify.bind(result)((env) => (st) => {
        match(SmlList.find((key, _) => { key == name })(cache)) {
          None => { Unify.Err("missing resolved dependency " ++ name, (0: I32)) },
          Some(_, body) => {
            Unify.Ok(Env.plus(env, Env.withStructure(name, body, false)), st)
          }
        }
      })
    })(Unify.Ok(basis, Unify.initial))(dependencies)
  };
  let own = (env, name) => {
    match(Env.structureAt(env, [name])) {
      None => { Unify.Err("missing translated structure " ++ name, (0: I32)) },
      Some(body, _) => {
        let selected = match(runtime) {
          Some(key) => { key == name },
          None => { false }
        };
        let valid = match(Env.value(body, ([], "panic"))) {
          Some(
            ([Types.KPlain], Types.TArrow(Types.TCon(tn, []), Types.TGen(index))),
            Env.SValue
          ) => {
            if (Types.stampOf(tn) == Types.stampOf(Types.stringName)) { index == (0: I32) } else { false }
          },
          _ => { false }
        };
        if (if (selected) { SubsetBool.not(valid) } else { false }) {
          Unify.Err("panic runtime must export panic : string -> 'a", (0: I32))
        } else { Unify.Ok(body, Unify.initial) }
      }
    }
  };
  let rec rewrite = (basis, remaining, cache, st, acc) => {
    match(remaining) {
      [] => { Unify.Ok(SmlList.rev(acc), st) },
      [
        (Var(name), Var(dependencies), (Var(path), Var(src), Var(prog), Var(cs))),
        ..rest
      ] => {
        Unify.bind(working(basis, cache, dependencies))((env) => (_) => {
          let Unify.State(vars, next, sels, recs, _) = st;
          Unify.bind(portableValues(env, prog, Unify.State(vars, next, sels, recs, Some([]))))((exports, rewritten) => (next) => {
            Unify.bind(wmNumbers(next))((_) => (next) => {
              Unify.bind(own(exports, name))((body) => (_) => {
                rewrite(
                  basis,
                  rest,
                  [(name, body), ..cache],
                  next,
                  [(name, dependencies, (path, src, realEquality(next, rewritten), cs)), ..acc]
                )
              })
            })
          })
        })
      }
    }
  };
  let rec strict = (basis, remaining, cache, st) => {
    match(remaining) {
      [] => { Unify.Ok(void, st) },
      [(Var(name), Var(dependencies), (_, _, Var(prog), _)), ..rest] => {
        Unify.bind(working(basis, cache, dependencies))((env) => (_) => {
          Unify.bind(Elab.programExports(env, prog, st))((exports) => (next) => {
            Unify.bind(own(exports, name))((body) => (_) => { strict(basis, rest, [(name, body), ..cache], next) })
          })
        })
      }
    }
  };
  Unify.bind(Basis.initial)((basis) => (_) => {
    Unify.bind(rewrite(basis, modules, [], Unify.lenient, []))((rewritten) => (_) => {
      Unify.bind(strict(basis, rewritten, [], Unify.initial))((_) => (st) => { Unify.Ok(SmlList.map((_, _, m) => { m })(rewritten), st) })
    })
  })
};

let recoverProject = (modules) => { recoverProjectWithRuntime(None, modules) };

// A Workman module as SubsetML: its declarations become the structure named by the file.
let fromWmNamed = (name, src, decs, exps, comments) => {
  /* Imports disappear from the AST. Anchor the structure before them, so comments
     between an import and the first declaration stay inside the structure. */
  let first = match(WmLexer.lex(src)) {
    WmLexer.Tokens([(WmLexer.WKey("from"), Var(p)), .._], _) => { Some(p) },
    _ => {
      match(decs) {
        [d, .._] => { Some(decPos(d)) },
        [] => { None }
      }
    }
  };
  let structureLine = match(first) {
    Some(p) => { Doc.atom(p, "structure " ++ name ++ " = struct") },
    None => { Doc.text("structure " ++ name ++ " = struct") }
  };
  let structureDoc = Doc.stack([
    structureLine,
    Doc.indent((2: I32), Doc.stack(SmlList.map(SmlPrint.dec)(decs))),
    Doc.text("end")
  ]);
  let expDocs = SmlList.map((e) => { Doc.cat(SmlPrint.exp(e), Doc.text(";")) })(exps);
  let doc = match(expDocs) {
    [] => { structureDoc },
    _ => { Doc.stack([Doc.cat(structureDoc, Doc.text(";")), ..expDocs]) }
  };
  Doc.render(src, comments, SmlPrint.commentStyle, doc)
};

let fromWm = (path, src, decs, exps, comments) => {
  fromWmNamed(WmParse.structureName(path), src, decs, exps, comments)
};

// Reprints a parsed file as SubsetML.
let toSml = (src, prog, comments) => {
  // A declaration phrase needs its `;` when an expression phrase follows (Definition §8).
  let rec phrases = match {
    [] => { [] },
    [TopDecs(sds), TopExp(pos, e), ..rest] => {
      [
        Doc.cat(SmlPrint.topdec(TopDecs(sds)), Doc.text(";")),
        ..phrases([TopExp(pos, e), ..rest])
      ]
    },
    [td, ..rest] => { [SmlPrint.topdec(td), ..phrases(rest)] }
  };
  Doc.render(src, comments, SmlPrint.commentStyle, Doc.stack(phrases(prog)))
};
