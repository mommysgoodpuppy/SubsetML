// Generated by SubsetML from wm_parse.sml. Do not edit: change the .sml source.
/* @subsetml
from "./subset_bool.sml" import * as SubsetBool;
from "./subset_option_value.sml" import * as SubsetOptionValue;
from "./syntax.sml" import * as Syntax;
from "./wm_lexer.sml" import * as WmLexer;
from "./subset_string.sml" import * as SubsetString;
from "./sml_list.sml" import * as SmlList;
from "./compiler_text.sml" import * as CompilerText;
from "./subset_char.sml" import * as SubsetChar;
from "./wm_print.sml" import * as WmPrint;
from "./backend_names.sml" import * as BackendNames;
from "./subset_list.sml" import * as SubsetList;
from "./sml_option.sml" import * as SmlOption;
*/

/* Parsing Workman source into SubsetML abstract syntax: the reverse of WmPrint.

   It accepts the Workman fragment that corresponds to SubsetML, plus the expression compatibility forms that
   WmPrint emits (`div`, `mod`, `@`, `o`, `before`, `#lab`, `~`). Workman features outside
   the reverse profile (`%`, receiver pipes, JSON, FFI imports, ...) are reported as errors.
   Numeric and pinned match patterns survive internally until binding resolution lowers them. */

from "./subset_option_value.wm" import * as SubsetOptionValue;
from "./syntax.wm" import * as Syntax;
from "./wm_lexer.wm" import * as WmLexer;
from "./subset_string.wm" import * as SubsetString;
from "./sml_list.wm" import * as SmlList;
from "./compiler_text.wm" import * as CompilerText;
from "./subset_char.wm" import * as SubsetChar;
from "./wm_print.wm" import * as WmPrint;
from "./backend_names.wm" import * as BackendNames;
from "./subset_bool.wm" import * as SubsetBool;
from "./subset_list.wm" import * as SubsetList;
from "./sml_option.wm" import * as SmlOption;

from "./subset_option_value.wm" import *;

from "./syntax.wm" import *;
from "./wm_lexer.wm" import *;

type Toks = List<(Token, Pos)>;

type Res<a> = Done<a, Toks> | Fail<String, Pos>;

let bind = (r) => (k) => {
  match(r) {
    Done(x, ts) => { k(x)(ts) },
    Fail(message, pos) => { Fail(message, pos) }
  }
};

let peek = match {
  [t, .._] => { t },
  [] => { (WEOF, (0: I32)) }
};

let advance = match {
  [_, ..rest] => { rest },
  [] => { [] }
};

let posOf = (ts) => {
  let (_, p) = peek(ts);
  p
};

let isKey = (k, ts) => {
  match(peek(ts)) {
    (WKey(k'), _) => { k == k' },
    _ => { false }
  }
};

let describe = match {
  WKey(k) => { "`" ++ k ++ "`" },
  WName(path) => { "`" ++ SubsetString.concatWith(path, ".") ++ "`" },
  WSelect(l) => { "`#" ++ l ++ "`" },
  WScon(_) => { "a literal" },
  WOpen(_) => { "a resolved header open" },
  WEOF => { "end of input" }
};

let expected = (what, ts) => {
  let (t, p) = peek(ts);
  Fail("expected " ++ what ++ ", found " ++ describe(t), p)
};

let expect = (k, ts) => {
  if (isKey(k, ts)) { Done(void, advance(ts)) } else { expected("`" ++ k ++ "`", ts) }
};

// `item (sep item)*`, allowing a trailing separator before `close`.
let separated = (item, sep, close, ts) => {
  let rec loop = (acc, ts) => {
    if (isKey(close, ts)) { Done(SmlList.rev(acc), ts) } else {
      match(item(ts)) {
        Done(x, rest) => {
          if (isKey(sep, rest)) { loop([x, ..acc], advance(rest)) } else { Done(SmlList.rev([x, ..acc]), rest) }
        },
        Fail(message, offset) => { Fail(message, offset) }
      }
    }
  };
  loop([], ts)
};

// `open items close`
let delimited = (openK, item, sep, close, ts) => {
  bind(expect(openK, ts))((_) => (ts) => {
    bind(separated(item, sep, close, ts))((xs) => (ts) => { bind(expect(close, ts))((_) => (ts) => { Done(xs, ts) }) })
  })
};

// ---------------------------------------------------------------------------------------
// Names (the inverse of WmPrint's)

let isUpperName = (s) => { CompilerText.firstIs(s, SubsetChar.isUpper) };

let decapitalize = (s) => {
  match(CompilerText.characters(s)) {
    [] => { "" },
    [c, ..rest] => { CompilerText.stringOf([SubsetChar.toLower(c), ..rest]) }
  }
};

let valueName = match {
  (Var(qs), "None") => { (qs, "NONE") },
  (Var(qs), "Some") => { (qs, "SOME") },
  Var(id) => {
    match(SmlList.find((_, wm) => { wm == id })(WmPrint.numNames)) {
      Some(entry) => {
        let (sml, _) = entry;
        sml
      },
      None => { id }
    }
  }
};

let constructorName = (name) => {
  let (_, target) = valueName([], name);
  target
};

let tyConName = match {
  ([], "Void") => { ([], "unit") },
  ([], "Number") => { ([], "real") },
  ([], "I32") => { ([], "int") },
  (Var(qs), Var(s)) => { (qs, decapitalize(s)) }
};

// Splits a path into structure qualifiers, the named value, and record field selections.
let splitPath = (path) => {
  let rec go = match {
    (Var(quals), [last]) => { (SmlList.rev(quals), last, []) },
    (Var(quals), [c, ..rest]) => {
      if (isUpperName(c)) { go([c, ..quals], rest) } else { (SmlList.rev(quals), c, rest) }
    },
    (Var(quals), []) => { (SmlList.rev(quals), "", []) }
  };
  go([], path)
};

let pathExp = (p, path) => {
  let (quals, base, fields) = splitPath(path);
  SmlList.foldl((l, e) => { EApp(ESelect(p, l), e) })(EId(p, valueName(quals, base)))(fields)
};

// "./sml_print.wm" names the structure SmlPrint.
let structureName = (file) => {
  let base = match(SmlList.rev(CompilerText.fields(file, (c) => { c == '/' }))) {
    [last, .._] => { last },
    [] => { file }
  };
  let stem = if (CompilerText.isSuffix(base, ".wm")) {
    CompilerText.slice(base, (0: I32), CompilerText.size(base) - (3: I32))
  } else { base };
  BackendNames.moduleHint(stem)
};

// ---------------------------------------------------------------------------------------
// Types

let rec parseType = (ts) => {
  bind(parseTypeAtom(ts))((t) => (ts) => {
    if (isKey("->", ts)) {
      bind(parseType(advance(ts)))((r) => (ts) => { Done(TyArrow(t, r), ts) })
    } else { Done(t, ts) }
  })
}

and parseTypeAtom = (ts) => {
  match(peek(ts)) {
    (WKey("("), _) => {
      bind(delimited("(", parseType, ",", ")", ts))((types) => (ts) => {
        match(types) {
          [single] => { Done(single, ts) },
          [] => { expected("a type", ts) },
          _ => { Done(TyTuple(types), ts) }
        }
      })
    },
    (WName([v]), _) => {
      if (isUpperName(v)) { typeName([], v, advance(ts)) } else { Done(TyVar("'" ++ v), advance(ts)) }
    },
    (WName(path), _) => {
      match(SmlList.rev(path)) {
        [last, ..rest] => { typeName(SmlList.rev(rest), last, advance(ts)) },
        [] => { expected("a type", ts) }
      }
    },
    _ => { expected("a type", ts) }
  }
}

and typeName = (quals, name, ts) => {
  if (isKey("<", ts)) {
    bind(delimited("<", parseType, ",", ">", ts))((args) => (ts) => { Done(TyCon(args, tyConName(quals, name)), ts) })
  } else { Done(TyCon([], tyConName(quals, name)), ts) }
};

// ---------------------------------------------------------------------------------------
/* Patterns. As in WmPrint, `inMatch` marks a match arm and `binds` whether a bare name binds
   at this position. */

/* A bare Workman integer literal is an SML int when it fits in I32 and real otherwise, so
   `1` is int and `1.0` is real. Workman itself types `1` from context and defaults it to
   Number, so Number code read here must spell its integral constants `1.0`. */
let number = (c) => {
  match(c) {
    SInt(s) => {
      if (CompilerText.int32Literal(s)) { c } else { SReal(s ++ ".0") }
    },
    _ => { c }
  }
};

let negativeLiteral = (minusPos, ts) => {
  match(peek(ts)) {
    (WScon(SInt(s)), Var(p)) => {
      if (p == minusPos + (1: I32)) { Some(number(SInt("~" ++ s))) } else { None }
    },
    (WScon(SReal(s)), Var(p)) => {
      if (p == minusPos + (1: I32)) { Some(SReal("~" ++ s)) } else { None }
    },
    _ => { None }
  }
};

/* The text of an integer literal at the start of `ts`, `-` included: `(n: I32)` is an SML int
   constant even outside the range a bare literal reads as int. */
let integerText = (ts) => {
  match(peek(ts)) {
    (WScon(SInt(s)), _) => { Some(s) },
    (WKey("-"), Var(p)) => {
      match(peek(advance(ts))) {
        (WScon(SInt(s)), Var(q)) => { if (q == p + (1: I32)) { Some("~" ++ s) } else { None } },
        _ => { None }
      }
    },
    _ => { None }
  }
};

let isIntType = (t) => {
  match(t) {
    TyCon([], ([], "int")) => { true },
    _ => { false }
  }
};

// Builds `h1 :: ... :: tail`.
let consPat = (p, items, tail) => {
  SmlList.foldr((h, t) => { PApp(p, ([], "::"), PTuple([h, t])) })(tail)(items)
};

// `[a, b, ..tail]` after the `[`: the items and the optional spread tail.
let listItems = (item, ts) => {
  let rec go = (acc, ts) => {
    match(peek(ts)) {
      (WKey("]"), _) => { Done((SmlList.rev(acc), None), advance(ts)) },
      (WKey(".."), _) => {
        bind(item(advance(ts)))((t) => (ts) => {
          bind(expect("]", if (isKey(",", ts)) { advance(ts) } else { ts }))((_) => (ts) => { Done((SmlList.rev(acc), Some(t)), ts) })
        })
      },
      _ => {
        match(item(ts)) {
          Done(x, rest) => {
            if (isKey(",", rest)) { go([x, ..acc], advance(rest)) } else {
              bind(expect("]", rest))((_) => (rest) => { Done((SmlList.rev([x, ..acc]), None), rest) })
            }
          },
          Fail(message, offset) => { Fail(message, offset) }
        }
      }
    }
  };
  go([], ts)
};

let rec parsePat = (inMatch, binds, ts) => {
  let child = (b) => (ts) => {
    parseAnnotated(inMatch, if (b) { true } else { SubsetBool.not(inMatch) }, ts)
  };
  match(peek(ts)) {
    (WKey("_"), _) => { Done(PWild, advance(ts)) },
    (WKey("void"), _) => { Done(PTuple([]), advance(ts)) },
    (WKey("true"), Var(p)) => { Done(PId(p, ([], "true")), advance(ts)) },
    (WKey("false"), Var(p)) => { Done(PId(p, ([], "false")), advance(ts)) },
    (WScon(SInt(s)), Var(p)) => { Done(PScon(p, number(SInt(s))), advance(ts)) },
    (WScon(SReal(s)), Var(p)) => { Done(PScon(p, SReal(s)), advance(ts)) },
    (WScon(c), Var(p)) => { Done(PScon(p, c), advance(ts)) },
    (WKey("-"), Var(p)) => {
      match(negativeLiteral(p, advance(ts))) {
        Some(c) => { Done(PScon(p, c), advance(advance(ts))) },
        _ => { expected("a pattern", ts) }
      }
    },
    (WKey(".{"), Var(p)) => {
      let field = (ts) => {
        match(peek(ts)) {
          (WName([l]), Var(lp)) => {
            if (isKey("=", advance(ts))) {
              bind(child(false)(advance(advance(ts))))((q) => (ts) => { Done((l, q), ts) })
            } else { Done((l, PId(lp, ([], l))), advance(ts)) }
          },
          _ => { expected("a record field", ts) }
        }
      };
      bind(separated(field, ",", "}", advance(ts)))((fields) => (ts) => {
        bind(expect("}", ts))((_) => (ts) => { Done(PRecord(p, fields), ts) })
      })
    },
    (WKey("["), Var(p)) => {
      bind(listItems(child(true), advance(ts)))((items, tail) => (ts) => {
        match(tail) {
          None => { Done(PList(items), ts) },
          Some(t) => { Done(consPat(p, items, t), ts) }
        }
      })
    },
    (WKey("("), _) => {
      bind(delimited("(", child(false), ",", ")", ts))((ps) => (ts) => {
        match(ps) {
          [single] => { Done(single, ts) },
          _ => { Done(PTuple(ps), ts) }
        }
      })
    },
    (WName(["Var"]), _) => {
      match(peek(advance(ts)), peek(advance(advance(ts))), peek(advance(advance(advance(ts))))) {
        ((WKey("("), _), (WName([x]), Var(p)), (WKey(")"), _)) => {
          Done(PId(p, ([], x)), advance(advance(advance(advance(ts)))))
        },
        _ => { expected("`Var(name)`", ts) }
      }
    },
    (WName(path), Var(p)) => {
      let [name, ..reversedQuals] = SubsetList.reverse(path);
      let quals = SubsetList.reverse(reversedQuals);
      match(isUpperName(name), binds, SmlList.null(quals)) {
        (true, _, _) => {
          if (isKey("(", advance(ts))) {
            bind(delimited("(", child(true), ",", ")", advance(ts)))((args) => (ts) => {
              match(args) {
                [single] => { Done(PApp(p, valueName(quals, name), single), ts) },
                _ => { Done(PApp(p, valueName(quals, name), PTuple(args)), ts) }
              }
            })
          } else {
            Done(
              if (inMatch) { PPinned(p, valueName(quals, name)) } else { PId(p, valueName(quals, name)) },
              advance(ts)
            )
          }
        },
        (false, true, true) => { Done(PId(p, ([], name)), advance(ts)) },
        (false, _, _) => { Done(PPinned(p, valueName(quals, name)), advance(ts)) }
      }
    },
    _ => { expected("a pattern", ts) }
  }
}

// A pattern that may carry a type annotation, as inside parentheses.
and parseAnnotated = (inMatch, binds, ts) => {
  bind(parsePat(inMatch, binds, ts))((p) => (rest) => {
    if (isKey(":", rest)) {
      bind(parseType(advance(rest)))((t) => (after) => {
        Done(
          match(p, isIntType(t), integerText(ts)) {
            (PScon(q, _), true, Some(s)) => { PScon(q, SInt(s)) },
            _ => { PTyped(p, t) }
          },
          after
        )
      })
    } else { Done(p, rest) }
  })
};

// ---------------------------------------------------------------------------------------
// Expressions

// Whether the `(` at the head of ts begins a lambda, i.e. its matching `)` is followed by `=>`.
let lambdaAhead = (ts) => {
  let rec scan = (depth, ts) => {
    match(peek(ts)) {
      (WEOF, _) => { false },
      (WKey(k), _) => {
        if (if (if (if (k == "(") { true } else { k == "[" }) { true } else { k == "{" }) { true } else { k == ".{" }) { scan(depth + (1: I32), advance(ts)) } else {
          if (if (if (k == ")") { true } else { k == "]" }) { true } else { k == "}" }) {
            if (depth == (1: I32)) { isKey("=>", advance(ts)) } else { scan(depth - (1: I32), advance(ts)) }
          } else { scan(depth, advance(ts)) }
        }
      },
      _ => { scan(depth, advance(ts)) }
    }
  };
  if (isKey("(", ts)) { scan((0: I32), ts) } else { false }
};

let binLevel = match {
  "||" => { Some((1: I32)) },
  "&&" => { Some((2: I32)) },
  "==" => { Some((3: I32)) },
  "!=" => { Some((3: I32)) },
  "<" => { Some((4: I32)) },
  ">" => { Some((4: I32)) },
  "<=" => { Some((4: I32)) },
  ">=" => { Some((4: I32)) },
  "++" => { Some((5: I32)) },
  "+" => { Some((5: I32)) },
  "-" => { Some((5: I32)) },
  "*" => { Some((6: I32)) },
  "/" => { Some((6: I32)) },
  "%" => { Some((6: I32)) },
  _ => { None }
};

let smlOperator = match {
  "==" => { "=" },
  "!=" => { "<>" },
  "++" => { "^" },
  Var(s) => { s }
};

// The SML operators WmPrint keeps where Workman has none.
let fallbackOperator = (ts) => {
  match(peek(ts)) {
    (WKey("@"), _) => { Some("@") },
    (WName([s]), _) => {
      if (if (if (if (s == "div") { true } else { s == "mod" }) { true } else { s == "o" }) { true } else { s == "before" }) { Some(s) } else { None }
    },
    _ => { None }
  }
};

let infixApp = (opr, p, l, r) => { EApp(EId(p, ([], opr)), ETuple([l, r])) };

// Calls and syntax-only pipe insertion share the same argument convention.
let apply = (callee, args) => {
  match(callee, args) {
    (EId(p, (["List"], "append")), [left, right]) => { infixApp("@", p, left, right) },
    (_, [single]) => { EApp(callee, single) },
    _ => { EApp(callee, ETuple(args)) }
  }
};

let consExp = (p, items, tail) => {
  SmlList.foldr((h, t) => { infixApp("::", p, h, t) })(tail)(items)
};

let startsDecl = (ts) => {
  if (if (if (isKey("let", ts)) { true } else { isKey("type", ts) }) { true } else { isKey("record", ts) }) { true } else {
    match(peek(ts)) {
      (WOpen(_), _) => { true },
      _ => { false }
    }
  }
};

type Item = IDec<Dec> | IExp<Exp>;

// A block's items as an expression: declarations become `let`, a trailing `;` gives ().
let rec blockExp = (items, terminated) => {
  let rec decs = match {
    ([IDec(d), ..rest], Var(acc)) => { decs(rest, [d, ..acc]) },
    (Var(rest), Var(acc)) => { (SmlList.rev(acc), rest) }
  };
  let rec exps = match {
    ([IExp(e), ..rest], Var(acc)) => { exps(rest, [e, ..acc]) },
    (Var(rest), Var(acc)) => { (SmlList.rev(acc), rest) }
  };
  let (ds, rest) = decs(items, []);
  let (es, after) = exps(rest, []);
  let body = match(after, terminated) {
    ([], true) => { SubsetList.append(es, [ETuple([])]) },
    ([], false) => { es },
    (_, _) => { SubsetList.append(es, [blockExp(after, terminated)]) }
  };
  match(ds, body) {
    ([], [single]) => { single },
    _ => { ELet(ds, body) }
  }
};

type Result = Module<List<Dec>, List<Exp>, List<Comment>> | ParseError<String, Pos>;

type RecordLayout = | Layout<String, String, List<String>, List<(String, Ty)>>;
type RecordPart = Spread<Exp> | Field<String, Exp>;

// Resolve uppercase generic parameter references before producing SML types.
let rec parameterType = (variables, t) => {
  match(t) {
    TyCon([], ([], Var(name))) => {
      match(SmlList.find((v) => { decapitalize(CompilerText.drop(v, (1: I32))) == name })(variables)) {
        Some(v) => { TyVar(v) },
        None => { t }
      }
    },
    TyCon(args, name) => {
      TyCon(SmlList.map((a) => { parameterType(variables, a) })(args), name)
    },
    TyTuple(types) => {
      TyTuple(SmlList.map((a) => { parameterType(variables, a) })(types))
    },
    TyArrow(a, b) => {
      TyArrow(parameterType(variables, a), parameterType(variables, b))
    },
    TyRecord(fields) => {
      TyRecord(SmlList.map((l, a) => { (l, parameterType(variables, a)) })(fields))
    },
    TyVar(_) => { t }
  }
};

let parseModuleLowering = (layouts, owner, src, lexed, fieldPrefix) => {
  /* Export field-type witnesses through their owning record module. Consumers need
     not import private dependencies merely to type-check generated reconstruction. */
  let fieldAlias = (recordName, label) => {
    match(fieldPrefix) {
      None => { "" },
      Some(prefix) => {
        prefix ++ "Field" ++ CompilerText.natural(CompilerText.size(recordName)) ++ "_" ++ recordName ++ "_" ++ label
      }
    }
  };
  // Names absent from the authored source cannot capture its bindings.
  let names = match(lexed) {
    Tokens(tokens, _) => {
      SmlList.concat(SmlList.map(match {
        (WName(path), _) => { path },
        _ => { [] }
      })(tokens))
    },
    LexError(_, _) => { [] }
  };
  let fresh = (name) => { BackendNames.avoid(names, name) };
  let source = CompilerText.source(src);
  let spaceBefore = (ts) => {
    let p = posOf(ts);
    if (p > (0: I32)) {
      if (WmLexer.isSpace(CompilerText.sub(source, p - (1: I32)))) { true } else { CompilerText.sub(source, p - (1: I32)) == '/' }
    } else { false }
  };
  let startsSpaceArgument = (ts) => {
    if (spaceBefore(ts)) {
      match(peek(ts)) {
        (WName(_), _) => {
          match(fallbackOperator(ts)) {
            None => { true },
            Some(_) => { false }
          }
        },
        (WScon(_), _) => { true },
        (WKey(k), _) => {
          member(k, ["(", "[", "{", ".{", "true", "false", "void", "match"])
        },
        _ => { false }
      }
    } else { false }
  };

  /* Conservative source purity: constructor applications and other computed forms use
     ordered lowering until their value status can be resolved by the checker. */
  let rec pure = (e) => {
    match(e) {
      EScon(_, _) => { true },
      EId(_, _) => { true },
      EFn(_) => { true },
      ERecord(_, fields) => { SmlList.all((_, value) => { pure(value) })(fields) },
      EList(values) => { SmlList.all(pure)(values) },
      ETuple(values) => { SmlList.all(pure)(values) },
      ETyped(value, _) => { pure(value) },
      _ => { false }
    }
  };
  let rec variablesIn = (t) => {
    match(t) {
      TyVar(name) => { [name] },
      TyCon(args, _) => { SmlList.concat(SmlList.map(variablesIn)(args)) },
      TyTuple(args) => { SmlList.concat(SmlList.map(variablesIn)(args)) },
      TyArrow(a, b) => { SubsetList.append(variablesIn(a), variablesIn(b)) },
      TyRecord(fields) => {
        SmlList.concat(SmlList.map((_, t) => { variablesIn(t) })(fields))
      }
    }
  };
  let argumentShape = (t) => {
    match(t) {
      TyVar(_) => { true },
      TyTuple(args) => {
        SmlList.all(match {
          TyVar(_) => { true },
          _ => { false }
        })(args)
      },
      _ => { false }
    }
  };
  let literalLayout = (variables, fields) => {
    let occurrences = SmlList.concat(SmlList.map((_, t) => { variablesIn(t) })(fields));
    if (SmlList.all((v) => {
      SubsetList.length(SmlList.filter((n) => { n == v })(occurrences)) == (1: I32)
    })(variables)) {
      SmlList.all((_, t) => {
        if (SubsetList.isEmpty(variablesIn(t))) { true } else {
          match(t) {
            TyVar(_) => { true },
            TyArrow(a, TyVar(_)) => { argumentShape(a) },
            _ => { false }
          }
        }
      })(fields)
    } else { false }
  };
  /* Imported layouts must be visible outside a literal's lowering helper too.
     Type aliases have no runtime effect and do not create record identities. */
  let referenced = {
    let rec scan = (tokens) => {
      match(tokens) {
        [(WName(path), _), (WKey("{"), _), ..rest] => { [path, ..scan(rest)] },
        [_, ..rest] => { scan(rest) },
        [] => { [] }
      }
    };
    match(lexed) {
      Tokens(tokens, _) => { scan(tokens) },
      LexError(_, _) => { [] }
    }
  };
  let aliases = SmlList.map(match {
    Layout(moduleName, name, parameters, _) => {
      DType(
        (0: I32),
        [
          (
            parameters,
            fresh("subsetmlLayout_" ++ moduleName ++ "_" ++ name),
            TyCon(
              SmlList.map(TyVar)(parameters),
              (CompilerText.fields(moduleName, (c) => { c == '.' }), name)
            )
          )
        ]
      )
    }
  })(SmlList.filter(match {
    Layout(moduleName, name, _, _) => {
      if (moduleName != owner) {
        SmlList.exists((path) => {
          let (qs, n, _) = splitPath(path);
          if (SubsetString.concatWith(qs, ".") == moduleName) { decapitalize(n) == name } else { false }
        })(referenced)
      } else { false }
    }
  })(layouts));

  let rec parseExp = (ts) => {
    match(peek(ts)) {
      (WKey("if"), _) => {
        bind(expect("(", advance(ts)))((_) => (ts) => {
          bind(parseExp(ts))((c) => (ts) => {
            bind(expect(")", ts))((_) => (ts) => {
              bind(parseBlock(ts))((a) => (ts) => {
                bind(expect("else", ts))((_) => (ts) => {
                  bind(parseBlock(ts))((b) => (ts) => { Done(EIf(c, a, b), ts) })
                })
              })
            })
          })
        })
      },
      (WKey("match"), _) => {
        if (isKey("{", advance(ts))) {
          bind(parseArms(advance(ts)))((rules) => (ts) => { Done(EFn(rules), ts) })
        } else {
          if (lambdaAhead(advance(ts))) { parseMatchFunction(advance(ts)) } else {
            bind(delimited("(", parseExp, ",", ")", advance(ts)))((values) => (ts) => {
              bind(parseArms(ts))((rules) => (ts) => {
                match(values) {
                  [single] => { Done(ECase(single, rules), ts) },
                  _ => { Done(ECase(ETuple(values), rules), ts) }
                }
              })
            })
          }
        }
      },
      (WKey("("), _) => {
        if (lambdaAhead(ts)) { parseLambda(ts) } else { parseFallback(ts) }
      },
      _ => { parseFallback(ts) }
    }
  }

  // `match(x, y) => { arms }`: a function of its named parameters.
  and parseMatchFunction = (ts) => {
    let name = (ts) => {
      match(peek(ts)) {
        (WName([x]), Var(p)) => { Done((p, x), advance(ts)) },
        _ => { expected("a parameter name", ts) }
      }
    };
    bind(delimited("(", name, ",", ")", ts))((names) => (ts) => {
      bind(expect("=>", ts))((_) => (ts) => {
        bind(parseArms(ts))((rules) => (ts) => {
          let param = match(names) {
            [(Var(p), Var(x))] => { PId(p, ([], x)) },
            _ => { PTuple(SmlList.map((p, x) => { PId(p, ([], x)) })(names)) }
          };
          let value = match(names) {
            [(Var(p), Var(x))] => { EId(p, ([], x)) },
            _ => { ETuple(SmlList.map((p, x) => { EId(p, ([], x)) })(names)) }
          };
          Done(EFn([(param, ECase(value, rules))]), ts)
        })
      })
    })
  }

  // `(params) => body`, where the body is a block or another lambda.
  and parseLambda = (ts) => {
    let param = (ts) => {
      bind(parsePat(false, true, ts))((p) => (ts) => {
        if (isKey(":", ts)) {
          bind(parseType(advance(ts)))((t) => (ts) => { Done(PTyped(p, t), ts) })
        } else { Done(p, ts) }
      })
    };
    bind(delimited("(", param, ",", ")", ts))((ps) => (ts) => {
      bind(expect("=>", ts))((_) => (ts) => {
        bind(if (lambdaAhead(ts)) { parseLambda(ts) } else { parseBlock(ts) })((body) => (ts) => {
          let p = match(ps) {
            [single] => { single },
            _ => { PTuple(ps) }
          };
          Done(EFn([(p, body)]), ts)
        })
      })
    })
  }

  and parseArms = (ts) => {
    let arm = (ts) => {
      bind(parseAnnotated(true, false, ts))((p) => (ts) => {
        bind(expect("=>", ts))((_) => (ts) => { bind(parseBlock(ts))((e) => (ts) => { Done((p, e), ts) }) })
      })
    };
    delimited("{", arm, ",", "}", ts)
  }

  and parseBlock = (ts) => {
    let rec items = (acc, ts) => {
      match(peek(ts)) {
        (WKey("}"), _) => { Done((SmlList.rev(acc), true), advance(ts)) },
        _ => {
          if (startsDecl(ts)) {
            bind(parseDecl(ts))((ds) => (ts) => { items(SubsetList.append(SmlList.map(IDec)(ds), acc), ts) })
          } else {
            bind(parseExp(ts))((e) => (ts) => {
              if (isKey(";", ts)) { items([IExp(e), ..acc], advance(ts)) } else {
                bind(expect("}", ts))((_) => (ts) => { Done((SmlList.rev([IExp(e), ..acc]), false), ts) })
              }
            })
          }
        }
      }
    };
    bind(expect("{", ts))((_) => (ts) => {
      bind(items([], ts))((parts, terminated) => (ts) => {
        Done(blockExp(parts, if (terminated) { true } else { SmlList.null(parts) }), ts)
      })
    })
  }
  // An empty block or one ending in `;` yields void.

  // The SML operators kept by WmPrint bind loosest.
  and parseFallback = (ts) => {
    let rec more = (l, ts) => {
      match(fallbackOperator(ts)) {
        Some(opr) => {
          bind(parseBinary((1: I32), advance(ts)))((r) => (ts') => { more(infixApp(opr, posOf(ts), l, r), ts') })
        },
        None => { Done(l, ts) }
      }
    };
    bind(parseBinary((1: I32), ts))((l) => (ts) => { more(l, ts) })
  }

  and parseBinary = (minLevel, ts) => {
    let rec more = (l, ts) => {
      match(peek(ts)) {
        (WKey(opr), Var(p)) => {
          match(binLevel(opr)) {
            Some(level) => {
              if (level < minLevel) { Done(l, ts) } else {
                if (opr == "%") {
                  Fail("`%` has no SubsetML counterpart (SML `mod` differs)", p)
                } else {
                  bind(parseBinary(level + (1: I32), advance(ts)))((r) => (ts) => {
                    more(
                      match(opr) {
                        "&&" => { EAndalso(l, r) },
                        "||" => { EOrelse(l, r) },
                        _ => {
                          match(opr, l) {
                            ("==", ETyped(x, TyCon([], ([], "real")))) => { EApp(EId(p, (["Real"], "==")), ETuple([x, r])) },
                            ("!=", ETyped(x, TyCon([], ([], "real")))) => { EApp(EId(p, (["Real"], "!=")), ETuple([x, r])) },
                            _ => { infixApp(smlOperator(opr), p, l, r) }
                          }
                        }
                      },
                      ts
                    )
                  })
                }
              }
            },
            None => { Done(l, ts) }
          }
        },
        _ => { Done(l, ts) }
      }
    };
    bind(parseUnary(ts))((l) => (ts) => { more(l, ts) })
  }

  and parseUnary = (ts) => {
    match(peek(ts)) {
      (WKey("!"), Var(p)) => {
        bind(parseUnary(advance(ts)))((e) => (ts) => { Done(EApp(EId(p, ([], "not")), e), ts) })
      },
      (WKey("-"), Var(p)) => {
        match(negativeLiteral(p, advance(ts))) {
          Some(c) => {
            if (isKey(":>", advance(advance(ts)))) {
              bind(parseUnary(advance(ts)))((e) => (ts) => { Done(EApp(EId(p, ([], "~")), e), ts) })
            } else { Done(EScon(p, c), advance(advance(ts))) }
          },
          None => {
            bind(parseUnary(advance(ts)))((e) => (ts) => { Done(EApp(EId(p, ([], "~")), e), ts) })
          }
        }
      },
      _ => { parsePipe(ts) }
    }
  }

  /* Pipes bind above unary/binary operators, chain left-to-right, and lower
     only to ordinary applications. No type-directed receiver/carrier lookup. */
  and parsePipe = (ts) => {
    let rec more = (left, ts) => {
      if (isKey(":>", ts)) {
        let stage = advance(ts);
        if (isKey(".", stage)) {
          Fail(
            "receiver pipes are outside the SubsetML translation profile; use a named function",
            posOf(stage)
          )
        } else {
          bind(parsePostfixForm(stage))((right, insertion) => (rest) => {
            more(
              match(insertion) {
                Some(callee, args) => { apply(callee, [left, ..args]) },
                None => { EApp(right, left) }
              },
              rest
            )
          })
        }
      } else { Done(left, ts) }
    };
    bind(parsePostfix(ts))((left) => (ts) => { more(left, ts) })
  }

  and parsePostfix = (ts) => {
    bind(parsePostfixForm(ts))((value, _) => (rest) => { Done(value, rest) })
  }

  /* Retain just the outer call's source form until pipe insertion is decided.
     Grouping returns a primary with no insertion slot. A space application is
     a fully constructed stage; a final explicit call supplies an insertion slot. */
  and parsePostfixForm = (ts) => {
    /* Direct self tail calls, not `bind` continuations, so a long application chain
       runs in constant stack on the Workman backend too. */
    let rec calls = (callee, insertion, ts) => {
      if (if (isKey("(", ts)) { SubsetBool.not(lambdaAhead(ts)) } else { false }) {
        match(delimited("(", parseExp, ",", ")", ts)) {
          Done(args, rest) => { calls(apply(callee, args), Some(callee, args), rest) },
          Fail(message, offset) => { Fail(message, offset) }
        }
      } else {
        if (startsSpaceArgument(ts)) {
          match(if (lambdaAhead(ts)) { parseLambda(ts) } else { parsePrimary(ts) }) {
            Done(arg, rest) => { calls(EApp(callee, arg), None, rest) },
            Fail(message, offset) => { Fail(message, offset) }
          }
        } else { Done((callee, insertion), ts) }
      }
    };
    bind(parsePrimary(ts))((value) => (rest) => { calls(value, None, rest) })
  }

  and parsePrimary = (ts) => {
    match(peek(ts)) {
      (WScon(c), Var(p)) => { Done(EScon(p, number(c)), advance(ts)) },
      (WKey("true"), Var(p)) => { Done(EId(p, ([], "true")), advance(ts)) },
      (WKey("false"), Var(p)) => { Done(EId(p, ([], "false")), advance(ts)) },
      (WKey("void"), _) => { Done(ETuple([]), advance(ts)) },
      (WKey("~"), Var(p)) => { Done(EId(p, ([], "~")), advance(ts)) },
      (WName(path), Var(p)) => {
        if (isKey("{", advance(ts))) { parseNamedRecord(p, path, advance(advance(ts))) } else { Done(pathExp(p, path), advance(ts)) }
      },
      (WSelect(l), Var(p)) => {
        if (CompilerText.firstIs(l, SubsetChar.isDigit)) {
          Fail("tuple selectors are not part of SubsetML; use a pattern such as (_, x)", p)
        } else { Done(ESelect(p, l), advance(ts)) }
      },
      (WKey("["), Var(p)) => {
        bind(listItems(parseExp, advance(ts)))((items, tail) => (ts) => {
          match(tail) {
            None => { Done(EList(items), ts) },
            Some(t) => { Done(consExp(p, items, t), ts) }
          }
        })
      },
      (WKey(".{"), Var(p)) => {
        let field = (ts) => {
          match(peek(ts)) {
            (WName([l]), Var(lp)) => {
              if (isKey("=", advance(ts))) {
                bind(parseExp(advance(advance(ts))))((e) => (ts) => { Done((l, e), ts) })
              } else { Done((l, EId(lp, ([], l))), advance(ts)) }
            },
            (WKey(".."), Var(offset)) => {
              Fail(
                "record updates must name their record type: use Point { ..value, field = replacement }",
                offset
              )
            },
            _ => { expected("a record field", ts) }
          }
        };
        bind(separated(field, ",", "}", advance(ts)))((fields) => (ts) => {
          bind(expect("}", ts))((_) => (ts) => { Done(ERecord(p, fields), ts) })
        })
      },
      (WKey("{"), _) => { parseBlock(ts) },
      (WKey("("), _) => {
        bind(parseExp(advance(ts)))((first) => (rest) => {
          match(peek(rest)) {
            (WKey(":"), _) => {
              bind(parseType(advance(rest)))((t) => (after) => {
                bind(expect(")", after))((_) => (after) => {
                  Done(
                    match(first, isIntType(t), integerText(advance(ts))) {
                      (EScon(q, _), true, Some(s)) => { EScon(q, SInt(s)) },
                      _ => { ETyped(first, t) }
                    },
                    after
                  )
                })
              })
            },
            (WKey(","), _) => {
              bind(separated(parseExp, ",", ")", advance(rest)))((more) => (ts) => {
                bind(expect(")", ts))((_) => (ts) => { Done(ETuple([first, ..more]), ts) })
              })
            },
            (WKey(";"), _) => {
              bind(separated(parseExp, ";", ")", advance(rest)))((more) => (ts) => {
                bind(expect(")", ts))((_) => (ts) => { Done(ESeq([first, ..more]), ts) })
              })
            },
            _ => { bind(expect(")", rest))((_) => (ts) => { Done(first, ts) }) }
          }
        })
      },
      (WKey("if"), _) => { parseExp(ts) },
      (WKey("match"), _) => { parseExp(ts) },
      _ => { expected("an expression", ts) }
    }
  }

  // Named record layout is explicit; no inference is needed to enumerate copied fields.
  and parseNamedRecord = (p, path, ts) => {
    let (qualifiers, name, selections) = splitPath(path);
    let sourceOwner = if (SubsetList.isEmpty(qualifiers)) { owner } else { SubsetString.concatWith(qualifiers, ".") };
    let candidate = SmlList.find(match {
      Layout(moduleName, recordName, _, _) => {
        if (moduleName == sourceOwner) { recordName == decapitalize(name) } else { false }
      }
    })(layouts);
    let part = (ts) => {
      match(peek(ts)) {
        (WKey(".."), _) => {
          bind(parseExp(advance(ts)))((e) => (ts) => { Done(Spread(e), ts) })
        },
        (WName([label]), Var(offset)) => {
          if (isKey("=", advance(ts))) {
            bind(parseExp(advance(advance(ts))))((e) => (ts) => { Done(Field(label, e), ts) })
          } else { Done(Field(label, EId(offset, ([], label))), advance(ts)) }
        },
        _ => { expected("a record field or spread", ts) }
      }
    };
    if (SubsetBool.not(SubsetList.isEmpty(selections))) { Fail("expected a nominal record type name", p) } else {
      match(candidate) {
        None => {
          Fail(
            "unknown record layout " ++ SubsetString.concatWith(path, ".") ++ "; supply its declaration when translating",
            p
          )
        },
        Some(Layout(_, recordName, variables, fields)) => {
          bind(separated(part, ",", "}", ts))((parts) => (ts) => {
            bind(expect("}", ts))((_) => (ts) => {
              let prefix = "subsetmlRecord" ++ CompilerText.natural(p) ++ "_";
              let parameters = SmlList.map((v) => { (v, "'" ++ fresh(prefix ++ CompilerText.drop(v, (1: I32)))) })(variables);
              let rec fieldType = (t) => {
                match(t) {
                  TyVar(v) => {
                    match(SmlList.find((old, _) => { old == v })(parameters)) {
                      Some(pair) => {
                        let (_, name) = pair;
                        TyVar(name)
                      },
                      None => { t }
                    }
                  },
                  TyCon(args, (Var(qs), Var(n))) => {
                    let builtin = SmlList.exists((b) => { b == n })(["real", "string", "char", "bool", "unit", "list", "option"]);
                    let qs = if (if (if (SubsetList.isEmpty(qs)) { SubsetBool.not(builtin) } else { false }) { sourceOwner != owner } else { false }) { [sourceOwner] } else { qs };
                    TyCon(SmlList.map(fieldType)(args), (qs, n))
                  },
                  TyTuple(types) => { TyTuple(SmlList.map(fieldType)(types)) },
                  TyArrow(a, b) => { TyArrow(fieldType(a), fieldType(b)) },
                  TyRecord(fs) => { TyRecord(SmlList.map((l, t) => { (l, fieldType(t)) })(fs)) }
                }
              };
              let fieldFor = (label, t) => {
                match(fieldPrefix) {
                  Some(_) => {
                    if (sourceOwner != owner) {
                      TyCon(
                        SmlList.map((_, v) => { TyVar(v) })(parameters),
                        ([sourceOwner], fieldAlias(recordName, label))
                      )
                    } else { fieldType(t) }
                  },
                  None => { fieldType(t) }
                }
              };
              let targetType = TyCon(SmlList.map((_, v) => { TyVar(v) })(parameters), (qualifiers, recordName));
              let literal = if (literalLayout(variables, fields)) {
                let rec direct = (remaining) => {
                  match(remaining) {
                    [] => { Some([]) },
                    [Spread(_), .._] => { None },
                    [Field(label, value), ..rest] => {
                      if (SubsetBool.not(pure(value))) { None } else {
                        match(SmlList.find((l, _) => { l == label })(fields), direct(rest)) {
                          (Some(entry), Some(tail)) => {
                            let (_, t) = entry;
                            let value = if (SubsetList.isEmpty(variablesIn(t))) { ETyped(value, fieldFor(label, t)) } else {
                              match(t) {
                                TyArrow(domain, TyVar(_)) => {
                                  let arguments = match(domain) {
                                    TyTuple(args) => { args },
                                    _ => { [domain] }
                                  };
                                  let rec argumentNames = (index, remaining) => {
                                    match(remaining) {
                                      [] => { [] },
                                      [_, ..rest] => {
                                        [
                                          fresh(prefix ++ label ++ "Argument" ++ CompilerText.natural(index)),
                                          ..argumentNames(index + (1: I32), rest)
                                        ]
                                      }
                                    }
                                  };
                                  let bound = argumentNames((0: I32), arguments);
                                  let patterns = SmlList.map((name) => { PId(p, ([], name)) })(bound);
                                  let values = SmlList.map((name) => { EId(p, ([], name)) })(bound);
                                  let pattern = match(domain) {
                                    TyTuple(_) => { PTuple(patterns) },
                                    _ => {
                                      let [single] = patterns;
                                      single
                                    }
                                  };
                                  let argument = match(domain) {
                                    TyTuple(_) => { ETuple(values) },
                                    _ => {
                                      let [single] = values;
                                      single
                                    }
                                  };
                                  EFn([(pattern, EApp(value, argument))])
                                },
                                _ => { value }
                              }
                            };
                            Some([(label, value), ..tail])
                          },
                          _ => { None }
                        }
                      }
                    }
                  }
                };
                direct(parts)
              } else { None };
              let rec finish = (remaining, index, bindings, values, explicit) => {
                match(remaining) {
                  [] => {
                    match(SmlList.find((label, _) => {
                      SubsetBool.not(SmlList.exists((l, _) => { l == label })(values))
                    })(fields)) {
                      Some(pair) => {
                        let (label, _) = pair;
                        Fail("missing record field " ++ label, p)
                      },
                      None => {
                        let ordered = SmlList.rev(bindings);
                        let patterns = SmlList.map((pattern, _) => { pattern })(ordered);
                        let arguments = SmlList.map((_, argument) => { argument })(ordered);
                        let pattern = match(patterns) {
                          [single] => { single },
                          _ => { PTuple(patterns) }
                        };
                        let argument = match(arguments) {
                          [single] => { single },
                          _ => { ETuple(arguments) }
                        };
                        let helper = fresh(prefix ++ "build");
                        let result = ETyped(
                          ERecord(
                            p,
                            SmlList.map((label, _) => {
                              let Some(pair) = SmlList.find((l, _) => { l == label })(values);
                              let (_, value) = pair;
                              (label, value)
                            })(fields)
                          ),
                          targetType
                        );
                        let layoutAlias = DType(
                          p,
                          [
                            (
                              SmlList.map((_, v) => { v })(parameters),
                              fresh(prefix ++ "layout"),
                              targetType
                            )
                          ]
                        );
                        /* Generalize the layout parameters on the helper, not on its caller.
                           Arguments retain source order and are evaluated once, including
                           entries overwritten by a later spread. */
                        let declaration = DVal(
                          p,
                          [],
                          [(PId(p, ([], helper)), EFn([(pattern, ELet([layoutAlias], [result]))]))],
                          []
                        );
                        let ordered = ELet([declaration], [EApp(EId(p, ([], helper)), argument)]);
                        /* Replaced or discarded entries can constrain outer weak variables.
                           A plain copy retains every entry in its emitted field wrappers. */
                        let copy = if (if (match(parts) {
                          [Spread(EId(_, _))] => { true },
                          _ => { false }
                        }) {
                          SmlList.all(match {
                            (_, TyArrow(_, _)) => { true },
                            _ => { false }
                          })(fields)
                        } else { false }) {
                          SmlList.all(match {
                            Spread(EId(_, _)) => { true },
                            Field(_, value) => { pure(value) },
                            _ => { false }
                          })(parts)
                        } else { false };
                        let final = SmlList.foldl((part, values) => {
                          match(part) {
                            Spread(e) => {
                              SmlList.map((label, _) => { (label, EApp(ESelect(p, label), e)) })(fields)
                            },
                            Field(label, e) => {
                              [(label, e), ..SmlList.filter((l, _) => { l != label })(values)]
                            }
                          }
                        })([])(parts);
                        Done(
                          match(literal) {
                            Some(fields) => { ERecord(p, fields) },
                            None => {
                              if (copy) { ECopy(p, ordered, ERecord(p, final), targetType) } else { ordered }
                            }
                          },
                          ts
                        )
                      }
                    }
                  },
                  [part, ..rest] => {
                    let temporary = fresh(prefix ++ CompilerText.natural(index));
                    let value = EId(p, ([], temporary));
                    match(part) {
                      Spread(e) => {
                        finish(
                          rest,
                          index + (1: I32),
                          [(PTyped(PId(p, ([], temporary)), targetType), e), ..bindings],
                          SmlList.map((label, _) => { (label, EApp(ESelect(p, label), value)) })(fields),
                          explicit
                        )
                      },
                      Field(label, e) => {
                        if (SmlList.exists((l) => { l == label })(explicit)) { Fail("duplicate record field " ++ label, p) } else {
                          match(SmlList.find((l, _) => { l == label })(fields)) {
                            None => { Fail(name ++ " has no field " ++ label, p) },
                            Some(pair) => {
                              let (_, t) = pair;
                              finish(
                                rest,
                                index + (1: I32),
                                [(PTyped(PId(p, ([], temporary)), fieldFor(label, t)), e), ..bindings],
                                [(label, value), ..SmlList.filter((l, _) => { l != label })(values)],
                                [label, ..explicit]
                              )
                            }
                          }
                        }
                      }
                    }
                  }
                }
              };
              finish(parts, (0: I32), [], [], [])
            })
          })
        }
      }
    }
  }

  // ---------------------------------------------------------------------------------------
  /* Declarations. A namespace import (`import * as X`) yields no declaration: SML refers to
     structures by name without importing them. */

  and parseDecl = (ts) => {
    let p = posOf(ts);
    match(peek(ts)) {
      (WOpen(ids), _) => { Done([DOpen(p, ids)], advance(ts)) },
      (WKey("let"), _) => {
        let isRec = isKey("rec", advance(ts));
        let binding = (ts) => {
          bind(parsePat(false, true, ts))((pat) => (ts) => {
            let rhs = (pat, ts) => {
              bind(expect("=", ts))((_) => (ts) => { bind(parseExp(ts))((e) => (ts) => { Done((pat, e), ts) }) })
            };
            if (isKey(":", ts)) {
              bind(parseType(advance(ts)))((t) => (ts) => { rhs(PTyped(pat, t), ts) })
            } else { rhs(pat, ts) }
          })
        };
        let rec bindings = (ts) => {
          bind(binding(ts))((b) => (ts) => {
            if (isKey("and", ts)) {
              bind(bindings(advance(ts)))((bs) => (ts) => { Done([b, ..bs], ts) })
            } else { Done([b], ts) }
          })
        };
        bind(bindings(if (isRec) { advance(advance(ts)) } else { advance(ts) }))((bs) => (ts) => {
          bind(expect(";", ts))((_) => (ts) => {
            if (isRec) {
              if (SmlList.all((_, e) => {
                match(e) {
                  EFn(_) => { true },
                  _ => { false }
                }
              })(bs)) { Done([DVal(p, [], [], bs)], ts) } else {
                Fail("the right side of a `let rec` binding must be a function", p)
              }
            } else { Done([DVal(p, [], bs, [])], ts) }
          })
        })
      },
      (WKey("type"), _) => { parseTypeDecl(p, advance(ts)) },
      (WKey("record"), _) => {
        match(peek(advance(ts))) {
          (WName([name]), _) => {
            bind(typeParams(advance(advance(ts))))((vs) => (ts) => {
              bind(expect("=", ts))((_) => (ts) => {
                let field = (ts) => {
                  match(peek(ts)) {
                    (WName([l]), _) => {
                      bind(expect(":", advance(ts)))((_) => (ts) => { bind(parseType(ts))((t) => (ts) => { Done((l, t), ts) }) })
                    },
                    _ => { expected("a record field", ts) }
                  }
                };
                bind(delimited("{", field, ",", "}", ts))((fields) => (ts) => {
                  bind(expect(";", ts))((_) => (ts) => {
                    Done(
                      [
                        DType(
                          p,
                          [
                            (
                              vs,
                              decapitalize(name),
                              TyRecord(SmlList.map((l, t) => { (l, parameterType(vs, t)) })(fields))
                            )
                          ]
                        ),
                        ..SubsetList.append(
                          match(fieldPrefix) {
                            None => { [] },
                            Some(prefix) => {
                              let arguments = SmlList.map((label, _) => {
                                (label, fresh(prefix ++ "Constructor_" ++ name ++ "_" ++ label))
                              })(fields);
                              let patterns = SmlList.map((_, argument) => { PId(p, ([], argument)) })(arguments);
                              let parameter = match(patterns) {
                                [single] => { single },
                                _ => { PTuple(patterns) }
                              };
                              let target = TyCon(SmlList.map(TyVar)(vs), ([], decapitalize(name)));
                              let body = ETyped(
                                ERecord(
                                  p,
                                  SmlList.map((label, argument) => { (label, EId(p, ([], argument))) })(arguments)
                                ),
                                target
                              );
                              [DVal(p, [], [(PId(p, ([], name)), EFn([(parameter, body)]))], [])]
                            }
                          },
                          match(fieldPrefix) {
                            None => { [] },
                            Some(_) => {
                              SmlList.map((label, t) => {
                                DType(p, [(vs, fieldAlias(decapitalize(name), label), parameterType(vs, t))])
                              })(fields)
                            }
                          }
                        )
                      ],
                      ts
                    )
                  })
                })
              })
            })
          },
          _ => { expected("a record name", advance(ts)) }
        }
      },
      (WKey("from"), _) => {
        match(peek(advance(ts)), peek(advance(advance(ts))), peek(advance(advance(advance(ts))))) {
          ((WScon(SString(file)), _), (WKey("import"), _), (WKey("*"), _)) => {
            let rest = advance(advance(advance(advance(ts))));
            if (isKey("as", rest)) {
              bind(expect(";", advance(advance(rest))))((_) => (ts) => { Done([], ts) })
            } else {
              bind(expect(";", rest))((_) => (ts) => { Done([DOpen(p, [[structureName(file)]])], ts) })
            }
          },
          _ => {
            Fail("only `from \"./file.wm\" import *` imports have a SubsetML counterpart", p)
          }
        }
      },
      _ => { expected("a declaration", ts) }
    }
  }

  // `<a, b>` after a type name.
  and typeParams = (ts) => {
    if (isKey("<", ts)) {
      delimited(
        "<",
        (ts) => {
          match(peek(ts)) {
            (WName([v]), _) => { Done("'" ++ v, advance(ts)) },
            _ => { expected("a type parameter", ts) }
          }
        },
        ",",
        ">",
        ts
      )
    } else { Done([], ts) }
  }

  // `type` bindings: aliases, or datatypes when the body has `|`.
  and parseTypeDecl = (p, ts) => {
    // `C` or `C<T1, ..., Tn>`; several arguments are one tuple payload.
    let constructor = (ts) => {
      match(peek(ts)) {
        (WName([c]), Var(cp)) => {
          if (SubsetBool.not(isUpperName(c))) { expected("a constructor", ts) } else {
            if (isKey("<", advance(ts))) {
              bind(delimited("<", parseType, ",", ">", advance(ts)))((args) => (ts) => {
                match(args) {
                  [single] => { Done((cp, constructorName(c), Some(single)), ts) },
                  _ => { Done((cp, constructorName(c), Some(TyTuple(args))), ts) }
                }
              })
            } else { Done((cp, constructorName(c), None), advance(ts)) }
          }
        },
        _ => { expected("a constructor", ts) }
      }
    };
    let rec members = (acc, ts) => {
      if (isKey("|", ts)) {
        bind(constructor(advance(ts)))((c) => (ts) => { members([c, ..acc], ts) })
      } else { Done(SmlList.rev(acc), ts) }
    };
    let binding = (ts) => {
      match(peek(ts)) {
        (WName([name]), _) => {
          bind(typeParams(advance(ts)))((vs) => (ts) => {
            bind(expect("=", ts))((_) => (body) => {
              if (isKey("|", body)) {
                bind(members([], body))((cons) => (ts) => { Done((vs, decapitalize(name), None, cons), ts) })
              } else {
                // Without a leading `|`, a body with no `|` is an alias.
                bind(parseType(body))((t) => (ts) => {
                  if (isKey("|", ts)) {
                    bind(constructor(body))((first) => (ts) => {
                      bind(members([first], ts))((cons) => (ts) => { Done((vs, decapitalize(name), None, cons), ts) })
                    })
                  } else { Done((vs, decapitalize(name), Some(t), []), ts) }
                })
              }
            })
          })
        },
        _ => { expected("a type name", ts) }
      }
    };
    let rec bindings = (ts) => {
      bind(binding(ts))((b) => (ts) => {
        if (isKey("and", ts)) {
          bind(bindings(advance(ts)))((bs) => (ts) => { Done([b, ..bs], ts) })
        } else { Done([b], ts) }
      })
    };
    bind(bindings(ts))((bs) => (ts) => {
      bind(expect(";", ts))((_) => (ts) => {
        match(SmlList.all((_, _, alias, _) => { SmlOption.isSome(alias) })(bs), SmlList.all((_, _, alias, _) => { SubsetBool.not(SmlOption.isSome(alias)) })(bs)) {
          (true, _) => {
            Done(
              [
                DType(
                  p,
                  SmlList.map((vs, n, alias, _) => {
                    let Some(t) = alias;
                    (vs, n, parameterType(vs, t))
                  })(bs)
                )
              ],
              ts
            )
          },
          (_, true) => {
            Done(
              [
                DDatatype(
                  p,
                  SmlList.map((vs, n, _, cons) => {
                    (
                      vs,
                      n,
                      SmlList.map((q, c, arg) => {
                        (
                          q,
                          c,
                          match(arg) {
                            Some(t) => { Some(parameterType(vs, t)) },
                            None => { None }
                          }
                        )
                      })(cons)
                    )
                  })(bs)
                )
              ],
              ts
            )
          },
          _ => {
            Fail("SubsetML cannot mix type aliases and datatypes in one group", p)
          }
        }
      })
    })
  };

  // ---------------------------------------------------------------------------------------
  // Modules

  match(lexed) {
    LexError(message, pos) => { ParseError(message, pos) },
    Tokens(ts, comments) => {
      let rec items = (decs, exps, ts) => {
        match(peek(ts)) {
          (WEOF, _) => { Done((SmlList.rev(decs), SmlList.rev(exps)), ts) },
          _ => {
            if (if (startsDecl(ts)) { true } else { isKey("from", ts) }) {
              bind(parseDecl(ts))((ds) => (ts) => { items(SmlList.revAppend(ds, decs), exps, ts) })
            } else {
              bind(parseExp(ts))((e) => (ts) => {
                bind(expect(";", ts))((_) => (ts) => {
                  items([DVal((0: I32), [], [(PId((0: I32), ([], "it")), e)], []), ..decs], exps, ts)
                })
              })
            }
          }
        }
      };
      match(items([], [], ts)) {
        Done((Var(decs), Var(exps)), _) => { Module(SubsetList.append(aliases, decs), exps, comments) },
        Fail(message, pos) => { ParseError(message, pos) }
      }
    }
  }
};

let parseModuleTokens = (layouts, owner, src, lexed) => { parseModuleLowering(layouts, owner, src, lexed, None) };

let parseModuleProject = (layouts, owner, src, lexed, prefix) => {
  parseModuleLowering(layouts, owner, src, lexed, Some(prefix))
};

let parseModuleWithLayouts = (layouts, owner, src) => { parseModuleTokens(layouts, owner, src, WmLexer.lex(src)) };

/* Extract declaration layouts without requiring the rest of a module to translate yet.
   Complete expressions still pass through normal parsing and strict elaboration. */
let recordLayoutsTokens = (owner, src, lexed) => {
  let rec scan = (tokens, layouts, depth) => {
    match(tokens) {
      [(WKey("record"), Var(start)), ..rest] => {
        if (depth > (0: I32)) {
          Fail(
            "record layout declarations must be top-level in the initial translation profile",
            start
          )
        } else {
          let rec header = (remaining) => {
            match(remaining) {
              [(WKey(";"), Var(stop)), ..tail] => {
                match(parseModuleTokens(
                  [],
                  owner,
                  src,
                  Tokens(
                    SubsetList.append(SubsetList.filter(tokens, (_, p) => { p <= stop }), [(WEOF, stop + (1: I32))]),
                    []
                  )
                )) {
                  Module([DType(_, [(Var(variables), Var(name), TyRecord(fields))])], [], _) => {
                    scan(tail, [Layout(owner, name, variables, fields), ..layouts], depth)
                  },
                  Module(_, _, _) => { Fail("invalid record declaration", start) },
                  ParseError(message, offset) => { Fail(message, offset) }
                }
              },
              [(WEOF, Var(offset)), .._] => { Fail("unterminated record declaration", offset) },
              [_, ..tail] => { header(tail) },
              [] => { Fail("unterminated record declaration", start) }
            }
          };
          header(rest)
        }
      },
      [(WKey("{"), _), ..rest] => { scan(rest, layouts, depth + (1: I32)) },
      [(WKey(".{"), _), ..rest] => { scan(rest, layouts, depth + (1: I32)) },
      [(WKey("}"), _), ..rest] => { scan(rest, layouts, depth - (1: I32)) },
      [_, ..rest] => { scan(rest, layouts, depth) },
      [] => { Done(SmlList.rev(layouts), []) }
    }
  };
  match(lexed) {
    LexError(message, offset) => { Fail(message, offset) },
    Tokens(tokens, _) => { scan(tokens, [], (0: I32)) }
  }
};

let recordLayouts = (path, src) => {
  recordLayoutsTokens(structureName(path), src, WmLexer.lex(src))
};

let parseModule = (src) => {
  match(recordLayouts("", src)) {
    Fail(message, offset) => { ParseError(message, offset) },
    Done(layouts, _) => { parseModuleWithLayouts(layouts, "", src) }
  }
};
