from "./subset_source.sml" import * as SubsetSource;
from "./subset_result.sml" import * as SubsetResult;
from "./subset_string.sml" import * as SubsetString;
from "./compiler_text.sml" import * as CompilerText;
from "./lexer.sml" import * as Lexer;
*/

/* Lexical analysis of Workman source, following frontend-v3's lexical design
   (../wm-mini/tooling/frontend-v3/lexical-design.md), for the fragment that corresponds to
   SubsetML. Identifiers may also contain primes. */

from "./subset_option_value.wm" import * as SubsetOptionValue;
from "./syntax.wm" import * as Syntax;
from "./sml_list.wm" import * as SmlList;
from "./subset_char.wm" import * as SubsetChar;
from "./subset_source.wm" import * as SubsetSource;
from "./subset_result.wm" import * as SubsetResult;
from "./subset_string.wm" import * as SubsetString;
from "./compiler_text.wm" import * as CompilerText;
from "./lexer.wm" import * as Lexer;

export from "./subset_option_value.wm" import *;

export from "./syntax.wm" import *;

/* Every translated file starts with this line. Reverse translation drops it, so a file can
   round trip without the SML side gaining a comment that describes the WM side. */
let generatedMarker = "Generated by SubsetML";
let generatedHeader = (source) => {
  "// " ++ generatedMarker ++ " from " ++ source ++ ".sml. Do not edit: change the .sml source.\n"
};

type Token =
  | WKey<String> // keyword, punctuation or operator
  | WName<List<String>> // a dotted path such as Lexer.lex or r.x
  | WSelect<String> // SML fallback `#lab`
  | WScon<Scon> // literal; the parser forms negative numbers
  | WOpen<List<List<String>>> // internal resolved header open; never lexed from source
  | WEOF;

type Step<a> = Ok<a, I32> | Err<String, Pos>;

type Result = Tokens<List<(Token, Pos)>, List<Comment>> | LexError<String, Pos>;

let keywords = [
  "let",
  "rec",
  "and",
  "type",
  "record",
  "if",
  "else",
  "match",
  "from",
  "import",
  "as",
  "true",
  "false",
  "void"
];

// Longest first, so that a prefix never shadows a longer operator.
let symbols = [
  "..",
  ".{",
  ":>",
  "=>",
  "->",
  "==",
  "!=",
  "<=",
  ">=",
  "&&",
  "||",
  "++",
  "(",
  ")",
  "[",
  "]",
  "{",
  "}",
  ",",
  ";",
  ":",
  ".",
  "<",
  ">",
  "=",
  "+",
  "-",
  "*",
  "/",
  "%",
  "!",
  "|",
  "@",
  "~"
];

let member = (x, xs) => { SmlList.exists((y) => { y == x })(xs) };

let isIdentChar = (c) => {
  if (if (SubsetChar.isAlphaNum(c)) { true } else { c == '_' }) { true } else { c == '\'' }
};

let isSpace = (c) => {
  if (if (if (if (c == ' ') { true } else { c == '\t' }) { true } else { c == '\n' }) { true } else { c == '\r' }) { true } else { c == '\u000c' }
};

let lex = (src) => {
  match(SubsetSource.fromNative(src)) {
    SubsetResult.Err(SubsetString.NonByte(offset)) => { LexError("source contains a non-byte character", offset) },
    SubsetResult.Ok(source) => {
      let n = SubsetSource.length(source);

      let at = (i) => { CompilerText.sub(source, i) };
      let has = (i, c) => { if (i < n) { at(i) == c } else { false } };
      let digitAt = (i) => { if (i < n) { SubsetChar.isDigit(at(i)) } else { false } };

      let rec skipWhile = (p, i) => {
        if (if (i < n) { p(at(i)) } else { false }) { skipWhile(p, i + (1: I32)) } else { i }
      };

      let startsWith = (i, s) => {
        if (i + CompilerText.size(s) <= n) { CompilerText.substring(source, i, CompilerText.size(s)) == s } else { false }
      };

      // Whether code precedes offset i on its line.
      let trailing = (i) => {
        let rec back = (k) => {
          if (k < (0: I32)) { false } else {
            match(at(k)) {
              '\n' => { false },
              Var(c) => { if (isSpace(c)) { back(k - (1: I32)) } else { true } }
            }
          }
        };
        back(i - (1: I32))
      };

      // A nested block comment; i is after the opening `/*`.
      let rec blockComment = (start, i, depth) => {
        match(depth == (0: I32), i + (1: I32) >= n) {
          (true, _) => { Ok(void, i) },
          (false, true) => { Err("unterminated comment", start) },
          (false, false) => {
            match(at(i), at(i + (1: I32))) {
              ('/', '*') => { blockComment(start, i + (2: I32), depth + (1: I32)) },
              ('*', '/') => { blockComment(start, i + (2: I32), depth - (1: I32)) },
              _ => { blockComment(start, i + (1: I32), depth) }
            }
          }
        }
      };

      let hexValue = (i, j) => {
        SmlList.foldl((c, acc) => { acc * (16: I32) + Lexer.digitValue(c) })((0: I32))(CompilerText.explode(CompilerText.substring(source, i, j - i)))
      };

      let charFromCode = (code, pos, next) => {
        match(SubsetChar.fromCode(code)) {
          SubsetResult.Ok(c) => { Ok(Some(c), next) },
          SubsetResult.Err(error) => {
            Err("SubsetML characters are 8-bit; the code exceeds 255", pos)
          }
        }
      };

      // An escape; i is just after the backslash. NONE is a gap.
      let escape = (i) => {
        if (i >= n) { Err("unterminated escape sequence", i - (1: I32)) } else {
          match(at(i)) {
            'a' => { Ok(Some('\u0007'), i + (1: I32)) },
            'b' => { Ok(Some('\u0008'), i + (1: I32)) },
            't' => { Ok(Some('\t'), i + (1: I32)) },
            'n' => { Ok(Some('\n'), i + (1: I32)) },
            'v' => { Ok(Some('\u000b'), i + (1: I32)) },
            'f' => { Ok(Some('\u000c'), i + (1: I32)) },
            'r' => { Ok(Some('\r'), i + (1: I32)) },
            '"' => { Ok(Some('"'), i + (1: I32)) },
            '\'' => { Ok(Some('\''), i + (1: I32)) },
            '\\' => { Ok(Some('\\'), i + (1: I32)) },
            '^' => {
              if (if (if (i + (1: I32) < n) { Lexer.byteCode(at(i + (1: I32))) >= (64: I32) } else { false }) { Lexer.byteCode(at(i + (1: I32))) <= (95: I32) } else { false }) {
                charFromCode(Lexer.byteCode(at(i + (1: I32))) - (64: I32), i - (1: I32), i + (2: I32))
              } else { Err("illegal control escape sequence", i - (1: I32)) }
            },
            'u' => {
              if (has(i + (1: I32), '{')) {
                let j = skipWhile(SubsetChar.isHexDigit, i + (2: I32));
                if (if (if (has(j, '}')) { j > i + (2: I32) } else { false }) { j <= i + (8: I32) } else { false }) {
                  charFromCode(hexValue(i + (2: I32), j), i - (1: I32), j + (1: I32))
                } else { Err("malformed \\u{...} escape", i - (1: I32)) }
              } else {
                let j = skipWhile(SubsetChar.isHexDigit, i + (1: I32));
                if (j - (i + (1: I32)) >= (4: I32)) {
                  charFromCode(hexValue(i + (1: I32), i + (5: I32)), i - (1: I32), i + (5: I32))
                } else {
                  Err("\\u must be followed by four hexadecimal digits", i - (1: I32))
                }
              }
            },
            Var(c) => {
              match(SubsetChar.isDigit(c), isSpace(c)) {
                (true, _) => {
                  if (if (digitAt(i + (1: I32))) { digitAt(i + (2: I32)) } else { false }) {
                    charFromCode(
                      Lexer.digitValue(c) * (100: I32) + Lexer.digitValue(at(i + (1: I32))) * (10: I32) + Lexer.digitValue(at(i + (2: I32))),
                      i - (1: I32),
                      i + (3: I32)
                    )
                  } else {
                    Err("decimal escape needs exactly three digits", i - (1: I32))
                  }
                },
                (false, true) => {
                  let j = skipWhile(isSpace, i);
                  if (has(j, '\\')) { Ok(None, j + (1: I32)) } else { Err("unterminated string gap", i - (1: I32)) }
                },
                (false, false) => { Err("illegal escape sequence", i - (1: I32)) }
              }
            }
          }
        }
      };

      // A quoted literal body; i is just after the opening quote.
      let rec quoted = (quote, start, i, acc) => {
        if (i >= n) { Err("unterminated literal", start) } else {
          match(at(i)) {
            '\\' => {
              match(escape(i + (1: I32))) {
                Ok(None, j) => { quoted(quote, start, j, acc) },
                Ok(Some(c), j) => { quoted(quote, start, j, [c, ..acc]) },
                Err(message, offset) => { Err(message, offset) }
              }
            },
            '\n' => { Err("unterminated literal", start) },
            Var(c) => {
              if (c == quote) { Ok(CompilerText.implode(SmlList.rev(acc)), i + (1: I32)) } else {
                if (Lexer.byteCode(c) < (32: I32)) { Err("control character in a literal", i) } else { quoted(quote, start, i + (1: I32), [c, ..acc]) }
              }
            }
          }
        }
      };

      // A number; SML spells the exponent sign `~` and has no `+`.
      let lexNumber = (start) => {
        let text = (j) => {
          CompilerText.translate(match {
            '-' => { "~" },
            '+' => { "" },
            Var(c) => { CompilerText.str(c) }
          })(CompilerText.substring(source, start, j - start))
        };
        let hexAt = (j) => { if (j < n) { SubsetChar.isHexDigit(at(j)) } else { false } };
        match(if (at(start) == '0') { has(start + (1: I32), 'w') } else { false }, if (if (at(start) == '0') { has(start + (1: I32), 'x') } else { false }) { hexAt(start + (2: I32)) } else { false }) {
          (true, _) => { Err("word constants are not part of SubsetML", start) },
          (false, true) => {
            let j = skipWhile(SubsetChar.isHexDigit, start + (2: I32));
            Ok(WScon(SInt(text(j))), j)
          },
          (false, false) => {
            let j = skipWhile(SubsetChar.isDigit, start);
            let k = if (if (has(j, '.')) { digitAt(j + (1: I32)) } else { false }) { skipWhile(SubsetChar.isDigit, j + (1: I32)) } else { j };
            let signed = if (if (has(k + (1: I32), '-')) { true } else { has(k + (1: I32), '+') }) { k + (2: I32) } else { k + (1: I32) };
            let m = if (if (if (has(k, 'e')) { true } else { has(k, 'E') }) { digitAt(signed) } else { false }) { skipWhile(SubsetChar.isDigit, signed) } else { k };
            if (m == j) { Ok(WScon(SInt(text(j))), j) } else { Ok(WScon(SReal(text(m))), m) }
          }
        }
      };

      // A name or dotted path: Lexer.lex, r.x, Syntax.TyCon.
      let lexPath = (start) => {
        let rec parts = (i, acc) => {
          let j = skipWhile(isIdentChar, i);
          let acc' = [CompilerText.substring(source, i, j - i), ..acc];
          if (if (if (has(j, '.')) { j + (1: I32) < n } else { false }) { SubsetChar.isAlpha(at(j + (1: I32))) } else { false }) { parts(j + (1: I32), acc') } else { (SmlList.rev(acc'), j) }
        };
        let (path, j) = parts(start, []);
        match(path, startsWith(j, ".=="), startsWith(j, ".!=")) {
          (["Real"], true, _) => { Ok(WName(["Real", "=="]), j + (3: I32)) },
          (["Real"], _, true) => { Ok(WName(["Real", "!="]), j + (3: I32)) },
          ([word], _, _) => {
            if (member(word, keywords)) { Ok(WKey(word), j) } else { Ok(WName(path), j) }
          },
          _ => { Ok(WName(path), j) }
        }
      };

      let lexSymbol = (i) => {
        match(SmlList.find((s) => { startsWith(i, s) })(symbols)) {
          Some(s) => { Ok(WKey(s), i + CompilerText.size(s)) },
          None => { Err("unexpected character", i) }
        }
      };

      let rec loop = (i, acc, cs) => {
        if (i >= n) { Tokens(SmlList.rev([(WEOF, n), ..acc]), SmlList.rev(cs)) } else {
          match(at(i), if (startsWith(i, "//")) { true } else { startsWith(i, "--") }, startsWith(i, "/*")) {
            (_, true, _) => {
              let j = skipWhile((d) => { d != '\n' }, i);
              let body = CompilerText.substring(source, i + (2: I32), j - i - (2: I32));
              loop(j, acc, [(i, body, trailing(i)), ..cs])
            },
            (_, _, true) => {
              match(blockComment(i, i + (2: I32), (1: I32))) {
                Ok(_, j) => {
                  loop(
                    j,
                    acc,
                    [
                      (i, CompilerText.substring(source, i + (2: I32), j - i - (4: I32)), trailing(i)),
                      ..cs
                    ]
                  )
                },
                Err(message, offset) => { LexError(message, offset) }
              }
            },
            ('"', _, _) => {
              match(quoted('"', i, i + (1: I32), [])) {
                Ok(s, j) => { loop(j, [(WScon(SString(s)), i), ..acc], cs) },
                Err(message, offset) => { LexError(message, offset) }
              }
            },
            ('\'', _, _) => {
              match(quoted('\'', i, i + (1: I32), [])) {
                Ok(s, j) => {
                  if (CompilerText.size(s) == (1: I32)) {
                    loop(
                      j,
                      [
                        (
                          WScon(SChar({
                            let SubsetResult.Ok(decoded) = SubsetSource.fromNative(s);
                            CompilerText.sub(decoded, (0: I32))
                          })),
                          i
                        ),
                        ..acc
                      ],
                      cs
                    )
                  } else {
                    LexError("a character literal must contain exactly one character", i)
                  }
                },
                Err(message, offset) => { LexError(message, offset) }
              }
            },
            ('`', _, _) => { LexError("backtick strings have no SubsetML counterpart", i) },
            ('#', _, _) => {
              let j = skipWhile(SubsetChar.isAlphaNum, i + (1: I32));
              if (j > i + (1: I32)) {
                loop(
                  j,
                  [
                    (WSelect(CompilerText.substring(source, i + (1: I32), j - i - (1: I32))), i),
                    ..acc
                  ],
                  cs
                )
              } else { LexError("expected a label after `#`", i) }
            },
            ('_', _, _) => {
              if (if (i + (1: I32) < n) { isIdentChar(at(i + (1: I32))) } else { false }) {
                LexError("identifiers starting with `_` are not SubsetML", i)
              } else { loop(i + (1: I32), [(WKey("_"), i), ..acc], cs) }
            },
            (Var(c), _, _) => {
              match(isSpace(c), SubsetChar.isDigit(c), SubsetChar.isAlpha(c)) {
                (true, _, _) => { loop(i + (1: I32), acc, cs) },
                (_, true, _) => {
                  match(lexNumber(i)) {
                    Ok(tok, j) => { loop(j, [(tok, i), ..acc], cs) },
                    Err(message, offset) => { LexError(message, offset) }
                  }
                },
                (_, _, true) => {
                  match(lexPath(i)) {
                    Ok(tok, j) => { loop(j, [(tok, i), ..acc], cs) },
                    Err(message, offset) => { LexError(message, offset) }
                  }
                },
                _ => {
                  match(lexSymbol(i)) {
                    Ok(tok, j) => { loop(j, [(tok, i), ..acc], cs) },
                    Err(message, offset) => { LexError(message, offset) }
                  }
                }
              }
            }
          }
        }
      };
      loop((0: I32), [], [])
    }
  }
};
