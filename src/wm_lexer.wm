// Generated by SubsetML from wm_lexer.sml. Do not edit: change the .sml source.
/* @subsetml
from "./subset_option_value.sml" import * as SubsetOptionValue;
from "./syntax.sml" import * as Syntax;
from "./sml_list.sml" import * as SmlList;
from "./subset_bool.sml" import * as SubsetBool;
from "./subset_list.sml" import * as SubsetList;
from "./subset_char.sml" import * as SubsetChar;
from "./subset_source.sml" import * as SubsetSource;
from "./subset_result.sml" import * as SubsetResult;
from "./subset_string.sml" import * as SubsetString;
from "./compiler_text.sml" import * as CompilerText;
from "./lexer.sml" import * as Lexer;
*/

/* Lexical analysis of Workman source, following frontend-v3's lexical design
   (../wm-mini/tooling/frontend-v3/lexical-design.md), for the fragment that corresponds to
   SubsetML. Identifiers may also contain primes. */

from "./subset_option_value.wm" import * as SubsetOptionValue;
from "./syntax.wm" import * as Syntax;
from "./sml_list.wm" import * as SmlList;
from "./compiler_text.wm" import * as CompilerText;
from "./subset_char.wm" import * as SubsetChar;
from "./subset_source.wm" import * as SubsetSource;
from "./subset_result.wm" import * as SubsetResult;
from "./subset_string.wm" import * as SubsetString;
from "./lexer.wm" import * as Lexer;
from "./subset_list.wm" import * as SubsetList;
from "./subset_bool.wm" import * as SubsetBool;

export from "./subset_option_value.wm" import *;

export from "./syntax.wm" import *;

/* Every translated file starts with this line. Reverse translation drops it, so a file can
   round trip without the SML side gaining a comment that describes the WM side. */
let generatedMarker = "Generated by SubsetML";
let generatedHeader = (source) => {
  "// " ++ generatedMarker ++ " from " ++ source ++ ".sml. Do not edit: change the .sml source.\n"
};

type Token =
  | WKey<String> // keyword, punctuation or operator
  | WName<List<String>> // a dotted path such as Lexer.lex or r.x
  | WSelect<String> // SML fallback `#lab`
  | WScon<Scon> // literal; the parser forms negative numbers
  | WOpen<List<List<String>>> // internal resolved header open; never lexed from source
  | WEOF;

type Step<a> = Ok<a, Int32.Int> | Err<String, Pos>;

type Result = Tokens<List<(Token, Pos)>, List<Comment>> | LexError<String, Pos>;

let keywords = [
  "let",
  "rec",
  "and",
  "type",
  "record",
  "if",
  "else",
  "match",
  "from",
  "import",
  "as",
  "true",
  "false",
  "void"
];

// Longest first, so that a prefix never shadows a longer operator.
let symbols = [
  "..",
  ".{",
  ":>",
  "=>",
  "->",
  "==",
  "!=",
  "<=",
  ">=",
  "&&",
  "||",
  "++",
  "(",
  ")",
  "[",
  "]",
  "{",
  "}",
  ",",
  ";",
  ":",
  ".",
  "<",
  ">",
  "=",
  "+",
  "-",
  "*",
  "/",
  "%",
  "!",
  "|",
  "@",
  "~"
];

// Each symbol with its bytes, so lexing compares bytes in place.
let symbolBytes = SmlList.map((s) => { (s, CompilerText.explode(s)) })(symbols);

let member = (x, xs) => { SmlList.exists((y) => { y == x })(xs) };

let isIdentChar = (c) => {
  if (if (SubsetChar.isAlphaNum(c)) { true } else { c == '_' }) { true } else { c == '\'' }
};

let isSpace = (c) => {
  if (if (if (if (c == ' ') { true } else { c == '\t' }) { true } else { c == '\n' }) { true } else { c == '\r' }) { true } else { c == '\u000c' }
};

let lex = (src) => {
  match(SubsetSource.fromNative(src)) {
    SubsetResult.Err(SubsetString.NonByte(offset)) => { LexError("source contains a non-byte character", offset) },
    SubsetResult.Ok(source) => {
      let n = SubsetSource.length(source);

      let at = (i) => { CompilerText.sub(source, i) };
      let has = (i, c) => { if (i < n) { at(i) == c } else { false } };
      let digitAt = (i) => { if (i < n) { SubsetChar.isDigit(at(i)) } else { false } };

      let rec skipWhile = (p, i) => {
        if (if (i < n) { p(at(i)) } else { false }) { skipWhile(p, i + 1) } else { i }
      };

      /* Compared byte by byte in place: slicing the source for every candidate symbol at every
         offset dominated lexing. */
      let startsWithBytes = (i, cs) => {
        let rec go = (k, cs) => {
          match(cs) {
            [] => { true },
            [c, ..rest] => {
              if (if (i + k < n) { at(i + k) == c } else { false }) { go(k + 1, rest) } else { false }
            }
          }
        };
        go(0, cs)
      };

      let startsWith = (i, s) => { startsWithBytes(i, CompilerText.explode(s)) };

      // Whether code precedes offset i on its line.
      let trailing = (i) => {
        let rec back = (k) => {
          if (k < 0) { false } else {
            match(at(k)) {
              '\n' => { false },
              Var(c) => { if (isSpace(c)) { back(k - 1) } else { true } }
            }
          }
        };
        back(i - 1)
      };

      // A nested block comment; i is after the opening `/*`.
      let rec blockComment = (start, i, depth) => {
        match(depth == 0, i + 1 >= n) {
          (true, _) => { Ok(void, i) },
          (false, true) => { Err("unterminated comment", start) },
          (false, false) => {
            match(at(i), at(i + 1)) {
              ('/', '*') => { blockComment(start, i + 2, depth + 1) },
              ('*', '/') => { blockComment(start, i + 2, depth - 1) },
              _ => { blockComment(start, i + 1, depth) }
            }
          }
        }
      };

      let hexValue = (i, j) => {
        SmlList.foldl((c, acc) => { acc * 16 + Lexer.digitValue(c) })(0)(CompilerText.explode(CompilerText.substring(source, i, j - i)))
      };

      let charFromCode = (code, pos, next) => {
        match(SubsetChar.fromCode(code)) {
          SubsetResult.Ok(c) => { Ok(Some(c), next) },
          SubsetResult.Err(error) => {
            Err("SubsetML characters are 8-bit; the code exceeds 255", pos)
          }
        }
      };

      // An escape; i is just after the backslash. NONE is a gap.
      let escape = (i) => {
        if (i >= n) { Err("unterminated escape sequence", i - 1) } else {
          match(at(i)) {
            'a' => { Ok(Some('\u0007'), i + 1) },
            'b' => { Ok(Some('\u0008'), i + 1) },
            't' => { Ok(Some('\t'), i + 1) },
            'n' => { Ok(Some('\n'), i + 1) },
            'v' => { Ok(Some('\u000b'), i + 1) },
            'f' => { Ok(Some('\u000c'), i + 1) },
            'r' => { Ok(Some('\r'), i + 1) },
            '"' => { Ok(Some('"'), i + 1) },
            '\'' => { Ok(Some('\''), i + 1) },
            '\\' => { Ok(Some('\\'), i + 1) },
            '^' => {
              if (if (if (i + 1 < n) { Lexer.byteCode(at(i + 1)) >= 64 } else { false }) { Lexer.byteCode(at(i + 1)) <= 95 } else { false }) { charFromCode(Lexer.byteCode(at(i + 1)) - 64, i - 1, i + 2) } else { Err("illegal control escape sequence", i - 1) }
            },
            'u' => {
              if (has(i + 1, '{')) {
                let j = skipWhile(SubsetChar.isHexDigit, i + 2);
                if (if (if (has(j, '}')) { j > i + 2 } else { false }) { j <= i + 8 } else { false }) { charFromCode(hexValue(i + 2, j), i - 1, j + 1) } else { Err("malformed \\u{...} escape", i - 1) }
              } else {
                let j = skipWhile(SubsetChar.isHexDigit, i + 1);
                if (j - (i + 1) >= 4) { charFromCode(hexValue(i + 1, i + 5), i - 1, i + 5) } else {
                  Err("\\u must be followed by four hexadecimal digits", i - 1)
                }
              }
            },
            Var(c) => {
              match(SubsetChar.isDigit(c), isSpace(c)) {
                (true, _) => {
                  if (if (digitAt(i + 1)) { digitAt(i + 2) } else { false }) {
                    charFromCode(
                      Lexer.digitValue(c) * 100 + Lexer.digitValue(at(i + 1)) * 10 + Lexer.digitValue(at(i + 2)),
                      i - 1,
                      i + 3
                    )
                  } else { Err("decimal escape needs exactly three digits", i - 1) }
                },
                (false, true) => {
                  let j = skipWhile(isSpace, i);
                  if (has(j, '\\')) { Ok(None, j + 1) } else { Err("unterminated string gap", i - 1) }
                },
                (false, false) => { Err("illegal escape sequence", i - 1) }
              }
            }
          }
        }
      };

      // A quoted literal body; i is just after the opening quote.
      let rec quoted = (quote, start, i, acc) => {
        if (i >= n) { Err("unterminated literal", start) } else {
          match(at(i)) {
            '\\' => {
              match(escape(i + 1)) {
                Ok(None, j) => { quoted(quote, start, j, acc) },
                Ok(Some(c), j) => { quoted(quote, start, j, [c, ..acc]) },
                Err(message, offset) => { Err(message, offset) }
              }
            },
            '\n' => { Err("unterminated literal", start) },
            Var(c) => {
              if (c == quote) { Ok(CompilerText.implode(SmlList.rev(acc)), i + 1) } else {
                if (Lexer.byteCode(c) < 32) { Err("control character in a literal", i) } else { quoted(quote, start, i + 1, [c, ..acc]) }
              }
            }
          }
        }
      };

      // A number; SML spells the exponent sign `~` and has no `+`.
      let lexNumber = (start) => {
        let text = (j) => {
          CompilerText.translate(match {
            '-' => { "~" },
            '+' => { "" },
            Var(c) => { CompilerText.str(c) }
          })(CompilerText.substring(source, start, j - start))
        };
        let hexAt = (j) => { if (j < n) { SubsetChar.isHexDigit(at(j)) } else { false } };
        match(if (at(start) == '0') { has(start + 1, 'w') } else { false }, if (if (at(start) == '0') { has(start + 1, 'x') } else { false }) { hexAt(start + 2) } else { false }) {
          (true, _) => { Err("word constants are not part of SubsetML", start) },
          (false, true) => {
            let j = skipWhile(SubsetChar.isHexDigit, start + 2);
            Ok(WScon(SInt(text(j))), j)
          },
          (false, false) => {
            let j = skipWhile(SubsetChar.isDigit, start);
            let k = if (if (has(j, '.')) { digitAt(j + 1) } else { false }) { skipWhile(SubsetChar.isDigit, j + 1) } else { j };
            let signed = if (if (has(k + 1, '-')) { true } else { has(k + 1, '+') }) { k + 2 } else { k + 1 };
            let m = if (if (if (has(k, 'e')) { true } else { has(k, 'E') }) { digitAt(signed) } else { false }) { skipWhile(SubsetChar.isDigit, signed) } else { k };
            if (m == j) { Ok(WScon(SInt(text(j))), j) } else { Ok(WScon(SReal(text(m))), m) }
          }
        }
      };

      // A name or dotted path: Lexer.lex, r.x, Syntax.TyCon.
      let lexPath = (start) => {
        let rec parts = (i, acc) => {
          let j = skipWhile(isIdentChar, i);
          let acc' = [CompilerText.substring(source, i, j - i), ..acc];
          if (if (if (has(j, '.')) { j + 1 < n } else { false }) { SubsetChar.isAlpha(at(j + 1)) } else { false }) { parts(j + 1, acc') } else { (SmlList.rev(acc'), j) }
        };
        let (path, j) = parts(start, []);
        match(path, startsWith(j, ".=="), startsWith(j, ".!=")) {
          (["Real"], true, _) => { Ok(WName(["Real", "=="]), j + 3) },
          (["Real"], _, true) => { Ok(WName(["Real", "!="]), j + 3) },
          ([word], _, _) => {
            if (member(word, keywords)) { Ok(WKey(word), j) } else { Ok(WName(path), j) }
          },
          _ => { Ok(WName(path), j) }
        }
      };

      let lexSymbol = (i) => {
        // Binding `=`, immediately followed by a bare lambda's `=>`, is legal WM.
        if (startsWith(i, "==>")) { Ok(WKey("="), i + 1) } else {
          match(SmlList.find((s, cs) => { startsWithBytes(i, cs) })(symbolBytes)) {
            Some(s, cs) => { Ok(WKey(s), i + SubsetList.length32(cs)) },
            None => { Err("unexpected character", i) }
          }
        }
      };

      /* Backtick text from i up to the closing backtick (true) or a `${` (false). Text may span
         lines; \` and \$ escape the delimiters. */
      let rec templateText = (start, i, acc) => {
        if (i >= n) { Err("unterminated backtick string", start) } else {
          match(at(i)) {
            '`' => { Ok((CompilerText.implode(SmlList.rev(acc)), true), i + 1) },
            '\\' => {
              if (has(i + 1, '`')) { templateText(start, i + 2, ['`', ..acc]) } else {
                if (has(i + 1, '$')) { templateText(start, i + 2, ['$', ..acc]) } else {
                  match(escape(i + 1)) {
                    Ok(None, j) => { templateText(start, j, acc) },
                    Ok(Some(c), j) => { templateText(start, j, [c, ..acc]) },
                    Err(message, offset) => { Err(message, offset) }
                  }
                }
              }
            },
            '$' => {
              if (has(i + 1, '{')) { Ok((CompilerText.implode(SmlList.rev(acc)), false), i + 2) } else { templateText(start, i + 1, ['$', ..acc]) }
            },
            Var(c) => { templateText(start, i + 1, [c, ..acc]) }
          }
        }
      };

      // Brace depth inside each open `${ … }`, innermost first.
      let nest = (tok, depths) => {
        match(tok, depths) {
          (WKey("{"), [d, ..rest]) => { [d + 1, ..rest] },
          (WKey(".{"), [d, ..rest]) => { [d + 1, ..rest] },
          (WKey("}"), [d, ..rest]) => { [d - 1, ..rest] },
          _ => { depths }
        }
      };

      // A template is `( text (${ exp }$ text)* `): each text piece is a string token.
      let rec template = (i, acc, cs, depths) => {
        match(templateText(i, i, [])) {
          Ok((Var(text), true), j) => {
            loop(j, [(WKey("`)"), j - 1), (WScon(SString(text)), i), ..acc], cs, depths)
          },
          Ok((Var(text), false), j) => {
            loop(j, [(WKey("${"), j - 2), (WScon(SString(text)), i), ..acc], cs, [0, ..depths])
          },
          Err(message, offset) => { LexError(message, offset) }
        }
      }

      and loop = (i, acc, cs, depths) => {
        if (i >= n) {
          match(depths) {
            [] => { Tokens(SmlList.rev([(WEOF, n), ..acc]), SmlList.rev(cs)) },
            _ => { LexError("unterminated `${` in a backtick string", n) }
          }
        } else {
          match(depths, at(i)) {
            ([0, ..rest], '}') => { template(i + 1, [(WKey("}$"), i), ..acc], cs, rest) },
            _ => {
              match(at(i), if (startsWith(i, "//")) { true } else { startsWith(i, "--") }, startsWith(i, "/*")) {
                (_, true, _) => {
                  let j = skipWhile((d) => { d != '\n' }, i);
                  let body = CompilerText.substring(source, i + 2, j - i - 2);
                  loop(j, acc, [(i, body, trailing(i)), ..cs], depths)
                },
                (_, _, true) => {
                  match(blockComment(i, i + 2, 1)) {
                    Ok(_, j) => {
                      loop(
                        j,
                        acc,
                        [(i, CompilerText.substring(source, i + 2, j - i - 4), trailing(i)), ..cs],
                        depths
                      )
                    },
                    Err(message, offset) => { LexError(message, offset) }
                  }
                },
                ('"', _, _) => {
                  match(quoted('"', i, i + 1, [])) {
                    Ok(s, j) => { loop(j, [(WScon(SString(s)), i), ..acc], cs, depths) },
                    Err(message, offset) => { LexError(message, offset) }
                  }
                },
                ('\'', _, _) => {
                  match(quoted('\'', i, i + 1, [])) {
                    Ok(s, j) => {
                      if (CompilerText.size(s) == 1) {
                        loop(
                          j,
                          [
                            (
                              WScon(SChar({
                                let SubsetResult.Ok(decoded) = SubsetSource.fromNative(s);
                                CompilerText.sub(decoded, 0)
                              })),
                              i
                            ),
                            ..acc
                          ],
                          cs,
                          depths
                        )
                      } else {
                        LexError("a character literal must contain exactly one character", i)
                      }
                    },
                    Err(message, offset) => { LexError(message, offset) }
                  }
                },
                ('`', _, _) => { template(i + 1, [(WKey("`("), i), ..acc], cs, depths) },
                ('#', _, _) => {
                  let j = skipWhile(SubsetChar.isAlphaNum, i + 1);
                  if (j > i + 1) {
                    loop(
                      j,
                      [(WSelect(CompilerText.substring(source, i + 1, j - i - 1)), i), ..acc],
                      cs,
                      depths
                    )
                  } else { LexError("expected a label after `#`", i) }
                },
                /* SML reserves a leading `_`, so Workman's `_name` reads as `name'`, or with more primes
                   when the module writes `name'` itself (`unprimed`). A lone `_name` is marked (`bind`),
                   because in a match pattern it binds where a bare name is pinned; the parser's `peek`
                   drops the mark. */
                ('_', _, _) => {
                  if (if (i + 1 < n) { isIdentChar(at(i + 1)) } else { false }) {
                    if (SubsetBool.not(SubsetChar.isAlpha(at(i + 1)))) {
                      LexError("identifiers starting with `_` and then a non-letter are not SubsetML", i)
                    } else {
                      match(lexPath(i + 1)) {
                        Ok(WName([only]), j) => {
                          loop(j, [(WName(["`bind", only ++ "'"]), i), ..acc], cs, depths)
                        },
                        Ok(WName([first, ..rest]), j) => {
                          loop(j, [(WName([first ++ "'", ..rest]), i), ..acc], cs, depths)
                        },
                        Ok(WKey(word), j) => {
                          loop(j, [(WName(["`bind", word ++ "'"]), i), ..acc], cs, depths)
                        },
                        Ok(_, j) => { LexError("unexpected name after `_`", i) },
                        Err(message, offset) => { LexError(message, offset) }
                      }
                    }
                  } else { loop(i + 1, [(WKey("_"), i), ..acc], cs, depths) }
                },
                (Var(c), _, _) => {
                  match(isSpace(c), SubsetChar.isDigit(c), SubsetChar.isAlpha(c)) {
                    (true, _, _) => { loop(i + 1, acc, cs, depths) },
                    (_, true, _) => {
                      match(lexNumber(i)) {
                        Ok(tok, j) => { loop(j, [(tok, i), ..acc], cs, depths) },
                        Err(message, offset) => { LexError(message, offset) }
                      }
                    },
                    (_, _, true) => {
                      match(lexPath(i)) {
                        Ok(tok, j) => { loop(j, [(tok, i), ..acc], cs, depths) },
                        Err(message, offset) => { LexError(message, offset) }
                      }
                    },
                    _ => {
                      match(lexSymbol(i)) {
                        Ok(tok, j) => { loop(j, [(tok, i), ..acc], cs, nest(tok, depths)) },
                        Err(message, offset) => { LexError(message, offset) }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      };
      /* Each `_name` takes the first of `name'`, `name''`, ... that the module doesn't write
         itself, so it never captures or shadows a name of the module. */
      let unprimed = (result) => {
        match(result) {
          Tokens(tokens, cs) => {
            let fromUnderscore = (token, i) => {
              match(token) {
                WName(["`bind", _]) => { true },
                WName(_) => { at(i) == '_' },
                _ => { false }
              }
            };
            let written = SubsetList.concat(SmlList.map((token, i) => {
              match(token) {
                WName(parts) => { if (fromUnderscore(token, i)) { [] } else { parts } },
                _ => { [] }
              }
            })(tokens));
            let rec free = (name) => {
              if (SmlList.exists((m) => { m == name })(written)) { free(name ++ "'") } else { name }
            };
            let rename = (token, i) => {
              match(token) {
                WName(["`bind", primed]) => { (WName(["`bind", free(primed)]), i) },
                WName([first, ..rest]) => {
                  if (at(i) == '_') { (WName([free(first), ..rest]), i) } else { (token, i) }
                },
                _ => { (token, i) }
              }
            };
            Tokens(SmlList.map(rename)(tokens), cs)
          },
          _ => { result }
        }
      };
      unprimed(loop(0, [], [], []))
    }
  }
};
