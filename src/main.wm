/* Command-line driver.

     subsetml check FILE...         parse and type-check the files, in order, as one program
     subsetml parse FILE...         print the abstract syntax of each file
     subsetml fmt FILE...           reprint each file as SubsetML
     subsetml wm OUTDIR FILE...     translate the program's files to Workman modules in OUTDIR
     subsetml sml OUTDIR FILE.wm... translate Workman modules to SubsetML files in OUTDIR
     subsetml roundtrip FILE...     check that SML -> Workman -> SML preserves each file's syntax */

from "./subset_io.wm" import * as SubsetIo;
from "./compiler_text.wm" import * as CompilerText;
from "./subset_result.wm" import * as SubsetResult;
from "./subset_process.wm" import * as SubsetProcess;
from "./syntax.wm" import * as Syntax;
from "./parser.wm" import * as Parser;
from "./sml_list.wm" import * as SmlList;
from "./subset_list.wm" import * as SubsetList;
from "./translate.wm" import * as Translate;
from "./sml_list_pair.wm" import * as SmlListPair;
from "./wm_parse.wm" import * as WmParse;
from "./unify.wm" import * as Unify;
from "./sml_option.wm" import * as SmlOption;
from "./print.wm" import * as Print;
from "./normalize.wm" import * as Normalize;
from "./basis.wm" import * as Basis;
from "./elab.wm" import * as Elab;

let eprint = (text) => {
  match(SubsetIo.writeStderr(CompilerText.characters(text))) {
    SubsetResult.Ok(result) => { result },
    SubsetResult.Err(error) => { SubsetProcess.exit(false) }
  }
};
let fatal = (message) => { (eprint(message ++ "\n"); SubsetProcess.exit(false)) };
let readFile = (path) => {
  match(SubsetIo.readFile(path)) {
    SubsetResult.Ok(bytes) => { CompilerText.stringOf(bytes) },
    SubsetResult.Err(error) => { fatal(path ++ ": " ++ SubsetIo.errorText(error)) }
  }
};
let writeFile = (path, text) => {
  match(SubsetIo.writeFile(CompilerText.characters(text), path)) {
    SubsetResult.Ok(result) => { result },
    SubsetResult.Err(error) => { fatal(path ++ ": " ++ SubsetIo.errorText(error)) }
  }
};
let output = (text) => {
  match(SubsetIo.writeStdout(CompilerText.characters(text))) {
    SubsetResult.Ok(result) => { result },
    SubsetResult.Err(error) => { fatal(SubsetIo.errorText(error)) }
  }
};

// 1-based line and column of a byte offset.
let lineCol = (src, offset) => {
  let rec go = (bytes, i, line, col) => {
    if (i >= offset) { (line, col) } else {
      match(bytes) {
        [] => { (line, col) },
        [c, ..rest] => {
          let newline = c == '\n';
          go(
            rest,
            i + 1,
            if (newline) { line + 1 } else { line },
            if (newline) { 1 } else { col + 1 }
          )
        }
      }
    }
  };
  go(CompilerText.characters(src), 0, 1, 1)
};

let errorLineKind = (path, src, kind, msg, pos) => {
  let (line, col) = lineCol(src, pos);
  path ++ ":" ++ CompilerText.natural(line) ++ ":" ++ CompilerText.natural(col) ++ ": " ++ kind ++ ": " ++ msg ++ "\n"
};

let errorLine = (path, src, msg, pos) => { errorLineKind(path, src, "error", msg, pos) };

type Parsed =
  | Parsed<String, String, List<Syntax.Topdec>, List<Syntax.Comment>>
  | Failed;

// Reads and parses a file, reporting any error.
let load = (path) => {
  let src = readFile(path);
  match(Parser.parse(src)) {
    Parser.ParseError(msg, pos) => { (eprint(errorLine(path, src, msg, pos)); Failed) },
    Parser.Program(phrases, comments) => { Parsed(path, src, phrases, comments) }
  }
};

let usage = () => {
  (
    eprint("usage: subsetml (check | parse | fmt | roundtrip) FILE...\n       subsetml wm OUTDIR FILE...\n       subsetml sml OUTDIR FILE.wm...\n");
    SubsetProcess.exit(false)
  )
};

let finish = (ok) => { SubsetProcess.exit(ok) };

// Runs `f` on every file once all of them have parsed.
let withParsed = (files, f) => {
  let loaded = SmlList.map(load)(files);
  let parsed = SmlList.concat(SmlList.map(match {
    Parsed(path, src, prog, comments) => { [(path, src, prog, comments)] },
    Failed => { [] }
  })(loaded));
  if (SmlList.null(files)) { usage() } else {
    if ((SubsetList.length(parsed): Number) == SubsetList.length(files)) { finish(f(parsed)) } else { finish(false) }
  }
};

let translate = (outDir, parsed) => {
  let structures = SmlList.concat(SmlList.map((ignored2, ignored3, prog, ignored4) => { Translate.structureOf(prog) })(parsed));
  let results = SmlList.map((path, src, prog, comments) => { Translate.toWm(structures, path, src, prog, comments) })(parsed);
  let errors = SmlList.concat(SmlList.map(match {
    Translate.TranslateError(e) => { [e] },
    Translate.Output(ignored5Field0, ignored5Field1, ignored5Field2) => { [] }
  })(results));
  let warn = ((path, src, ignored6, ignored7), result) => {
    match(result) {
      Translate.Output(ignored8, ignored9, warnings) => {
        SmlList.app((pos, msg) => { eprint(errorLineKind(path, src, "warning", msg, pos)) })(warnings)
      },
      Translate.TranslateError(ignored10) => { void }
    }
  };
  match(errors) {
    [] => {
      (
        SmlList.app(match {
          Translate.Output(name, text, ignored11) => { writeFile(outDir ++ "/" ++ name, text) },
          Translate.TranslateError(ignored12) => { void }
        })(results);
        SmlListPair.app(warn)(parsed, results);
        true
      )
    },
    Var(ignored13) => {
      (SmlList.app((e) => { eprint("error: " ++ e ++ "\n") })(errors); false)
    }
  }
};

// Workman to SubsetML: foo_bar.wm becomes foo_bar.sml holding structure FooBar.
let fromWm = (outDir, files) => {
  let loaded = SmlList.map((path) => {
    let src = readFile(path);
    match(WmParse.parseModule(src)) {
      WmParse.ParseError(msg, pos) => { (eprint(errorLine(path, src, msg, pos)); None) },
      WmParse.Module(ds, es, cs) => {
        Some(
          path,
          src,
          [
            Syntax.TopDecs([Syntax.SStructure(0, [(WmParse.structureName(path), ds)])]),
            ..SmlList.map((e) => { Syntax.TopExp(0, e) })(es)
          ],
          cs
        )
      }
    }
  })(files);
  let modules = SmlList.concat(SmlList.map(match {
    Some(m) => { [m] },
    None => { [] }
  })(loaded));
  let recovered = SmlList.map((m) => { Translate.recover(modules, m) })(modules);
  let ok = (SubsetList.length(modules): Number) == SubsetList.length(files);
  let results = SmlList.map(match {
    Unify.Err(msg, ignored14) => { (eprint("error translating Workman: " ++ msg ++ "\n"); None) },
    Unify.Ok((Var(path), Var(src), Var(prog), Var(cs)), ignored15) => {
      let (ignored16, phrases) = Translate.module(prog);
      let (ds, es) = Translate.parts(phrases);
      let stem = Translate.baseName(path);
      let name = if (CompilerText.isSuffix(stem, ".wm")) { CompilerText.slice(stem, 0, CompilerText.size(stem) - 3) } else { stem };
      Some(outDir ++ "/" ++ name ++ ".sml", Translate.fromWm(path, src, ds, es, cs))
    }
  })(recovered);
  if (if (ok) { SmlList.all(SmlOption.isSome)(results) } else { false }) {
    (
      SmlList.app(match {
        Some(entry) => {
          let (path, text) = entry;
          writeFile(path, text)
        },
        None => { void }
      })(results);
      true
    )
  } else { false }
};

// SML -> Workman -> SML must give back the same declarations, up to Normalize.
let roundTrip = (parsed) => {
  let structures = SmlList.concat(SmlList.map((ignored17, ignored18, prog, ignored19) => { Translate.structureOf(prog) })(parsed));
  let loaded = SmlList.map((path, src, prog, comments) => {
    match(Translate.toWm(structures, path, src, prog, comments)) {
      Translate.TranslateError(msg) => { (eprint(msg ++ "\n"); None) },
      Translate.Output(name, text, ignored20) => {
        match(WmParse.parseModule(text)) {
          WmParse.ParseError(msg, pos) => { (eprint(errorLine(path, text, msg, pos)); None) },
          WmParse.Module(ds, es, cs) => {
            Some(
              path,
              text,
              [
                Syntax.TopDecs([Syntax.SStructure(0, [(WmParse.structureName(name), ds)])]),
                ..SmlList.map((e) => { Syntax.TopExp(0, e) })(es)
              ],
              cs
            )
          }
        }
      }
    }
  })(parsed);
  let modules = SmlList.concat(SmlList.map(match {
    Some(m) => { [m] },
    None => { [] }
  })(loaded));
  let show = (prog) => {
    let (ignored21, phrases) = Translate.module(prog);
    let (ds, es) = Translate.parts(phrases);
    List.append(
      SmlList.map(Print.dec)(Normalize.decs(ds)),
      SmlList.map((e) => { Print.exp(Normalize.exp(e)) })(es)
    )
  };
  let check = (path, ignored22, prog, ignored23) => {
    match(SmlList.find((p, ignored24, ignored25, ignored26) => { p == path })(modules)) {
      None => { false },
      Some(m) => {
        match(Translate.recover(modules, m)) {
          Unify.Err(msg, ignored27) => { (eprint(path ++ ": round trip: " ++ msg ++ "\n"); false) },
          Unify.Ok((Var(ignored28), Var(ignored29), Var(actual), Var(ignored30)), ignored31) => {
            if (show(prog) == show(actual)) { true } else {
              (eprint(path ++ ": syntax changed in the round trip\n"); false)
            }
          }
        }
      }
    }
  };
  SmlList.all((ok) => { ok })(SmlList.map(check)(parsed))
};

/* Elaborates the files in order, each extending the environment, and reports the first
   error. */
let typeCheck = (parsed) => {
  match(Basis.initial) {
    Unify.Err(msg, ignored32) => {
      (eprint("internal error in the basis: " ++ msg ++ "\n"); false)
    },
    Unify.Ok(basis, ignored33) => {
      let rec go = match {
        (Var(ignored34), [], Var(ignored35)) => { true },
        (Var(env), [(Var(path), Var(src), Var(prog), Var(ignored36)), ..rest], Var(st)) => {
          match(Elab.program(env, prog, st)) {
            Unify.Ok(env', st') => { go(env', rest, st') },
            Unify.Err(msg, pos) => { (eprint(errorLine(path, src, msg, pos)); false) }
          }
        }
      };
      go(basis, parsed, Unify.initial)
    }
  }
};

let main = () => {
  let args = match(SubsetProcess.arguments()) {
    SubsetResult.Ok(values) => { values },
    SubsetResult.Err(error) => { fatal(SubsetIo.errorText(error)) }
  };
  match(args) {
    ["check", ..files] => { withParsed(files, typeCheck) },
    ["parse-only", ..files] => { withParsed(files, (ignored37) => { true }) },
    ["parse", ..files] => {
      withParsed(
        files,
        (parsed) => {
          (
            SmlList.app((ignored38, ignored39, prog, ignored40) => {
              SmlList.app((p) => { output(Print.topdec(p) ++ "\n") })(prog)
            })(parsed);
            true
          )
        }
      )
    },
    ["fmt", ..files] => {
      withParsed(
        files,
        (parsed) => {
          (
            SmlList.app((ignored41, src, prog, comments) => { output(Translate.toSml(src, prog, comments)) })(parsed);
            true
          )
        }
      )
    },
    ["wm", outDir, ..files] => { withParsed(files, (parsed) => { translate(outDir, parsed) }) },
    ["sml", outDir, ..files] => {
      if (SmlList.null(files)) { usage() } else { finish(fromWm(outDir, files)) }
    },
    ["roundtrip", ..files] => { withParsed(files, roundTrip) },
    Var(ignored42) => { usage() }
  }
};

let ignored43 = main();
