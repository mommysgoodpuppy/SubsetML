export from "./subset_option_value.wm" import *;

let eprint = (text) => {
  match(SubsetIo.writeStderr(CompilerText.characters(text))) {
    SubsetResult.Ok(result) => { result },
    SubsetResult.Err(error) => { SubsetProcess.exit(SubsetProcess.failure) }
  }
};
let fatal = (message) => {
  (eprint(message ++ "\n"); SubsetProcess.exit(SubsetProcess.failure))
};
let readFile = (path) => {
  match(SubsetIo.readFile(path)) {
    SubsetResult.Ok(bytes) => { CompilerText.stringOf(bytes) },
    SubsetResult.Err(error) => { fatal(path ++ ": " ++ SubsetIo.errorText(error)) }
  }
};
let writeFile = (path, text) => {
  match(SubsetIo.writeFile(CompilerText.characters(text), path)) {
    SubsetResult.Ok(result) => { result },
    SubsetResult.Err(error) => { fatal(path ++ ": " ++ SubsetIo.errorText(error)) }
  }
};
let output = (text) => {
  match(SubsetIo.writeStdout(CompilerText.characters(text))) {
    SubsetResult.Ok(result) => { result },
    SubsetResult.Err(error) => { fatal(SubsetIo.errorText(error)) }
  }
};

// 1-based line and column of a byte offset.
let lineCol = (src, offset) => {
  let rec go = (bytes, i, line, col) => {
    if (i >= offset) { (line, col) } else {
      match(bytes) {
        [] => { (line, col) },
        [c, ..rest] => {
          let newline = c == '\n';
          go(
            rest,
            i + 1,
            if (newline) { line + 1 } else { line },
            if (newline) { 1 } else { col + 1 }
          )
        }
      }
    }
  };
  go(CompilerText.characters(src), 0, 1, 1)
};

let errorLineKind = (path, src, kind, msg, pos) => {
  let (line, col) = lineCol(src, pos);
  path ++ ":" ++ CompilerText.natural(line) ++ ":" ++ CompilerText.natural(col) ++ ": " ++ kind ++ ": " ++ msg ++ "\n"
};

let errorLine = (path, src, msg, pos) => { errorLineKind(path, src, "error", msg, pos) };

type Parsed = | Parsed<String, String, List<Syntax.Topdec>, List<Syntax.Comment>>;

// Keep causes and source context until the CLI reporting boundary.
type SourceError =
  | ReadFailure<String, SubsetIo.Error>
  | LexFailure<String, String, String, Syntax.Pos>
  | ParseFailure<String, String, String, Syntax.Pos>;

let lexSource = (path, src) => {
  match(Lexer.lex(src)) {
    Lexer.LexError(msg, pos) => { SubsetResult.Err(LexFailure(path, src, msg, pos)) },
    Lexer.Tokens(tokens, comments) => { SubsetResult.Ok(path, src, tokens, comments) }
  }
};

let parseSource = (path, src, tokens, comments) => {
  match(Parser.parseTokens(tokens, comments)) {
    Parser.ParseError(msg, pos) => { SubsetResult.Err(ParseFailure(path, src, msg, pos)) },
    Parser.Program(phrases, comments) => { SubsetResult.Ok(Parsed(path, src, phrases, comments)) }
  }
};

// No reporting or exit inside the procedure; later transformations skip on Err.
let load = (path) => {
  let read = SubsetResult.viaErr((error) => { ReadFailure(path, error) })((file) => {
    SubsetResult.map(SubsetIo.readFile(file), (bytes) => { (file, CompilerText.stringOf(bytes)) })
  });
  let lex = SubsetResult.via(lexSource);
  let parse = SubsetResult.via(parseSource);

  let loaded = read(SubsetResult.Ok(path));
  let lexed = lex(loaded);
  parse(lexed)
};

let sourceErrorText = match {
  ReadFailure(path, error) => { path ++ ": " ++ SubsetIo.errorText(error) ++ "\n" },
  LexFailure(path, src, msg, pos) => { errorLineKind(path, src, "lex error", msg, pos) },
  ParseFailure(path, src, msg, pos) => { errorLineKind(path, src, "parse error", msg, pos) }
};

let usage = () => {
  (
    eprint("usage: subsetml (check-portable | check | parse | fmt | roundtrip) FILE...\n       subsetml native OUTDIR FILE.sml...\n       subsetml sml-target (mlton | mlworks) OUTDIR [--adapter CHECKER.sml NATIVE.sml]... FILE.sml...\n       subsetml wm OUTDIR FILE...\n       subsetml sml OUTDIR [--panic-runtime R.wm] FILE.wm...\n       subsetml sml-entry OUTDIR [--basis DIR] [--panic-runtime R.wm] [--native-adapter[-if-used] CHECKER.wm NATIVE.sml STRUCTURE]... ENTRY.wm\n");
    SubsetProcess.exit(SubsetProcess.failure)
  )
};

let finish = (ok) => {
  SubsetProcess.exit(if (ok) { SubsetProcess.success } else { SubsetProcess.failure })
};

// Runs `f` on every file once all of them have parsed.
let withParsed = (files, f) => {
  let loaded = SmlList.map(load)(files);
  let parsed = SmlList.concat(SmlList.map(match {
    SubsetResult.Ok(value) => {
      match(value) {
        Parsed(path, src, prog, comments) => { [(path, src, prog, comments)] }
      }
    },
    SubsetResult.Err(error) => { (eprint(sourceErrorText(error)); []) }
  })(loaded));
  if (SmlList.null(files)) { usage() } else {
    if (SubsetList.length32(parsed) == SubsetList.length32(files)) { finish(f(parsed)) } else { finish(false) }
  }
};

let translate = (outDir, parsed) => {
  let structures = SmlList.concat(SmlList.map((_, _, prog, _) => { Translate.structureOf(prog) })(parsed));
  let results = SmlList.map((path, src, prog, comments) => { Translate.toWm(structures, path, src, prog, comments) })(parsed);
  let errors = SmlList.concat(SmlList.map(match {
    Translate.TranslateError(e) => { [e] },
    Translate.Output(_, _, _) => { [] }
  })(results));
  let warn = ((path, src, _, _), result) => {
    match(result) {
      Translate.Output(_, _, warnings) => {
        SmlList.app((pos, msg) => { eprint(errorLineKind(path, src, "warning", msg, pos)) })(warnings)
      },
      Translate.TranslateError(_) => { void }
    }
  };
  match(errors) {
    [] => {
      (
        SmlList.app(match {
          Translate.Output(name, text, _) => { writeFile(outDir ++ "/" ++ name, text) },
          Translate.TranslateError(_) => { void }
        })(results);
        SmlListPair.app(warn)(parsed, results);
        true
      )
    },
    _ => {
      (SmlList.app((e) => { eprint("error: " ++ e ++ "\n") })(errors); false)
    }
  }
};

/* Reverse translation uses the same canonical resolver as SML metadata loading.
   Explicit source lists and entry discovery share preparation, resolution and checking. */
let fromWmLoaded = (outDir, basis, runtimePath, entryPath, adapterSpecs, sources) => {
  let keywordPrefix = Translate.keywordPrefix(sources);
  let rec traverse = (items, f) => {
    match(items) {
      [] => { SubsetResult.Ok([]) },
      [item, ..rest] => {
        SubsetResult.andThen(
          f(item),
          (value) => {
            SubsetResult.map(traverse(rest, f), (values) => { [value, ..values] })
          }
        )
      }
    }
  };
  let translate = (units, adapters) => {
    /* The selected runtime is the first canonical source. Its closure is checked first;
       resolution adds it as a private dependency only where the built-in is used. */
    let runtime = match(runtimePath, units) {
      (Some(_), [unit, .._]) => { Some(WmProject.name(unit)) },
      _ => { None }
    };
    let dependenciesOf = (name) => (planned) => {
      match(SubsetList.find(planned, (key, _, _) => { key == name })) {
        None => { [] },
        Some(_, dependencies, _) => { dependencies }
      }
    };
    let unitsNamed = (names) => {
      traverse(
        names,
        (name) => {
          match(SubsetList.find(units, (unit) => { WmProject.name(unit) == name })) {
            None => {
              WmProject.failure("translation", "", "missing runtime dependency " ++ name, 0)
            },
            Some(unit) => { SubsetResult.Ok(unit) }
          }
        }
      )
    };
    let parseGraph = (sources, layouts) => {
      let rec parse = (sources, scopes) => {
        match(sources) {
          [] => { SubsetResult.Ok([], []) },
          [WmProject.Source(unit, edges, aliases, tokens), ..rest] => {
            let owner = WmProject.name(unit);
            let path = WmProject.pathOf(unit);
            let src = WmProject.textOf(unit);
            let (values, types, namespaces) = WmProject.defaultScope(basis, units, unit);
            let records = WmScope.recordResolver(owner, scopes, types, namespaces, tokens);
            match(WmParse.parseModuleRecordScope(layouts, owner, src, tokens, keywordPrefix, records)) {
              WmParse.ParseError(message, pos) => { WmProject.failure(path, src, message, pos) },
              WmParse.Module(ds, es, cs) => {
                let errors = SubsetList.map(
                  WmScope.projectionErrors(scopes, ds),
                  (p, message) => { (Translate.located(path, message), p) }
                );
                let (ds, scope) = WmScope.resolve(owner, values, types, namespaces, scopes, ds);
                let scope = WmScope.exported(scope, aliases);
                let WmScope.Scope(_, _, names) = scope;
                let aliases = SubsetList.map(names, (alias, path) => { (0, alias, SubsetString.concatWith(path, ".")) });
                let program = [
                  Syntax.TopDecs([Syntax.SStructure(0, [(owner, aliases, ds)])]),
                  ..SubsetList.map(es, (e) => { Syntax.TopExp(0, e) })
                ];
                SubsetResult.andThen(
                  WmProject.imported(units, unit, edges),
                  (dependencies) => {
                    SubsetResult.map(
                      parse(rest, [(owner, scope), ..scopes]),
                      (rest, moreErrors) => {
                        (
                          [
                            (owner, SubsetList.map(dependencies, WmProject.name), (path, src, program, cs)),
                            ..rest
                          ],
                          SubsetList.append(errors, moreErrors)
                        )
                      }
                    )
                  }
                )
              }
            }
          }
        }
      };
      parse(sources, [])
    };
    SubsetResult.andThen(
      traverse(units, (unit) => { WmProject.prepare(basis, units, unit) }),
      (prepared) => {
        SubsetResult.andThen(
          WmProject.order(prepared),
          (ordered) => {
            let declarations = traverse(
              ordered,
              match {
                WmProject.Source(unit, _, _, tokens) => {
                  match(WmParse.recordLayoutsTokens(WmProject.name(unit), WmProject.textOf(unit), tokens)) {
                    WmParse.Done(layouts, _) => { SubsetResult.Ok(layouts) },
                    WmParse.Fail(message, pos) => {
                      WmProject.failure(WmProject.pathOf(unit), WmProject.textOf(unit), message, pos)
                    }
                  }
                }
              }
            );
            SubsetResult.andThen(
              declarations,
              (groups) => {
                SubsetResult.andThen(
                  parseGraph(ordered, SmlList.concat(groups)),
                  (modules, projectionErrors) => {
                    let libraries = match(basis) {
                      None => { [] },
                      Some(directory) => {
                        SubsetList.map(
                          SubsetList.filter(units, (u) => { WmProject.inside(directory ++ "/std", WmProject.pathOf(u)) }),
                          WmProject.name
                        )
                      }
                    };
                    let modules = WmScope.pruneLibraries(libraries, modules);
                    let modules = SubsetList.map(
                      modules,
                      (owner, deps, (path, src, prog, cs)) => {
                        let source = SubsetList.find(ordered, (source) => { WmProject.name(WmProject.sourceUnit(source)) == owner });
                        let unit = SubsetList.find(units, (u) => { WmProject.name(u) == owner });
                        let types = match(unit) {
                          None => { [] },
                          Some(unit) => {
                            let (_, types, _) = WmProject.defaultScope(basis, units, unit);
                            SubsetList.concat(SubsetList.map(
                              types,
                              (_, (qs, _)) => {
                                match(qs) {
                                  [n] => { [n] },
                                  _ => { [] }
                                }
                              }
                            ))
                          }
                        };
                        let referenced = WmScope.moduleReferences(prog);
                        let explicit = (target) => {
                          match(source) {
                            None => { true },
                            Some(source) => {
                              SubsetList.exists(
                                WmProject.edgesOf(source),
                                (edge) => {
                                  let WmProject.Edge(_, _, _, id) = edge;
                                  if (SubsetList.exists(
                                    units,
                                    (u) => {
                                      if (WmProject.name(u) == target) { ModuleProject.same(WmProject.identity(u), id) } else { false }
                                    }
                                  )) {
                                    SubsetBool.not(WmProject.isDefaultEdge(WmProject.sourceUnit(source), edge))
                                  } else { false }
                                }
                              )
                            }
                          }
                        };
                        let deps = SubsetList.filter(
                          deps,
                          (n) => {
                            if (if (explicit(n)) { true } else { WmScope.member(referenced, n) }) { true } else { WmScope.member(types, n) }
                          }
                        );
                        /* Constructor projections can refer directly to an ancestor's datatype.
                           Those references need the same canonical private build dependency. */
                        let deps = SubsetList.foldLeft(
                          referenced,
                          deps,
                          (n, found) => {
                            if (if (if (n == owner) { true } else { WmScope.member(found, n) }) { true } else {
                              SubsetBool.not(SubsetList.exists(units, (u) => { WmProject.name(u) == n }))
                            }) { found } else { SubsetList.append(found, [n]) }
                          }
                        );
                        (owner, deps, (path, src, prog, cs))
                      }
                    );
                    let roots = match(entryPath) {
                      None => { SubsetList.map(modules, (owner, _, _) => { owner }) },
                      Some(entry) => {
                        SubsetList.map(
                          SubsetList.filter(
                            units,
                            (u) => {
                              if (match(WmProject.canonical(entry)) {
                                Some(path) => { WmProject.pathOf(u) == path },
                                None => { false }
                              }) { true } else {
                                match(runtime) {
                                  Some(n) => { n == WmProject.name(u) },
                                  None => { false }
                                }
                              }
                            }
                          ),
                          WmProject.name
                        )
                      }
                    };
                    let rec reachable = (todo, seen) => {
                      match(todo) {
                        [] => { seen },
                        [n, ..rest] => {
                          if (WmScope.member(seen, n)) { reachable(rest, seen) } else {
                            reachable(SubsetList.append(dependenciesOf(n)(modules), rest), [n, ..seen])
                          }
                        }
                      }
                    };
                    let used = reachable(roots, []);
                    let modules = SubsetList.filter(modules, (owner, _, _) => { WmScope.member(used, owner) });
                    let ordered = SubsetList.filter(
                      ordered,
                      (source) => {
                        WmScope.member(used, WmProject.name(WmProject.sourceUnit(source)))
                      }
                    );
                    let (renamed, names) = BackendNames.projectWithRuntime(runtime, keywordPrefix, modules);
                    let checked = match(projectionErrors) {
                      [(Var(message), Var(pos)), .._] => { Unify.Err(message, pos) },
                      [] => {
                        match(BackendNames.failure(names)) {
                          None => { Translate.recoverProjectWithRuntime(runtime, renamed) },
                          Some(_, pos, message) => { Unify.Err(message, pos) }
                        }
                      }
                    };
                    match(checked) {
                      Unify.Err(message, pos) => {
                        match(Translate.unlocated(message)) {
                          Some(path, message) => {
                            match(SmlList.find((unit) => { WmProject.pathOf(unit) == path })(units)) {
                              Some(unit) => {
                                WmProject.failure(path, WmProject.textOf(unit), BackendNames.diagnostic(names, message), pos)
                              },
                              None => {
                                WmProject.failure(path, "", BackendNames.diagnostic(names, message), pos)
                              }
                            }
                          },
                          None => {
                            WmProject.failure("translation", "", BackendNames.diagnostic(names, message), pos)
                          }
                        }
                      },
                      Unify.Ok(recovered, _) => {
                        SubsetResult.andThen(
                          traverse(
                            SmlListPair.zip(ordered, recovered),
                            match {
                              (WmProject.Source(unit, _, _, _), (_, Var(src), Var(prog), Var(cs))) => {
                                SubsetResult.map(
                                  unitsNamed(dependenciesOf(WmProject.name(unit))(renamed)),
                                  (dependencies) => {
                                    let (_, phrases) = Translate.module(prog);
                                    let (ds, es) = Translate.parts(phrases);
                                    (
                                      outDir ++ "/" ++ WmProject.output(unit),
                                      WmProject.metadata(dependencies) ++ Translate.fromWmNamed(WmProject.name(unit), Translate.structureAliases(prog), src, ds, es, cs)
                                    )
                                  }
                                )
                              }
                            }
                          ),
                          (results) => {
                            match(entryPath) {
                              None => { SubsetResult.Ok(results) },
                              Some(path) => {
                                match(ModuleProject.identify(path)) {
                                  SubsetResult.Err(error) => { WmProject.failure(path, "", SubsetIo.errorText(error), 0) },
                                  SubsetResult.Ok(ModuleProject.Resolved(id, _)) => {
                                    match(SubsetList.find(units, (unit) => { ModuleProject.same(WmProject.identity(unit), id) })) {
                                      None => { WmProject.failure(path, "", "missing build entry", 0) },
                                      Some(entry) => {
                                        let runsMain = SubsetList.exists(
                                          SmlListPair.zip(ordered, recovered),
                                          match {
                                            (WmProject.Source(unit, _, _, _), (_, _, Var(prog), _)) => {
                                              if (ModuleProject.same(WmProject.identity(unit), WmProject.identity(entry))) {
                                                let (_, phrases) = Translate.module(prog);
                                                let (ds, _) = Translate.parts(phrases);
                                                WmProject.declaresMain(ds)
                                              } else { false }
                                            }
                                          }
                                        );
                                        let runner = if (runsMain) {
                                          [(outDir ++ "/" ++ WmProject.mainFile, WmProject.mainCall(entry))]
                                        } else { [] };
                                        SubsetResult.map(
                                          WmProject.mlb(units, ordered, renamed, entry, adapters, runsMain),
                                          (text) => {
                                            SubsetList.append(results, SubsetList.append(runner, [(outDir ++ "/project.mlb", text)]))
                                          }
                                        )
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        )
                      }
                    }
                  }
                )
              }
            )
          }
        )
      }
    )
  };
  match(SubsetResult.andThen(
    WmProject.plan(sources),
    (units) => {
      SubsetResult.andThen(
        WmProject.adapters(units, adapterSpecs),
        (adapters) => { translate(units, adapters) }
      )
    }
  )) {
    SubsetResult.Err(WmProject.Error(path, src, message, pos)) => { (eprint(errorLine(path, src, message, pos)); false) },
    SubsetResult.Ok(results) => { (SmlList.app(writeFile)(results); true) }
  }
};

let fromWm = (outDir, runtimePath, files) => {
  fromWmLoaded(
    outDir,
    None,
    runtimePath,
    None,
    [],
    SmlList.map((path) => { (path, readFile(path)) })(match(runtimePath) {
      None => { files },
      Some(path) => { [path, ..files] }
    })
  )
};

/* Whether any discovered module spells `Panic`. A shadowing binding still counts; the runtime
   is then only an unused dependency. */
let mentionsPanic = (sources) => {
  SmlList.exists((_, src) => {
    match(WmLexer.lex(src)) {
      WmLexer.Tokens(tokens, _) => {
        SmlList.exists((token, _) => { token == WmLexer.WName(["Panic"]) })(tokens)
      },
      WmLexer.LexError(_) => { false }
    }
  })(sources)
};

let fromWmEntry = (outDir, basis, runtimePath, adapterSpecs, entry) => {
  let report = match {
    WmProject.Error(path, src, message, pos) => { (eprint(errorLine(path, src, message, pos)); false) }
  };
  /* With --basis, the Basis process module is the default Panic runtime, but only for a
     graph that uses Panic: the runtime brings its host adapter with it. */
  let defaultRuntime = (sources) => {
    match(basis) {
      None => { None },
      Some(directory) => {
        if (mentionsPanic(sources)) {
          match(ModuleProject.identify(directory ++ "/subset_process.wm")) {
            SubsetResult.Ok(_) => { Some(directory ++ "/subset_process.wm") },
            SubsetResult.Err(_) => { None }
          }
        } else { None }
      }
    }
  };
  let withRuntime = (runtime) => {
    match(WmProject.discover(basis, [runtime, entry])) {
      SubsetResult.Err(error) => { report(error) },
      SubsetResult.Ok(sources) => {
        fromWmLoaded(outDir, basis, Some(runtime), Some(entry), adapterSpecs, sources)
      }
    }
  };
  match(runtimePath) {
    Some(runtime) => { withRuntime(runtime) },
    None => {
      match(WmProject.discover(basis, [entry])) {
        SubsetResult.Err(error) => { report(error) },
        SubsetResult.Ok(sources) => {
          match(defaultRuntime(sources)) {
            Some(runtime) => { withRuntime(runtime) },
            None => {
              fromWmLoaded(outDir, basis, None, Some(entry), adapterSpecs, sources)
            }
          }
        }
      }
    }
  }
};

// SML -> Workman -> SML must give back the same declarations, up to Normalize.
let roundTrip = (parsed) => {
  let structures = SmlList.concat(SmlList.map((_, _, prog, _) => { Translate.structureOf(prog) })(parsed));
  let loaded = SmlList.map((path, src, prog, comments) => {
    match(Translate.toWm(structures, path, src, prog, comments)) {
      Translate.TranslateError(msg) => { (eprint(msg ++ "\n"); None) },
      Translate.Output(name, text, _) => {
        match(WmParse.parseModule(text)) {
          WmParse.ParseError(msg, pos) => { (eprint(errorLine(path, text, msg, pos)); None) },
          WmParse.Module(ds, es, cs) => {
            Some(
              path,
              text,
              [
                Syntax.TopDecs([
                  Syntax.SStructure(0, [(WmParse.structureName(name), WmParse.structureAliases(text), ds)])
                ]),
                ..SmlList.map((e) => { Syntax.TopExp(0, e) })(es)
              ],
              cs
            )
          }
        }
      }
    }
  })(parsed);
  let modules = SmlList.concat(SmlList.map(match {
    Some(m) => { [m] },
    None => { [] }
  })(loaded));
  let show = (prog) => {
    let (_, phrases) = Translate.module(prog);
    let (ds, es) = Translate.parts(phrases);
    SubsetList.append(
      SmlList.map((_, name, target) => { name ++ " = " ++ target })(Translate.structureAliases(prog)),
      SubsetList.append(
        SmlList.map(Print.dec)(Normalize.decs(ds)),
        SmlList.map((e) => { Print.exp(Normalize.exp(e)) })(es)
      )
    )
  };
  let check = (path, _, prog, _) => {
    match(SmlList.find((p, _, _, _) => { p == path })(modules)) {
      None => { false },
      Some(m) => {
        match(Translate.recover(modules, m)) {
          Unify.Err(msg, _) => { (eprint(path ++ ": round trip: " ++ msg ++ "\n"); false) },
          Unify.Ok((_, _, Var(actual), _), _) => {
            if (show(prog) == show(actual)) { true } else {
              (eprint(path ++ ": syntax changed in the round trip\n"); false)
            }
          }
        }
      }
    }
  };
  SmlList.all((ok) => { ok })(SmlList.map(check)(parsed))
};

/* Elaborates the files in order, each extending the environment, and reports the first
   error. */
let typeCheckWith = (initial, parsed) => {
  match(initial) {
    Unify.Err(msg, _) => {
      (eprint("internal error in the basis: " ++ msg ++ "\n"); false)
    },
    Unify.Ok(basis, _) => {
      let rec go = match {
        (_, [], _) => { true },
        (Var(env), [(Var(path), Var(src), Var(prog), _), ..rest], Var(st)) => {
          match(Elab.program(env, prog, st)) {
            Unify.Ok(env', st') => { go(env', rest, st') },
            Unify.Err(msg, pos) => { (eprint(errorLine(path, src, msg, pos)); false) }
          }
        }
      };
      go(basis, parsed, Unify.initial)
    }
  }
};

let typeCheck = (parsed) => { typeCheckWith(Basis.initial, parsed) };

/* An entry file has only its explicit import environment; legacy source lists remain
   available for bootstrap checking and ordinary SML compilation-unit order. */
let checkProjectWith = (initial, path) => {
  let source = (file) => {
    SubsetResult.map(
      load(file),
      match {
        Parsed(path, src, prog, comments) => { ModuleProject.Source(path, src, prog, comments) }
      }
    )
  };
  let checked = SubsetResult.andThen(
    ModuleProject.discover(path, source),
    (graph) => {
      match(initial) {
        Unify.Err(message, _) => {
          SubsetResult.Err(ModuleProject.CheckFailure(path, "", "internal error in the basis: " ++ message, 0))
        },
        Unify.Ok(basis, _) => { ModuleProject.check(graph, basis) }
      }
    }
  );
  let report = match {
    ModuleProject.LoadFailure(error) => { sourceErrorText(error) },
    ModuleProject.ResolutionFailure(path, error) => { path ++ ": " ++ SubsetIo.errorText(error) ++ "\n" },
    ModuleProject.ImportFailure(path, src, message, pos) => { errorLineKind(path, src, "import error", message, pos) },
    ModuleProject.CheckFailure(path, src, message, pos) => { errorLine(path, src, message, pos) }
  };
  match(checked) {
    SubsetResult.Ok(_) => { finish(true) },
    SubsetResult.Err(error) => { (eprint(report(error)); finish(false)) }
  }
};

let main = () => {
  let args = match(SubsetProcess.arguments()) {
    SubsetResult.Ok(values) => { values },
    SubsetResult.Err(error) => { fatal(SubsetIo.errorText(error)) }
  };
  match(args) {
    ["check-portable", file] => { checkProjectWith(Basis.portableInitial, file) },
    ["check-portable", ..files] => {
      withParsed(files, (parsed) => { typeCheckWith(Basis.portableInitial, parsed) })
    },
    ["check", file] => { checkProjectWith(Basis.initial, file) },
    ["check", ..files] => { withParsed(files, typeCheck) },
    ["parse-only", ..files] => { withParsed(files, (_) => { true }) },
    ["parse", ..files] => {
      withParsed(
        files,
        (parsed) => {
          (
            SmlList.app((_, _, prog, _) => {
              SmlList.app((p) => { output(Print.topdec(p) ++ "\n") })(prog)
            })(parsed);
            true
          )
        }
      )
    },
    ["fmt", ..files] => {
      withParsed(
        files,
        (parsed) => {
          (
            SmlList.app((_, src, prog, comments) => { output(Translate.toSml(src, prog, comments)) })(parsed);
            true
          )
        }
      )
    },
    ["native", outDir, ..files] => {
      withParsed(
        files,
        (parsed) => {
          match(NativeInt.emit(parsed)) {
            Unify.Err(message, pos) => { (eprint("native error: " ++ message ++ "\n"); false) },
            Unify.Ok(outputs, _) => {
              (
                SmlList.app((path, text) => { writeFile(outDir ++ "/" ++ NativeInt.basename(path), text) })(outputs);
                true
              )
            }
          }
        }
      )
    },
    ["sml-target", target, outDir, ..options] => {
      let rec parse = (remaining, adapters) => {
        match(remaining) {
          ["--adapter", checker, native, ..rest] => { parse(rest, [(checker, native), ..adapters]) },
          [] => { usage() },
          Var(files) => {
            withParsed(
              files,
              (parsed) => {
                match(SmlTarget.emit(target, SmlList.rev(adapters), parsed)) {
                  SubsetResult.Err(message) => { (eprint("SML target error: " ++ message ++ "\n"); false) },
                  SubsetResult.Ok(outputs) => {
                    (
                      SmlList.app((name, text) => { writeFile(outDir ++ "/" ++ name, text) })(outputs);
                      true
                    )
                  }
                }
              }
            )
          }
        }
      };
      parse(options, [])
    },
    ["wm", outDir, ..files] => { withParsed(files, (parsed) => { translate(outDir, parsed) }) },
    ["sml-entry", outDir, ..options] => {
      let rec parse = (remaining, basis, runtime, adapters) => {
        match(remaining) {
          [entry] => {
            finish(fromWmEntry(outDir, basis, runtime, SmlList.rev(adapters), entry))
          },
          ["--basis", directory, ..rest] => {
            match(basis) {
              None => { parse(rest, Some(directory), runtime, adapters) },
              Some(_) => { usage() }
            }
          },
          ["--panic-runtime", path, ..rest] => {
            match(runtime) {
              None => { parse(rest, basis, Some(path), adapters) },
              Some(_) => { usage() }
            }
          },
          ["--native-adapter", checker, native, exported, ..rest] => {
            parse(rest, basis, runtime, [(checker, native, exported, true), ..adapters])
          },
          ["--native-adapter-if-used", checker, native, exported, ..rest] => {
            parse(rest, basis, runtime, [(checker, native, exported, false), ..adapters])
          },
          _ => { usage() }
        }
      };
      parse(options, None, None, [])
    },
    ["sml", outDir, "--panic-runtime", runtime, ..files] => {
      if (SmlList.null(files)) { usage() } else { finish(fromWm(outDir, Some(runtime), files)) }
    },
    ["sml", outDir, ..files] => {
      if (SmlList.null(files)) { usage() } else { finish(fromWm(outDir, None, files)) }
    },
    ["roundtrip", ..files] => { withParsed(files, roundTrip) },
    _ => { usage() }
  }
};

let _ = main();
