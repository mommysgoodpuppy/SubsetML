/* Elaboration: the static semantics of the Core and of SubsetML's top-level structures
   (Definition §4, §5), plus the SubsetML restrictions that need types (spec §6, §7, §9).

   Errors stop elaboration: each function returns Unify.res. Declarations elaborate the right
   sides of `val` one level deeper than their context, so that the type variables left above
   the context's level at the end can be generalized (Unify). */

from "./subset_option_value.wm" import * as SubsetOptionValue;
from "./syntax.wm" import * as Syntax;
from "./types.wm" import * as Types;
from "./unify.wm" import * as Unify;
from "./env.wm" import * as Env;
from "./sml_list.wm" import * as SmlList;
from "./subset_string.wm" import * as SubsetString;
from "./subset_list.wm" import * as SubsetList;
from "./compiler_text.wm" import * as CompilerText;
from "./subset_bool.wm" import * as SubsetBool;
from "./sml_list_pair.wm" import * as SmlListPair;
from "./subset_result.wm" import * as SubsetResult;

export from "./subset_option_value.wm" import *;

export from "./syntax.wm" import *;
export from "./types.wm" import *;
export from "./unify.wm" import *;
export from "./env.wm" import *;

// The context: environment, level, and the explicit type variables in scope.
type Context = (Env, Int32.Int, List<String>);

let envOf = (env, _, _) => { env };
let scopedOf = (_, _, scoped) => { scoped };

// ---------------------------------------------------------------------------------------
// Helpers

let concatMap = (f, xs) => { SmlList.concat(SmlList.map(f)(xs)) };

let member = (x, xs) => { SmlList.exists((y) => { y == x })(xs) };

let memberInt = (x, xs) => { SmlList.exists((y) => { y == x })(xs) };

let longName = (qs, x) => { SubsetString.concatWith(SubsetList.append(qs, [x]), ".") };

// Folds a res-returning step over a list.
let rec foldRes = (f, acc, xs, st) => {
  match(xs) {
    [] => { Ok(acc, st) },
    [x, ..rest] => {
      bind(f(acc, x, st))((acc') => (st') => { foldRes(f, acc', rest, st') })
    }
  }
};

let mapRes = (f, xs, st) => {
  bind(foldRes(
    (acc, x, st) => {
      bind(f(x, st))((y) => (st) => { Ok(SubsetList.append(acc, [y]), st) })
    },
    [],
    xs,
    st
  ))((ys) => (st) => { Ok(ys, st) })
};

// The first source position inside a phrase, if any.
let rec patPos = (p) => {
  match(p) {
    PScon(q, _) => { Some(q) },
    PId(q, _) => { Some(q) },
    PPinned(q, _) => { Some(q) },
    PComputed(q, _) => { Some(q) },
    PRecord(q, _) => { Some(q) },
    PApp(q, _, _) => { Some(q) },
    PTuple(ps) => {
      SmlList.foldl((x, acc) => {
        match(acc) {
          Some(_) => { acc },
          None => { patPos(x) }
        }
      })(None)(ps)
    },
    PList(ps) => {
      SmlList.foldl((x, acc) => {
        match(acc) {
          Some(_) => { acc },
          None => { patPos(x) }
        }
      })(None)(ps)
    },
    PTyped(q, _) => { patPos(q) },
    PWild => { None }
  }
};

let rec expPos = (e) => {
  let first = (es) => {
    SmlList.foldl((x, acc) => {
      match(acc) {
        Some(_) => { acc },
        None => { expPos(x) }
      }
    })(None)(es)
  };
  match(e) {
    EScon(q, _) => { Some(q) },
    EId(q, _) => { Some(q) },
    ERecord(q, _) => { Some(q) },
    ESelect(q, _) => { Some(q) },
    ECopy(q, _, _, _) => { Some(q) },
    ETuple(es) => { first(es) },
    EList(es) => { first(es) },
    ESeq(es) => { first(es) },
    ELet(_, es) => { first(es) },
    EApp(f, a) => { first([f, a]) },
    ETyped(x, _) => { expPos(x) },
    EAndalso(a, b) => { first([a, b]) },
    EOrelse(a, b) => { first([a, b]) },
    EIf(c, a, b) => { first([c, a, b]) },
    ECase(x, _) => { expPos(x) },
    EFn(rules) => {
      match(rules) {
        [(Var(p), Var(x)), .._] => {
          match(patPos(p)) {
            Some(q) => { Some(q) },
            None => { expPos(x) }
          }
        },
        [] => { None }
      }
    }
  }
};

let at = (fallback, found) => {
  match(found) {
    Some(q) => { q },
    None => { fallback }
  }
};

// Unifies, or reports `what` with both types.
let unifyAt = (st, pos, what, expected, found) => {
  match(unify(st, expected, found)) {
    Unified(st') => { Ok(void, st') },
    Mismatch(reason) => {
      match(showAll(st, [expected, found])) {
        [e, f] => {
          Err(
            what ++ ": expected " ++ e ++ ", found " ++ f ++ (if (reason == "") { "" } else { " (" ++ reason ++ ")" }),
            pos
          )
        },
        _ => { Err(what, pos) }
      }
    }
  }
};

// ---------------------------------------------------------------------------------------
// Type expressions. `tyvar` resolves explicit type variables.

let rec elabTy = (env, tyvar, pos, t, st) => {
  match(t) {
    TyVar(v) => {
      match(tyvar(v)) {
        Some(t') => { Ok(t', st) },
        None => { Err("unbound type variable " ++ v, pos) }
      }
    },
    TyCon(args, id) => {
      match(Env.tycon(env, id)) {
        None => { Err("unbound type constructor " ++ longName(id), pos) },
        Some(TyStr(arity, body, _)) => {
          if (arity != SubsetList.length32(args)) {
            Err(
              "type constructor " ++ longName(id) ++ " takes " ++ CompilerText.natural(arity) ++ " argument(s), given " ++ CompilerText.natural(SubsetList.length32(args)),
              pos
            )
          } else {
            bind(mapRes((a, st) => { elabTy(env, tyvar, pos, a, st) }, args, st))((args') => (st) => { Ok(substGen(args', body), st) })
          }
        }
      }
    },
    TyTuple(ts) => {
      bind(mapRes((a, st) => { elabTy(env, tyvar, pos, a, st) }, ts, st))((ts') => (st) => { Ok(tupleTy(ts'), st) })
    },
    TyArrow(a, b) => {
      bind(elabTy(env, tyvar, pos, a, st))((a') => (st) => {
        bind(elabTy(env, tyvar, pos, b, st))((b') => (st) => { Ok(TArrow(a', b'), st) })
      })
    },
    TyRecord(fields) => {
      bind(mapRes(
        ((l, a), st) => {
          bind(elabTy(env, tyvar, pos, a, st))((a') => (st) => { Ok((l, a'), st) })
        },
        fields,
        st
      ))((fields') => (st) => { Ok(TRecord(sortFields(fields')), st) })
    }
  }
};

// An explicit type variable in scope stands for itself.
let scopedTy = ((env, _, scoped), pos, t, st) => {
  elabTy(
    env,
    (v) => { if (member(v, scoped)) { Some(TRigid(v)) } else { None } },
    pos,
    t,
    st
  )
};

// ---------------------------------------------------------------------------------------
/* Explicit type variables occurring unguarded in a value declaration (Definition §4.6):
   those in its annotations, not counting nested value declarations. */

let rec tyVarsOf = (t) => {
  match(t) {
    TyVar(v) => { [v] },
    TyCon(args, _) => { concatMap(tyVarsOf, args) },
    TyTuple(ts) => { concatMap(tyVarsOf, ts) },
    TyArrow(a, b) => { SubsetList.append(tyVarsOf(a), tyVarsOf(b)) },
    TyRecord(fields) => { concatMap((_, a) => { tyVarsOf(a) }, fields) }
  }
};

let rec patTyVars = (p) => {
  match(p) {
    PRecord(_, fields) => { concatMap((_, q) => { patTyVars(q) }, fields) },
    PTuple(ps) => { concatMap(patTyVars, ps) },
    PList(ps) => { concatMap(patTyVars, ps) },
    PApp(_, _, q) => { patTyVars(q) },
    PTyped(q, t) => { SubsetList.append(patTyVars(q), tyVarsOf(t)) },
    _ => { [] }
  }
};

let rec expTyVars = (e) => {
  match(e) {
    ERecord(_, fields) => { concatMap((_, x) => { expTyVars(x) }, fields) },
    ETuple(es) => { concatMap(expTyVars, es) },
    EList(es) => { concatMap(expTyVars, es) },
    ESeq(es) => { concatMap(expTyVars, es) },
    ELet(_, es) => { concatMap(expTyVars, es) },
    EApp(f, a) => { SubsetList.append(expTyVars(f), expTyVars(a)) },
    ETyped(x, t) => { SubsetList.append(expTyVars(x), tyVarsOf(t)) },
    EAndalso(a, b) => { SubsetList.append(expTyVars(a), expTyVars(b)) },
    EOrelse(a, b) => { SubsetList.append(expTyVars(a), expTyVars(b)) },
    EIf(c, a, b) => {
      SubsetList.concat([expTyVars(c), expTyVars(a), expTyVars(b)])
    },
    ECase(x, rules) => {
      SubsetList.append(
        expTyVars(x),
        concatMap((p, y) => { SubsetList.append(patTyVars(p), expTyVars(y)) }, rules)
      )
    },
    EFn(rules) => {
      concatMap((p, y) => { SubsetList.append(patTyVars(p), expTyVars(y)) }, rules)
    },
    ECopy(_, source, _, _) => { expTyVars(source) },
    _ => { [] }
  }
};

let distinct = (xs) => {
  SmlList.foldl((x, acc) => {
    if (member(x, acc)) { acc } else { SubsetList.append(acc, [x]) }
  })([])(xs)
};

// ---------------------------------------------------------------------------------------
// SubsetML restrictions

/* Spec B1: the full Basis binds these as constructors; SubsetML leaves them out, so binding
   them as variables would give a program SML reads differently. */
let omittedConstructors = [
  "ref",
  "Match",
  "Bind",
  "Chr",
  "Div",
  "Domain",
  "Empty",
  "Fail",
  "Option",
  "Overflow",
  "Size",
  "Span",
  "Subscript",
  "Io"
];

// The Definition (§2.9) forbids binding these.
let unbindable = ["true", "false", "nil", "::", "ref"];

// Spec R3: a record's labels must be those of a record type declaration in scope.
let checkRecordLabels = (env, pos, labels, st) => {
  let sorted = SmlList.map((l, _) => { l })(sortFields(SmlList.map((l) => { (l, void) })(labels)));
  if (SmlList.exists((set) => { set == sorted })(recordLabelSets(env))) { Ok(void, st) } else {
    Err(
      "no record type with the labels {" ++ SubsetString.concatWith(sorted, ", ") ++ "} is in scope; SubsetML records must have a declared type (spec R3)",
      pos
    )
  }
};

// ---------------------------------------------------------------------------------------
// Patterns: their type and the variables they bind.

let constTy = match {
  SInt(_) => { intTy },
  SWord(_) => { intTy },
  SReal(_) => { realTy },
  SString(_) => { stringTy },
  SChar(_) => { charTy }
};

/* Appendix E: an integer constant is int or Int64.int by context and defaults to int; beyond
   the int range only Int64.int remains. A word constant is one of the word types; SubsetML
   has no `word` type to default to, so context must decide it. */
let checkConst = (pos, c, level, st) => {
  match(c) {
    SInt(text) => {
      if (CompilerText.int32Literal(text)) { Ok(fresh(st, KClass([intName, int64Name]), level)) } else {
        if (CompilerText.int64Literal(text)) { Ok(fresh(st, KClass([int64Name]), level)) } else {
          Err("integer constant outside signed 64-bit range: " ++ text, pos)
        }
      }
    },
    SWord(_) => {
      let (t, st') = fresh(st, KClass(wordNames), level);
      Ok(t, st')
    },
    SReal(_) => {
      let (t, st') = fresh(st, KClass([realName, real32Name]), level);
      Ok(t, st')
    },
    _ => { Ok(constTy(c), st) }
  }
};

let mergeVars = (pos, a, b, st) => {
  match(SmlList.find((x, _) => { SmlList.exists((y, _) => { x == y })(a) })(b)) {
    Some(entry) => {
      let (x, _) = entry;
      Err("variable " ++ x ++ " is bound twice in a pattern", pos)
    },
    None => { Ok(SubsetList.append(a, b), st) }
  }
};

/* A constant in an expression or pattern. Read from Workman, an in-range integer literal takes
   any numeric type by context and a larger one any but int, and a decimal literal real or
   Real32.real; the site is recorded, since Workman's own default decides it. */
let literalConst = (q, c, level, inPattern, st) => {
  match(c, st) {
    (SInt(text), State(_, _, _, _, Some(_))) => {
      // A real constant is no pattern (SML's real does not admit equality).
      let numeric = SubsetList.append(
        if (inPattern) { [intName, int64Name] } else { [intName, int64Name, realName, real32Name] },
        wordNames
      );
      let (t, st') = if (CompilerText.int32Literal(text)) { fresh(st, KClass(numeric), level) } else {
        fresh(
          st,
          KClass(SmlList.filter((n) => { SubsetBool.not(sameName(n, intName)) })(numeric)),
          level
        )
      };
      let State(vs, nx, sels, recs, sites) = st';
      Ok(
        t,
        State(
          vs,
          nx,
          sels,
          recs,
          Some([
            Literal(q, t),
            ..match(sites) {
              Some(xs) => { xs },
              None => { [] }
            }
          ])
        )
      )
    },
    (SReal(_), State(_, _, _, _, Some(_))) => {
      let (t, st') = fresh(st, KClass([realName, real32Name]), level);
      let State(vs, nx, sels, recs, sites) = st';
      Ok(
        t,
        State(
          vs,
          nx,
          sels,
          recs,
          Some([
            Literal(q, t),
            ..match(sites) {
              Some(xs) => { xs },
              None => { [] }
            }
          ])
        )
      )
    },
    _ => { checkConst(q, c, level, st) }
  }
};

let constructorScheme = (entry) => {
  match(entry) {
    None => { None },
    Some(value) => {
      let (scheme, status) = value;
      match(status) {
        SCon => { Some(scheme) },
        SValue => { None }
      }
    }
  }
};

let rec pat = (ctx, p, st) => {
  let (env, level, _) = ctx;
  match(p) {
    PWild => {
      let (t, st') = fresh(st, KPlain, level);
      Ok((t, []), st')
    },
    PScon(q, c) => {
      bind(literalConst(q, c, level, true, st))((t) => (st) => { Ok((t, []), st) })
    },
    PPinned(q, _) => { Err("internal pinned pattern was not lowered", q) },
    PComputed(q, _) => { Err("internal computed pattern was not lowered", q) },
    PId(q, id) => {
      match(constructorScheme(Env.value(env, id)), id) {
        (Some(scheme), _) => {
          let (t, st') = instantiate(st, level, scheme);
          match(prune(st', t)) {
            TArrow(_, _) => {
              Err("constructor " ++ longName(id) ++ " needs an argument", q)
            },
            _ => { Ok((t, []), st') }
          }
        },
        (_, ([], Var(x))) => {
          if (member(x, omittedConstructors)) {
            Err(
              "`" ++ x ++ "` is a constructor in the SML Basis, which SubsetML omits; it cannot be " ++ "bound as a variable (spec B1)",
              q
            )
          } else {
            let (t, st') = fresh(st, KPlain, level);
            Ok((t, [(x, t)]), st')
          }
        },
        _ => { Err("unbound constructor " ++ longName(id), q) }
      }
    },
    PRecord(q, fields) => {
      bind(checkRecordLabels(env, q, SmlList.map((l, _) => { l })(fields), st))((_) => (st) => {
        bind(foldRes(
          ((fs, vars), (l, f), st) => {
            bind(pat(ctx, f, st))((t, vs) => (st) => {
              bind(mergeVars(q, vars, vs, st))((vars') => (st) => { Ok((SubsetList.append(fs, [(l, t)]), vars'), st) })
            })
          },
          ([], []),
          fields,
          st
        ))((fs, vars) => (st) => { Ok((TRecord(sortFields(fs)), vars), st) })
      })
    },
    PTuple(ps) => {
      bind(pats(ctx, at(0, patPos(p)), ps, st))((ts, vars) => (st) => {
        Ok((if (SmlList.null(ts)) { unitTy } else { tupleTy(ts) }, vars), st)
      })
    },
    PList(ps) => {
      let (elem, st0) = fresh(st, KPlain, level);
      bind(pats(ctx, at(0, patPos(p)), ps, st0))((ts, vars) => (st) => {
        bind(foldRes(
          (_, (t, x), st) => {
            unifyAt(st, at(0, patPos(x)), "list pattern element", elem, t)
          },
          void,
          SmlListPair.zip(ts, ps),
          st
        ))((_) => (st) => { Ok((listTy(elem), vars), st) })
      })
    },
    PApp(q, id, arg) => {
      match(constructorScheme(Env.value(env, id))) {
        Some(scheme) => {
          let (t, st') = instantiate(st, level, scheme);
          match(prune(st', t)) {
            TArrow(dom, cod) => {
              bind(pat(ctx, arg, st'))((ta, vars) => (st) => {
                bind(unifyAt(st, at(q, patPos(arg)), "argument of constructor " ++ longName(id), dom, ta))((_) => (st) => { Ok((cod, vars), st) })
              })
            },
            _ => {
              Err("constructor " ++ longName(id) ++ " takes no argument", q)
            }
          }
        },
        _ => { Err("`" ++ longName(id) ++ "` is not a constructor", q) }
      }
    },
    PTyped(PRecord(q, fields), t) => {
      /* Reading Workman, a record pattern annotated with a record type may name only some
         of its fields; the others match anything. SubsetML writes every label (R3). */
      bind(scopedTy(ctx, at(0, Some(q)), t, st))((annotated) => (st) => {
        let named = SmlList.map((l, _) => { l })(fields);
        let missing = match(st, resolve(st, annotated)) {
          (State(_, _, _, _, Some(_)), TRecord(declared)) => {
            let labels = SmlList.map((l, _) => { l })(declared);
            if (SmlList.all((l) => { SmlList.exists((m) => { m == l })(labels) })(named)) {
              SmlList.filter((l) => { SubsetBool.not(SmlList.exists((m) => { m == l })(named)) })(labels)
            } else { [] }
          },
          _ => { [] }
        };
        match(missing) {
          [] => { typedPat(ctx, PRecord(q, fields), t, st) },
          _ => {
            let st = match(st) {
              State(vs, nx, sels, rs, Some(xs)) => {
                State(vs, nx, sels, rs, Some([PatternRecord(q, missing), ..xs]))
              },
              _ => { st }
            };
            typedPat(
              ctx,
              PRecord(q, SubsetList.append(fields, SmlList.map((l) => { (l, PWild) })(missing))),
              t,
              st
            )
          }
        }
      })
    },
    PTyped(inner, t) => { typedPat(ctx, inner, t, st) }
  }
}

and typedPat = (ctx, inner, t, st) => {
  let (env, level, _) = ctx;
  bind(pat(ctx, inner, st))((ti, vars) => (st) => {
    bind(scopedTy(ctx, at(0, patPos(inner)), t, st))((t') => (st) => {
      bind(unifyAt(st, at(0, patPos(inner)), "type annotation", t', ti))((_) => (st) => { Ok((t', vars), st) })
    })
  })
}

and pats = (ctx, pos, ps, st) => {
  foldRes(
    ((ts, vars), p, st) => {
      bind(pat(ctx, p, st))((t, vs) => (st) => {
        bind(mergeVars(at(pos, patPos(p)), vars, vs, st))((vars') => (st) => { Ok((SubsetList.append(ts, [t]), vars'), st) })
      })
    },
    ([], []),
    ps,
    st
  )
};

// ---------------------------------------------------------------------------------------
// Non-expansive expressions (Definition §4.7), which may be generalized.

let rec nonExpansive = (env, e) => {
  match(e) {
    EScon(_, _) => { true },
    EId(_, _) => { true },
    EFn(_) => { true },
    ESelect(_, _) => { true },
    ERecord(_, fields) => { SmlList.all((_, x) => { nonExpansive(env, x) })(fields) },
    ETuple(es) => { SmlList.all((x) => { nonExpansive(env, x) })(es) },
    EList(es) => { SmlList.all((x) => { nonExpansive(env, x) })(es) },
    ETyped(x, _) => { nonExpansive(env, x) },
    EApp(EId(_, id), arg) => {
      match(constructorScheme(Env.value(env, id))) {
        Some(_) => { nonExpansive(env, arg) },
        _ => { false }
      }
    },
    _ => { false }
  }
};

// ---------------------------------------------------------------------------------------
// Expressions

let rec exp = (ctx, e, st) => {
  let (env, level, _) = ctx;
  match(e) {
    EScon(q, c) => { literalConst(q, c, level, false, st) },
    /* A backtick string's `${ e }`, read from Workman: the value's text, resolved by type during
       translation (Translate.templateText). */
    EId(q, ([], "`show")) => {
      /* With the SubsetML Basis a value shows as `print` shows it; without, SML has text only
         for the primitive types. */
      let kind = match(Env.structureAt(env, ["SubsetList"])) {
        Some(_) => { KPlain },
        None => {
          KClass([stringName, charName, intName, int64Name, realName, boolName])
        }
      };
      let (a, st') = fresh(st, kind, level);
      let t = TArrow(a, stringTy);
      let State(vs, nx, sels, recs, sites) = st';
      match(sites) {
        Some(xs) => {
          Ok(t, State(vs, nx, sels, recs, Some([Operand(q, t), ..xs])))
        },
        // The target check: a marker translation left has a type with no display.
        None => {
          Err(
            "the type of a value in a backtick string's ${ } or `Text.of` is undecided in part, or has no " ++ "portable display; annotate it, or show text, numbers, booleans, characters, void, " ++ "tuples, lists, records, Option, Result or datatypes",
            q
          )
        }
      }
    },
    /* Workman's `print`, read from Workman: any value, shown by type during translation
       (Translate.printing). A marker left in place has a type with no portable display. */
    /* Workman's `!`, read from Workman: SubsetBool.not, or SML's `not` without the Basis
       (Translate.portableSpellings). */
    EId(q, ([], "`not")) => { Ok(TArrow(boolTy, boolTy), st) },
    // Without the SubsetML Basis there is no portable display: `print` is SML's, on text.
    EId(q, ([], "`print")) => {
      match(Env.structureAt(env, ["SubsetIo"])) {
        None => { Ok(TArrow(stringTy, unitTy), st) },
        Some(_) => {
          let (a, st') = fresh(st, KPlain, level);
          let t = TArrow(a, unitTy);
          let State(vs, nx, sels, recs, sites) = st';
          match(sites) {
            Some(xs) => {
              Ok(t, State(vs, nx, sels, recs, Some([Operand(q, t), ..xs])))
            },
            None => {
              Err(
                "print: this value's type is undecided in part, or has no portable display; " ++ "annotate it, or print text, numbers, booleans, characters, void, tuples, " ++ "lists, records, Option, Result or datatypes",
                q
              )
            }
          }
        }
      }
    },
    /* Workman's `%`, read from Workman: remainder truncated toward zero on an int, Int64 or
       real, resolved by type during translation (Translate.remainders). */
    EId(q, ([], "`rem")) => {
      let (a, st') = fresh(st, KClass([intName, int64Name, realName]), level);
      let t = TArrow(tupleTy([a, a]), a);
      let State(vs, nx, sels, recs, sites) = st';
      match(sites) {
        Some(xs) => {
          Ok(t, State(vs, nx, sels, recs, Some([Operand(q, t), ..xs])))
        },
        None => {
          Err("Workman's `%` has no SML counterpart outside translation from Workman", q)
        }
      }
    },
    /* A record update read from Workman, `.{ ..source, x = e }`: the identity on the
       source's record type, expanded by Translate.recordUpdates once that type is known. */
    EId(q, ([], "`update")) => {
      let (a, st') = fresh(st, KPlain, level);
      let t = TArrow(a, a);
      let State(vs, nx, sels, recs, sites) = st';
      match(sites) {
        Some(xs) => {
          Ok(t, State(vs, nx, sels, recs, Some([Operand(q, t), ..xs])))
        },
        None => {
          Err("a record update has no SML counterpart outside translation from Workman", q)
        }
      }
    },
    EId(q, id) => {
      match(Env.value(env, id)) {
        Some(entry) => {
          let (scheme, _) = entry;
          let (kinds, _) = scheme;
          let (t, st') = instantiate(st, level, scheme);
          let numeric = SmlList.exists((k) => {
            match(k) {
              KClass(_) => { true },
              _ => { false }
            }
          })(kinds);
          let primitive = if (if (numeric) { true } else { id == ([], "div") }) { true } else { id == ([], "mod") };
          let integerLibrary = match(id) {
            (["Int"], _) => {
              match(Env.structureAt(env, ["Int"])) {
                Some(_, isBasis) => { isBasis },
                None => { false }
              }
            },
            _ => { false }
          };
          let State(vs, nx, sels, recs, sites) = st';
          let st'' = if (if (primitive) { true } else { integerLibrary }) {
            match(sites) {
              Some(xs) => { State(vs, nx, sels, recs, Some([Operand(q, t), ..xs])) },
              None => { st' }
            }
          } else { st' };
          Ok(t, st'')
        },
        None => { Err("unbound identifier " ++ longName(id), q) }
      }
    },
    ECopy(_, source, _, _) => { exp(ctx, source, st) },
    ERecord(q, fields) => {
      bind(checkRecordLabels(env, q, SmlList.map((l, _) => { l })(fields), st))((_) => (st) => {
        bind(mapRes(
          ((l, x), st) => { bind(exp(ctx, x, st))((t) => (st) => { Ok((l, t), st) }) },
          fields,
          st
        ))((fs) => (st) => {
          let t = TRecord(sortFields(fs));
          let State(_, _, _, rs, sites) = st;
          let labels = SmlList.map((l, _) => { l })(fields);
          let same = (declared) => {
            if (SubsetList.length32(declared) == SubsetList.length32(labels)) {
              SmlList.all((l) => { SmlList.exists((m) => { m == l })(declared) })(labels)
            } else { false }
          };
          /* Reading Workman, a record literal is the one declared record type with
             exactly its fields, as Workman infers `.{ x = 1, y = 2 }`; its fields take
             that type's field types, so `1` is a real where the field is Real64. */
          let matches = match(sites) {
            None => { [] },
            Some(_) => { SmlList.filter((declared, _, _) => { same(declared) })(rs) }
          };
          match(matches) {
            [(_, Var(arity), Var(body))] => {
              let rec fresh' = (n, acc, st) => {
                if (n == 0) { (SmlList.rev(acc), st) } else {
                  let (a, st) = fresh(st, KPlain, level);
                  fresh'(n - 1, [a, ..acc], st)
                }
              };
              let (args, st) = fresh'(arity, [], st);
              bind(unifyAt(
                st,
                q,
                "record of type with fields {" ++ SubsetString.concatWith(labels, ", ") ++ "}",
                t,
                substGen(args, body)
              ))((_) => (st) => { Ok(t, st) })
            },
            _ => { Ok(t, st) }
          }
        })
      })
    },
    ESelect(q, l) => {
      let (r, st1) = fresh(st, KPlain, level);
      let (f, st2) = fresh(st1, KPlain, level);
      let State(vars, next, sels, recs, eqs) = st2;
      Ok(TArrow(r, f), State(vars, next, [(q, level, r, l, f), ..sels], recs, eqs))
    },
    ETuple([]) => { Ok(unitTy, st) },
    ETuple(es) => {
      bind(mapRes((x, st) => { exp(ctx, x, st) }, es, st))((ts) => (st) => { Ok(tupleTy(ts), st) })
    },
    EList(es) => {
      let (elem, st0) = fresh(st, KPlain, level);
      bind(foldRes(
        (_, x, st) => {
          bind(exp(ctx, x, st))((t) => (st) => { unifyAt(st, at(0, expPos(x)), "list element", elem, t) })
        },
        void,
        es,
        st0
      ))((_) => (st) => { Ok(listTy(elem), st) })
    },
    ESeq(es) => {
      bind(foldRes((_, x, st) => { exp(ctx, x, st) }, unitTy, es, st))((t) => (st) => { Ok(t, st) })
    },
    ELet(ds, es) => {
      let State(_, start, _, _, _) = st;
      bind(decs(ctx, ds, st))((delta) => (st) => {
        bind(foldRes(
          (_, x, st) => { exp((plus(env, delta), level, scopedOf(ctx)), x, st) },
          unitTy,
          es,
          st
        ))((t) => (st) => {
          if (SmlList.exists((s) => { s >= start })(tynames(resolve(st, t)))) {
            Err("the type of this `let` mentions a type declared inside it", at(0, expPos(e)))
          } else { Ok(t, st) }
        })
      })
    },
    EApp(EId(q, ([], Var(opr))), a) => {
      match(if (opr == "=") { true } else { opr == "<>" }, st) {
        (true, State(_, _, _, _, Some(_))) => {
          bind(exp(ctx, a, st))((ta) => (st) => {
            let (operand, st1) = fresh(st, KPlain, level);
            bind(unifyAt(st1, q, "operands of " ++ opr, tupleTy([operand, operand]), ta))((_) => (st) => {
              let State(vars, next, sels, recs, sites) = st;
              Ok(
                boolTy,
                State(
                  vars,
                  next,
                  sels,
                  recs,
                  Some([
                    Operand(q, operand),
                    ..match(sites) {
                      Some(l) => { l },
                      None => { [] }
                    }
                  ])
                )
              )
            })
          })
        },
        _ => { application(ctx, EId(q, ([], opr)), a, st) }
      }
    },
    EApp(f, a) => { application(ctx, f, a, st) },
    ETyped(x, t) => {
      bind(exp(ctx, x, st))((tx) => (st) => {
        bind(scopedTy(ctx, at(0, expPos(x)), t, st))((t') => (st) => {
          bind(unifyAt(st, at(0, expPos(x)), "type annotation", t', tx))((_) => (st) => { Ok(t', st) })
        })
      })
    },
    EAndalso(a, b) => { boolOp(ctx, "andalso", a, b, st) },
    EOrelse(a, b) => { boolOp(ctx, "orelse", a, b, st) },
    EIf(c, a, b) => {
      bind(exp(ctx, c, st))((tc) => (st) => {
        bind(unifyAt(st, at(0, expPos(c)), "condition of `if`", boolTy, tc))((_) => (st) => {
          bind(exp(ctx, a, st))((ta) => (st) => {
            bind(exp(ctx, b, st))((tb) => (st) => {
              bind(unifyAt(st, at(0, expPos(b)), "branches of `if` differ", ta, tb))((_) => (st) => { Ok(ta, st) })
            })
          })
        })
      })
    },
    ECase(x, rules) => {
      bind(exp(ctx, x, st))((tx) => (st) => {
        bind(matchRules(ctx, rules, st))((tp, tr) => (st) => {
          bind(unifyAt(st, at(0, expPos(x)), "`case` patterns do not fit the value", tp, tx))((_) => (st) => { Ok(tr, st) })
        })
      })
    },
    EFn(rules) => {
      bind(matchRules(ctx, rules, st))((tp, tr) => (st) => { Ok(TArrow(tp, tr), st) })
    }
  }
}

and application = (ctx, f, a, st) => {
  let (_, level, _) = ctx;
  bind(exp(ctx, f, st))((tf) => (st) => {
    bind(exp(ctx, a, st))((ta) => (st) => {
      let what = match(f) {
        EId(_, ([], "`show")) => { "value in a backtick string's ${ }" },
        EId(_, id) => { "argument of " ++ longName(id) },
        _ => { "function argument" }
      };
      let pos = at(
        0,
        match(expPos(a)) {
          Some(q) => { Some(q) },
          None => { expPos(f) }
        }
      );
      match(prune(st, tf)) {
        TArrow(dom, cod) => {
          bind(unifyAt(st, pos, what, dom, ta))((_) => (st) => { Ok(cod, st) })
        },
        _ => {
          let (r, st') = fresh(st, KPlain, level);
          bind(unifyAt(st', at(pos, expPos(f)), "applied expression", TArrow(ta, r), tf))((_) => (st) => { Ok(r, st) })
        }
      }
    })
  })
}

and boolOp = (ctx, name, a, b, st) => {
  bind(exp(ctx, a, st))((ta) => (st) => {
    bind(unifyAt(st, at(0, expPos(a)), "operand of " ++ name, boolTy, ta))((_) => (st) => {
      bind(exp(ctx, b, st))((tb) => (st) => {
        bind(unifyAt(st, at(0, expPos(b)), "operand of " ++ name, boolTy, tb))((_) => (st) => { Ok(boolTy, st) })
      })
    })
  })
}

// A match: the type of its patterns and of its results.
and matchRules = (ctx, rules, st) => {
  let (env, level, scoped) = ctx;
  let (tp, st1) = fresh(st, KPlain, level);
  let (tr, st2) = fresh(st1, KPlain, level);
  bind(foldRes(
    (_, (p, x), st) => {
      bind(pat(ctx, p, st))((t, vars) => (st) => {
        bind(unifyAt(st, at(0, patPos(p)), "patterns of a match differ", tp, t))((_) => (st) => {
          bind(exp(
            (
              plus(env, withValues(SmlList.map((v, vt) => { (v, (([], vt), SValue)) })(vars))),
              level,
              scoped
            ),
            x,
            st
          ))((tx) => (st) => {
            unifyAt(st, at(0, expPos(x)), "results of a match differ", tr, tx)
          })
        })
      })
    },
    void,
    rules,
    st2
  ))((_) => (st) => { Ok((tp, tr), st) })
}

// ---------------------------------------------------------------------------------------
// Declarations: each returns the environment it declares.

and decs = (ctx, ds, st) => {
  let (env, level, scoped) = ctx;
  foldRes(
    (delta, d, st) => {
      bind(dec((plus(env, delta), level, scoped), d, st))((more) => (st) => { Ok(plus(delta, more), st) })
    },
    empty,
    ds,
    st
  )
}

and dec = (ctx, d, st) => {
  match(d) {
    DVal(pos, tyvars, plain, recs) => { valDec(ctx, pos, tyvars, plain, recs, st) },
    DType(pos, binds) => { typeDec(ctx, pos, binds, st) },
    DDatatype(pos, binds) => { datatypeDec(ctx, pos, binds, st) },
    DOpen(pos, paths) => {
      foldRes(
        (delta, path, st) => {
          match(structureAt(envOf(ctx), path)) {
            Some(entry) => {
              let (found, isBasis) = entry;
              if (isBasis) {
                Err(
                  "SubsetML can only open structures the program declares, not Basis structure " ++ SubsetString.concatWith(path, ".") ++ " (spec F2)",
                  pos
                )
              } else { Ok(plus(delta, found), st) }
            },
            None => {
              Err("unbound structure " ++ SubsetString.concatWith(path, "."), pos)
            }
          }
        },
        empty,
        paths,
        st
      )
    },
    /* Definition §4.10 rule 23: dec2 sees dec1, and only dec2's bindings are declared.
       Restriction (spec §7, L1): a type dec1 declares may not occur in what dec2 makes visible,
       since Workman's `private` hides it from importers. */
    DLocal(pos, hidden, body) => {
      let (env, level, scoped) = ctx;
      let priorState = st;
      bind(decs(ctx, hidden, st))((private) => (st) => {
        bind(decs((plus(env, private), level, scoped), body, st))((visible) => (st) => {
          match(localLeak(private, visible, priorState, st)) {
            None => { Ok(visible, st) },
            Some(binding, tyName) => {
              Err(
                binding ++ " mentions type " ++ tyName ++ ", which this `local` declares privately; " ++ "declare the type outside the `local` (spec L1)",
                pos
              )
            }
          }
        })
      })
    }
  }
}

/* The first binding of `visible` whose type mentions a datatype or record type declared in
   `private`, with that type's name. A record type is a label set, as Workman's nominal
   records are named by their declaration. An open only aliases existing types: stamps and
   record label sets present before the hidden declarations cannot be private declarations. */
and localLeak = (private, visible, priorState, st) => {
  let State(_, first, _, existingRecords, _) = priorState;
  let Env(_, hiddenTypes, _) = private;
  let Env(_, visibleTypes, visibleValues) = visible;
  let sameLabels = (a, b) => {
    if (SubsetList.length32(a) == SubsetList.length32(b)) {
      SmlList.all((l) => { SmlList.exists((m) => { m == l })(b) })(a)
    } else { false }
  };
  let datatypes = SmlList.mapPartial(match {
    (Var(n), TyStr(_, t, cons)) => {
      match(t, cons) {
        (TCon(name, _), [_, .._]) => { if (stampOf(name) >= first) { Some(n, name) } else { None } },
        _ => { None }
      }
    }
  })(hiddenTypes);
  let labelsOf = (fields) => { SmlList.map((l, _) => { l })(fields) };
  let records = SmlList.mapPartial(match {
    (Var(n), TyStr(_, t, _)) => {
      match(t) {
        TRecord(fields) => {
          match(tupleComponents(fields)) {
            None => {
              if (SmlList.exists((labels, _, _) => { sameLabels(labels, labelsOf(fields)) })(existingRecords)) { None } else { Some(n, labelsOf(fields)) }
            },
            Some(_) => { None }
          }
        },
        _ => { None }
      }
    }
  })(hiddenTypes);
  let rec mentions = (t) => {
    match(prune(st, t)) {
      TCon(name, args) => {
        match(SmlList.find((_, hiddenName) => { sameName(name, hiddenName) })(datatypes)) {
          Some(found) => {
            let (n, _) = found;
            Some(n)
          },
          None => { first(args) }
        }
      },
      TArrow(a, b) => { first([a, b]) },
      TRecord(fields) => {
        match(tupleComponents(fields), SmlList.find((_, labels) => { sameLabels(labels, labelsOf(fields)) })(records)) {
          (None, Some(found)) => {
            let (n, _) = found;
            Some(n)
          },
          _ => { first(SmlList.map((_, x) => { x })(fields)) }
        }
      },
      _ => { None }
    }
  }
  and first = (ts) => {
    match(ts) {
      [] => { None },
      [t, ..rest] => {
        match(mentions(t)) {
          Some(n) => { Some(n) },
          None => { first(rest) }
        }
      }
    }
  };
  let rec scan = (entries) => {
    match(entries) {
      [] => { None },
      [(Var(name), Var(t)), ..rest] => {
        match(mentions(t)) {
          Some(n) => { Some(name, n) },
          None => { scan(rest) }
        }
      }
    }
  };
  /* A visible type alias of a hidden type leaks it too. A datatype the visible part
     declares again has a fresh name, so it never matches. */
  let typeEntries = SmlList.map(match {
    (Var(n), TyStr(_, t, _)) => { ("type " ++ n, t) }
  })(visibleTypes);
  let valueEntries = SmlList.map((name, ((_, t), _)) => { ("`" ++ name ++ "`", t) })(visibleValues);
  scan(SubsetList.append(valueEntries, typeEntries))
}

// `val`: Definition §4.10 rules 15-16 and the closure of §4.8.
and valDec = ((env, level, scoped), pos, tyvars, plain, recs, st) => {
  let bindings = SubsetList.append(plain, recs);
  let implicit = SmlList.filter((v) => { SubsetBool.not(member(v, scoped)) })(distinct(concatMap((p, e) => { SubsetList.append(patTyVars(p), expTyVars(e)) }, bindings)));
  let explicit = distinct(SubsetList.append(tyvars, implicit));
  let inner = (env, level + 1, SubsetList.append(scoped, explicit));
  // A binding's pattern, its type and variables, checked against its expression's type.
  let plainBinding = ((p, e), st) => {
    bind(exp(inner, e, st))((te) => (st) => {
      bind(pat(inner, p, st))((tp, vars) => (st) => {
        bind(unifyAt(st, at(pos, patPos(p)), "value binding", tp, te))((_) => (st) => { Ok((vars, nonExpansive(env, e)), st) })
      })
    })
  };
  // SubsetML only allows a variable (SML would also let `val rec` rebind a constructor).
  let recPattern = ((p, _), st) => {
    let single = (_, vars) => (st) => {
      match(vars) {
        [_] => { Ok(vars, st) },
        _ => {
          Err(
            "a `val rec` binding must bind a variable, not a constructor",
            at(pos, patPos(p))
          )
        }
      }
    };
    match(p) {
      PId(_, ([], _)) => { bind(pat(inner, p, st))(single) },
      PTyped(PId(_, ([], _)), _) => { bind(pat(inner, p, st))(single) },
      _ => {
        Err("a `val rec` binding must bind a single variable", at(pos, patPos(p)))
      }
    }
  };
  if (SmlList.exists((v) => { member(v, scoped) })(tyvars)) {
    Err("a type variable is already scoped by an enclosing `val`", pos)
  } else {
    bind(mapRes(plainBinding, plain, st))((plainResults) => (st) => {
      bind(mapRes(recPattern, recs, st))((recVars) => (st) => {
        let recEnv = withValues(SmlList.map((v, t) => { (v, (([], t), SValue)) })(SmlList.concat(recVars)));
        let recInner = (plus(env, recEnv), level + 1, SubsetList.append(scoped, explicit));
        bind(foldRes(
          (_, ((_, e), vars), st) => {
            match(vars) {
              [(_, Var(t))] => {
                bind(exp(recInner, e, st))((te) => (st) => { unifyAt(st, at(pos, expPos(e)), "recursive binding", t, te) })
              },
              _ => { Ok(void, st) }
            }
          },
          void,
          SmlListPair.zip(recs, recVars),
          st
        ))((_) => (st) => {
          let results = SubsetList.append(plainResults, SmlList.map((vars) => { (vars, true) })(recVars));
          closeValBindings(level, explicit, pos, results, st)
        })
      })
    })
  }
}

/* Closes a `val`'s bindings: each variable's scheme, given whether its expression may be
   generalized. */
and closeValBindings = (level, explicit, pos, results, st) => {
  let names = concatMap((vars, _) => { SmlList.map((x, _) => { x })(vars) }, results);
  match(SmlList.find((x) => {
    SubsetList.length32(SmlList.filter((y) => { y == x })(names)) > 1
  })(names), SmlList.find((x) => { member(x, unbindable) })(names)) {
    (Some(x), _) => { Err("`" ++ x ++ "` is bound twice in this declaration", pos) },
    (_, Some(x)) => { Err("`" ++ x ++ "` cannot be rebound", pos) },
    (None, None) => {
      bind(closeDeclaration(level, st))((_) => (st) => {
        bind(foldRes(
          (acc, (vars, generalizable), st) => {
            foldRes(
              (acc, (x, t), st) => {
                bind(closeBinding(level, explicit, generalizable, pos, x, t, st))((entry) => (st) => { Ok(SubsetList.append(acc, [entry]), st) })
              },
              acc,
              vars,
              st
            )
          },
          [],
          results,
          st
        ))((entries) => (st) => {
          Ok(withValues(SmlList.map((x, s) => { (x, (s, SValue)) })(entries)), st)
        })
      })
    }
  }
}

/* Settles what the declaration's context must settle (spec §10): pending `# lab`
   selections, and overloaded type variables, which default to int (Appendix E). */
and closeDeclaration = (level, st) => {
  bind(settleSelections(level, st))((_) => (st) => { Ok(void, st) })
}

and settleSelections = (level, st) => {
  let State(vars, next, sels, recs, eqs) = st;
  // One pass: resolves each selection whose record type is known.
  let step = ((pending, progress), sel, st) => {
    let (q, l, r, lab, f) = sel;
    match(prune(st, r)) {
      TRecord(fields) => {
        match(SmlList.find((l', _) => { l' == lab })(fields)) {
          Some(entry) => {
            let (_, ft) = entry;
            bind(unifyAt(st, q, "field " ++ lab, ft, f))((_) => (st) => { Ok((pending, true), st) })
          },
          None => {
            Err("the record has no field " ++ lab ++ ": " ++ show(st, r), q)
          }
        }
      },
      TVar(v) => {
        /* A field belongs to its receiver's type, even while the flexible row is
           pending. Preserve that context dependency before closing inner vals. */
        let receiverLevel = match(lookup(st, v)) {
          Free(_, level) => { level },
          Bound(_) => { l }
        };
        let escaped = SmlList.exists((w) => {
          match(lookup(st, w)) {
            Free(_, fieldLevel) => { fieldLevel > receiverLevel },
            Bound(_) => { false }
          }
        })(freeVars(st, f));
        Ok(
          (SubsetList.append(pending, [sel]), if (progress) { true } else { escaped }),
          adjust(st, receiverLevel, f)
        )
      },
      _ => {
        Err("`#" ++ lab ++ "` is applied to a non-record: " ++ show(st, r), q)
      }
    }
  };
  let rec loop = (st) => {
    let State(vs, nx, sels, rs, eq) = st;
    bind(foldRes(step, ([], false), sels, State(vs, nx, [], rs, eq)))((pending, progress) => (st) => {
      let State(vs', nx', _, rs', eq') = st;
      if (progress) { loop(State(vs', nx', pending, rs', eq')) } else { Ok(pending, State(vs', nx', pending, rs', eq')) }
    })
  };
  /* Reading Workman, a field names its record type when one declared record type has it,
     as Workman resolves `user.score`; SML would need the receiver annotated. One pass
     resolves the first such selection, then the loop settles what follows from it. */
  let byLabel = (st) => {
    let State(_, _, pending, rs, sites) = st;
    match(sites) {
      None => { None },
      Some(_) => {
        // Only where SML would give up: a receiver this declaration must decide.
        SmlList.find((_, _, r, lab, _) => {
          match(prune(st, r)) {
            TVar(v) => {
              if (match(lookup(st, v)) {
                Free(_, l) => { l > level },
                Bound(_) => { false }
              }) {
                SubsetList.length32(SmlList.filter((labels, _, _) => { SmlList.exists((m) => { m == lab })(labels) })(rs)) == 1
              } else { false }
            },
            _ => { false }
          }
        })(pending)
      }
    }
  };
  let rec settle = (st) => {
    bind(loop(st))((pending) => (st) => {
      match(byLabel(st)) {
        None => { Ok(pending, st) },
        Some(sel) => {
          let (q, l, r, lab, _) = sel;
          let State(_, _, _, rs, _) = st;
          let Some(declared) = SmlList.find((labels, _, _) => { SmlList.exists((m) => { m == lab })(labels) })(rs);
          let (labels, arity, body) = declared;
          let rec fresh' = (n, acc, st) => {
            if (n == 0) { (SmlList.rev(acc), st) } else {
              let (t, st) = fresh(st, KPlain, l);
              fresh'(n - 1, [t, ..acc], st)
            }
          };
          let (args, st) = fresh'(arity, [], st);
          // Translation writes the selection as a complete record pattern.
          let st = match(st) {
            State(vs, nx, sels, rs, Some(xs)) => {
              State(vs, nx, sels, rs, Some([FieldRecord(q, labels), ..xs]))
            },
            _ => { st }
          };
          bind(unifyAt(st, q, "record of field " ++ lab, r, substGen(args, body)))((_) => (st) => { settle(st) })
        }
      }
    })
  };
  bind(settle(State(vars, next, sels, recs, eqs)))((pending) => (st) => {
    match(SmlList.find((_, _, r, _, _) => {
      match(prune(st, r)) {
        TVar(v) => {
          match(lookup(st, v)) {
            Free(_, l) => { l > level },
            Bound(_) => { false }
          }
        },
        _ => { false }
      }
    })(pending)) {
      Some(sel) => {
        let (q, _, _, lab, _) = sel;
        Err(
          "cannot determine the record type for `#" ++ lab ++ "`; add a type annotation",
          q
        )
      },
      None => { Ok(void, st) }
    }
  })
}

// The scheme of one bound variable.
and closeBinding = (level, explicit, generalizable, pos, x, t, st) => {
  /* Appendix E: default unresolved numeric classes at declaration closure. The surrounding
     text that may resolve them is "no larger than the smallest enclosing structure-level
     declaration"; SubsetML takes the smallest enclosing `val` (spec §10). Reading Workman,
     it takes the structure-level declaration, as Workman does, so a local `let r = 235;`
     used as a real is a real: a local binding leaves its classes open, monomorphic, and
     the structure-level binding defaults every literal and operand still undecided. */
  let undecided = (v) => {
    match(lookup(st, v)) {
      Free(KClass(_), l) => { l > level },
      _ => { false }
    }
  };
  let sites = match(st) {
    State(_, _, _, _, Some(xs)) => { Some(xs) },
    _ => { None }
  };
  let siteVars = (xs) => {
    SmlList.foldl((site, acc) => {
      match(site) {
        Literal(_, ty) => {
          match(prune(st, ty)) {
            TVar(v) => {
              if (if (undecided(v)) { SubsetBool.not(member(v, acc)) } else { false }) { [v, ..acc] } else { acc }
            },
            _ => { acc }
          }
        },
        Operand(_, ty) => {
          match(prune(st, ty)) {
            TVar(v) => {
              if (if (undecided(v)) { SubsetBool.not(member(v, acc)) } else { false }) { [v, ..acc] } else { acc }
            },
            _ => { acc }
          }
        },
        _ => { acc }
      }
    })([])(xs)
  };
  let own = SmlList.filter(undecided)(freeVars(st, t));
  let (defaults, st) = match(sites) {
    None => { (own, st) },
    Some(xs) => {
      if (level > 0) {
        (
          [],
          SmlList.foldl((v, st) => {
            match(lookup(st, v)) {
              Free(k, _) => { set(st, v, Free(k, level)) },
              _ => { st }
            }
          })(st)(own)
        )
      } else {
        (
          SubsetList.append(own, SmlList.filter((v) => { SubsetBool.not(member(v, own)) })(siteVars(xs))),
          st
        )
      }
    }
  };
  let rec settle = (vars, st) => {
    match(vars) {
      [] => { Ok(void, st) },
      [v, ..rest] => {
        let names = match(lookup(st, v)) {
          Free(KClass(ns), _) => { ns },
          _ => { [intName] }
        };
        let has = (n) => { SmlList.exists((m) => { sameName(m, n) })(names) };
        /* Only a backtick string's `${ }` has string in its class: SML has no generic
           text conversion, so its type must be known. */
        if (has(stringName)) {
          Err(
            "the type of a value in a backtick string's ${ } is undecided; annotate it as " ++ "String, Char, Int32, Int64, Real64 or Bool",
            pos
          )
        } else {
          if (has(intName)) {
            bind(unifyAt(st, pos, "integer default", TVar(v), intTy))((_) => (st) => { settle(rest, st) })
          } else {
            if (has(realName)) {
              bind(unifyAt(st, pos, "real default", TVar(v), realTy))((_) => (st) => { settle(rest, st) })
            } else {
              match(names) {
                [only] => {
                  if (sameName(only, int64Name)) {
                    Err("integer constant outside signed 32-bit range; annotate it as Int64.int", pos)
                  } else {
                    Err(
                      "the type of this numeric constant or operation is undecided; annotate it as " ++ nameOf(only),
                      pos
                    )
                  }
                },
                _ => {
                  Err(
                    "the type of this numeric constant or operation is undecided; annotate it as one of " ++ SubsetString.concatWith(SmlList.map(nameOf)(names), ", "),
                    pos
                  )
                }
              }
            }
          }
        }
      }
    }
  };
  bind(settle(defaults, st))((_) => (st) => {
    let rigid = SmlList.filter((v) => { member(v, explicit) })(rigidNames(resolve(st, t)));
    match(generalizable, rigid) {
      (true, _) => {
        let taken = SmlList.filter((v) => {
          match(lookup(st, v)) {
            Free(_, l) => { l > level },
            Bound(_) => { false }
          }
        })(freeVars(st, resolve(st, t)));
        let st' = match(st) {
          State(vs, nx, sels, recs, Some(xs)) => {
            State(
              vs,
              nx,
              sels,
              recs,
              Some(SubsetList.append(SmlList.map(Generalized)(taken), xs))
            )
          },
          _ => { st }
        };
        Ok((x, generalize(st, level, explicit, t)), st')
      },
      (false, [v, .._]) => {
        Err(
          "type variable " ++ v ++ " cannot be generalized: the value is expansive (Definition, section 4.8)",
          pos
        )
      },
      (false, []) => { Ok((x, ([], resolve(st, t))), adjust(st, level, t)) }
    }
  })
}

and rigidNames = (t) => {
  match(t) {
    TRigid(v) => { [v] },
    TCon(_, ts) => { concatMap(rigidNames, ts) },
    TArrow(a, b) => { SubsetList.append(rigidNames(a), rigidNames(b)) },
    TRecord(fields) => { concatMap((_, a) => { rigidNames(a) }, fields) },
    _ => { [] }
  }
}

// `type`: Definition §4.10 rule 17, plus spec R2 for record types.
and typeDec = ((env, _, _), pos, binds, st) => {
  let names = SmlList.map((_, name, _) => { name })(binds);
  let dup = SmlList.find((n) => {
    SubsetList.length32(SmlList.filter((m) => { m == n })(names)) > 1
  })(names);
  match(dup) {
    Some(n) => { Err("type " ++ n ++ " is bound twice", pos) },
    None => {
      bind(foldRes(
        (acc, (params, name, t), st) => {
          bind(paramScope(pos, params, st))((tyvar) => (st) => {
            bind(elabTy(env, tyvar, pos, t, st))((body) => (st) => {
              bind(match(t) {
                TyRecord(_) => { recordDeclared(pos, SubsetList.length32(params), body, st) },
                _ => { Ok(void, st) }
              })((_) => (st) => {
                Ok(
                  SubsetList.append(acc, [(name, TyStr(SubsetList.length32(params), body, []))]),
                  st
                )
              })
            })
          })
        },
        [],
        binds,
        st
      ))((tys) => (st) => { Ok(withTypes(tys), st) })
    }
  }
}

// Maps a declaration's type parameters to TGen.
and paramScope = (pos, params, st) => {
  match(SmlList.find((v) => {
    SubsetList.length32(SmlList.filter((w) => { w == v })(params)) > 1
  })(params)) {
    Some(v) => { Err("type parameter " ++ v ++ " appears twice", pos) },
    None => {
      let rec index = match {
        (_, [], _) => { None },
        (Var(v), [w, ..rest], Var(i)) => { if (v == w) { Some(TGen(i)) } else { index(v, rest, i + 1) } }
      };
      Ok((v) => { index(v, params, 0) }, st)
    }
  }
}

and recordDeclared = (pos, arity, body, st) => {
  match(body) {
    TRecord(fields) => {
      let labels = SmlList.map((l, _) => { l })(fields);
      let State(vars, next, sels, recs, eqs) = st;
      if (SmlList.exists((declared, _, _) => { declared == labels })(recs)) {
        Err(
          "another record type already has the labels {" ++ SubsetString.concatWith(labels, ", ") ++ "} (spec R2)",
          pos
        )
      } else {
        Ok(void, State(vars, next, sels, [(labels, arity, body), ..recs], eqs))
      }
    },
    _ => { Ok(void, st) }
  }
}

// `datatype`: Definition §4.10 rule 19 and §4.9 for the equality attribute.
and datatypeDec = ((env, _, _), pos, binds, st) => {
  let names = SmlList.map((_, name, _) => { name })(binds);
  let cons = concatMap((_, _, cs) => { SmlList.map((_, c, _) => { c })(cs) }, binds);
  let dupIn = (xs) => {
    SmlList.find((n) => {
      SubsetList.length32(SmlList.filter((m) => { m == n })(xs)) > 1
    })(xs)
  };
  // Fresh type names, first assuming every one admits equality.
  let (stamps, st1) = SmlList.foldl((_, (acc, st)) => {
    let (s, st') = freshStamp(st);
    (SubsetList.append(acc, [s]), st')
  })([], st)(binds);
  let nameFor = (eqs, (params, name, _), s) => { (s, name, SubsetList.length32(params), memberInt(s, eqs)) };
  let tyFor = (tn) => {
    let SubsetResult.Ok(args) = SubsetList.tabulate32(arityOf(tn), TGen);
    TCon(tn, args)
  };
  // The constructors' argument types, with the group's names given the equality flags.
  let elabCons = (eqs, st) => {
    let group = SmlListPair.map((b, s) => { nameFor(eqs, b, s) })(binds, stamps);
    let groupEnv = plus(
      env,
      withTypes(SmlList.map((tn) => { (nameOf(tn), TyStr(arityOf(tn), tyFor(tn), [])) })(group))
    );
    bind(mapRes(
      (((params, _, cs), tn), st) => {
        bind(paramScope(pos, params, st))((tyvar) => (st) => {
          bind(mapRes(
            ((cp, c, arg), st) => {
              match(arg) {
                None => { Ok((c, None), st) },
                Some(t) => {
                  bind(elabTy(groupEnv, tyvar, cp, t, st))((t') => (st) => { Ok((c, Some(t')), st) })
                }
              }
            },
            cs,
            st
          ))((cs') => (st) => { Ok((tn, cs'), st) })
        })
      },
      SmlListPair.zip(binds, group),
      st
    ))((result) => (st) => { Ok(result, st) })
  };
  // Whether a type admits equality, assuming `eqs` for the group (Definition §4.9).
  let rec admits = (eqs, t) => {
    match(t) {
      TCon((Var(s), _, _, Var(eq)), args) => {
        if (if (memberInt(s, stamps)) { memberInt(s, eqs) } else { eq }) { SmlList.all((a) => { admits(eqs, a) })(args) } else { false }
      },
      TArrow(_, _) => { false },
      TRecord(fields) => { SmlList.all((_, a) => { admits(eqs, a) })(fields) },
      TGen(_) => { true },
      _ => { false }
    }
  };
  let rec fixpoint = (eqs, st) => {
    bind(elabCons(eqs, st))((group) => (st) => {
      let eqs' = SmlList.filter((s) => {
        SmlList.all(((s', _, _, _), cs) => {
          if (s' != s) { true } else {
            SmlList.all((_, arg) => {
              match(arg) {
                None => { true },
                Some(t) => { admits(eqs, t) }
              }
            })(cs)
          }
        })(group)
      })(eqs);
      if (SubsetList.length32(eqs') == SubsetList.length32(eqs)) { Ok(group, st) } else { fixpoint(eqs', st) }
    })
  };
  match(dupIn(names), dupIn(cons), SmlList.find((c) => { if (member(c, unbindable)) { true } else { c == "it" } })(cons)) {
    (Some(n), _, _) => { Err("type " ++ n ++ " is bound twice", pos) },
    (_, Some(c), _) => { Err("constructor " ++ c ++ " is bound twice", pos) },
    (_, _, Some(c)) => { Err("`" ++ c ++ "` cannot be bound by a datatype", pos) },
    _ => {
      bind(fixpoint(stamps, st1))((group) => (st) => {
        let conEntries = concatMap(
          (tn, cs) => {
            SmlList.map((c, arg) => {
              let SubsetResult.Ok(kinds) = SubsetList.tabulate32(arityOf(tn), (_) => { KPlain });
              match(arg) {
                None => { (c, ((kinds, tyFor(tn)), SCon)) },
                Some(t) => { (c, ((kinds, TArrow(t, tyFor(tn))), SCon)) }
              }
            })(cs)
          },
          group
        );
        let tyEntries = SmlList.map((tn, cs) => {
          (
            nameOf(tn),
            TyStr(
              arityOf(tn),
              tyFor(tn),
              SmlList.map((c, _) => {
                (
                  c,
                  {
                    let Some(entry) = assoc(c, conEntries);
                    let (scheme, _) = entry;
                    scheme
                  }
                )
              })(cs)
            )
          )
        })(group);
        Ok(Env.Env([], tyEntries, conEntries), st)
      })
    }
  }
};

// ---------------------------------------------------------------------------------------
// Top-level phrases (Definition §8)

// Restriction M2: an alias names a whole program structure, as a Workman file's import does.
let structureAliases = (env, aliases, st) => {
  foldRes(
    (delta, (pos, name, target), st) => {
      match(structureAt(env, [target])) {
        Some(entry) => {
          let (found, isBasis) = entry;
          if (isBasis) {
            Err(
              "SubsetML can only alias structures the program declares, not Basis structure " ++ target ++ " (spec M2)",
              pos
            )
          } else { Ok(plus(delta, withStructure(name, found, false)), st) }
        },
        None => { Err("unbound structure " ++ target, pos) }
      }
    },
    empty,
    aliases,
    st
  )
};

let strdec = (env, sd, st) => {
  match(sd) {
    SDec(d) => { dec((env, 0, []), d, st) },
    SStructure(_, binds) => {
      foldRes(
        (delta, (name, aliases, ds), st) => {
          bind(structureAliases(env, aliases, st))((nested) => (st) => {
            bind(decs((plus(env, nested), 0, []), ds, st))((body) => (st) => {
              Ok(plus(delta, withStructure(name, plus(nested, body), false)), st)
            })
          })
        },
        empty,
        binds,
        st
      )
    }
  }
};

let topdec = (env, td, st) => {
  match(td) {
    TopDecs(sds) => {
      foldRes(
        (delta, sd, st) => {
          bind(strdec(plus(env, delta), sd, st))((more) => (st) => { Ok(plus(delta, more), st) })
        },
        empty,
        sds,
        st
      )
    },
    TopExp(pos, e) => {
      dec((env, 0, []), DVal(pos, [], [(PId(pos, ([], "it")), e)], []), st)
    }
  }
};

// Return only declarations owned by this file, without its incoming environment.
let programExports = (env, phrases, st) => {
  foldRes(
    (owned, td, st) => {
      bind(topdec(plus(env, owned), td, st))((delta) => (st) => { Ok(plus(owned, delta), st) })
    },
    empty,
    phrases,
    st
  )
};

// The existing explicit-file workflow extends the supplied environment.
let program = (env, phrases, st) => {
  bind(programExports(env, phrases, st))((owned) => (st) => { Ok(plus(env, owned), st) })
};
