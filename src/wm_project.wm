        let std = inside(directory ++ "/std", path);
        let singleton = (name) => {
          SubsetList.exists(tokens, (token, _) => { token == WmLexer.WName([name]) })
        };
        let mentioned = (name) => {
          SubsetList.exists(
            tokens,
            (token, _) => {
              match(token) {
                WmLexer.WName([head, .._]) => { head == name },
                _ => { false }
              }
            }
          )
        };
        let builtin = SubsetList.append(WmModuleScope.builtinValues, WmModuleScope.builtinTypes);
        let projected = if (std) { builtin } else {
