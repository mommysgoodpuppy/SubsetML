      }
    )) { Some("subset_" ++ name ++ ".wm") } else { None }
  } else { None }
};

let validSpecifier = (specifier) => {
  if (SubsetOption.isSome(basisModule(specifier))) { true } else {
    if (CompilerText.isSuffix(specifier, ".wm")) {
      ModuleImports.validPath(CompilerText.slice(specifier, 0, CompilerText.size(specifier) - 3) ++ ".sml")
