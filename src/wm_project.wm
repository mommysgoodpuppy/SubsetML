let librarySource = (directory, path) => {
  if (inside(directory, path)) { SubsetBool.not(inside(directory ++ "/std", path)) } else { false }
};

/* The driver supplies an inventory of staged library modules. Older --basis callers can
   still use their flat Basis directory; candidates are verified by the shared scope rules. */
let libraryPaths = (directory, tokens) => {
  let candidates = SubsetList.concat(SubsetList.map(
    tokens,
    (token, _) => {
      match(token) {
