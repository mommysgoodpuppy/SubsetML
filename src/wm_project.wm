// "basis/won.wm" names the Basis module subset_won.wm, as in Workman.
let basisModule = (specifier) => {
  let count = CompilerText.size(specifier);
  if (if (if (count > 9) { CompilerText.slice(specifier, 0, 6) == "basis/" } else { false }) { CompilerText.isSuffix(specifier, ".wm") } else { false }) {
