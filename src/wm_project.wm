    }
  }
};

/* Workman opens each public Basis module subset_x.wm as the namespace X in every program:
   `List` is SubsetList and `ListPair` is SubsetListPair. With a Basis directory, a module
   that uses `X.name` without binding X in an import gets that Basis import, so discovery,
   preparation and checking treat it as written. The host adapters are not namespaces, and
   the Basis modules themselves import each other explicitly. `Int32` stays the translator's
   own numeric namespace (`Int32.Int`, `Int32.div`), which the numeric refactor revisits. */
let basisFile = (name) => {
  let rec go = (cs, previous, acc) => {
    match(cs) {
      [] => { SubsetList.reverse(acc) },
      [c, ..rest] => {
        let separated = if (SubsetChar.isUpper(c)) {
          if (SubsetChar.isLower(previous)) { true } else { SubsetChar.isDigit(previous) }
        } else { false };
        go(
          rest,
          c,
          if (separated) { [SubsetChar.toLower(c), '_', ..acc] } else { [SubsetChar.toLower(c), ..acc] }
        )
      }
    }
  };
  "subset_" ++ CompilerText.implode(go(CompilerText.characters(name), '_', [])) ++ ".wm"
};

let implicitBasis = (basis, path, tokens) => {
  let canonical = (path) => {
    match(ModuleProject.identify(path)) {
      SubsetResult.Ok(ModuleProject.Resolved(_, canonical)) => { Some(canonical) },
      SubsetResult.Err(_) => { None }
    }
  };
  let inside = (directory) => {
    match(canonical(directory), canonical(path)) {
      (Some(directory), Some(file)) => {
        if (CompilerText.size(file) > CompilerText.size(directory) + 1) {
          CompilerText.slice(file, 0, CompilerText.size(directory) + 1) == directory ++ "/"
        } else { false }
      },
      _ => { false }
    }
  };
  match(basis) {
    None => { tokens },
    Some(directory) => {
      if (inside(directory)) { tokens } else {
        // Every single name inside an import header, whether alias or named item.
        let rec imported = (tokens, inside, acc) => {
          match(tokens) {
            [] => { acc },
            [(WmLexer.WKey("import"), _), ..rest] => { imported(rest, true, acc) },
            [(WmLexer.WKey(";"), _), ..rest] => { imported(rest, false, acc) },
            [(WmLexer.WName([name]), _), ..rest] => {
              imported(rest, inside, if (inside) { [name, ..acc] } else { acc })
            },
            [_, ..rest] => { imported(rest, inside, acc) }
          }
        };
        let explicit = imported(tokens, false, []);
        let available = (name) => {
          if (if (if (CompilerText.firstIs(name, SubsetChar.isUpper)) {
            SubsetBool.not(SubsetList.exists(["Host", "TextHost", "Int32"], (n) => { n == name }))
          } else { false }) {
            SubsetBool.not(SubsetList.exists(explicit, (n) => { n == name }))
          } else { false }) {
            match(ModuleProject.identify(directory ++ "/" ++ basisFile(name))) {
              SubsetResult.Ok(_) => { true },
              SubsetResult.Err(_) => { false }
            }
          } else { false }
        };
        let use = (head, pos, rest, acc) => {
          if (if (SubsetList.exists(acc, (n, _) => { n == head })) { true } else { SubsetBool.not(available(head)) }) { acc } else { [(head, pos), ..acc] }
        };
        // `X.name`, or a carrier group `X|a, b|`, which uses X's andThen and map.
        let rec uses = (tokens, acc) => {
          match(tokens) {
            [] => { SubsetList.reverse(acc) },
            [(WmLexer.WName([head, _, .._]), Var(pos)), ..rest] => { uses(rest, use(head, pos, rest, acc)) },
            [(WmLexer.WName([head]), Var(pos)), (WmLexer.WKey("|"), Var(bar)), ..rest] => {
              uses([(WmLexer.WKey("|"), bar), ..rest], use(head, pos, rest, acc))
            },
            [_, ..rest] => { uses(rest, acc) }
          }
        };
        /* A bare `X` as a whole argument, binding or list item stands for `X.carrier`. Type
           positions look alike, `(Int, String)`; a needless import there changes nothing. */
        let rec bareUses = (tokens, acc) => {
          match(tokens) {
            [
              (WmLexer.WKey(previous), _),
              (WmLexer.WName([head]), Var(pos)),
              (WmLexer.WKey(after), Var(afterPos)),
              ..rest
            ] => {
              bareUses(
                [(WmLexer.WName([head]), pos), (WmLexer.WKey(after), afterPos), ..rest],
                if (if (SubsetList.exists(["(", ",", "=", ":>", "[", "=>"], (k) => { k == previous })) {
                  SubsetList.exists([")", ",", ";", "]", "}"], (k) => { k == after })
                } else { false }) { use(head, pos, rest, acc) } else { acc }
              )
            },
            [_, ..rest] => { bareUses(rest, acc) },
            [] => { acc }
          }
        };
        let header = (name, pos) => {
          [
            (WmLexer.WKey("from"), pos),
            (
              WmLexer.WScon(Syntax.SString("basis/" ++ CompilerText.slice(basisFile(name), 7, CompilerText.size(basisFile(name)) - 7))),
              pos
            ),
            (WmLexer.WKey("import"), pos),
            (WmLexer.WKey("*"), pos),
            (WmLexer.WKey("as"), pos),
            (WmLexer.WName([name]), pos),
            (WmLexer.WKey(";"), pos)
          ]
        };
        /* Constructors and type names share the source Basis's identity too. Use private
           opens, rather than rewriting spellings, so authored declarations and patterns
           can shadow these names with the usual lexical rules. Explicit imports follow
           the defaults and therefore still win. Basis sources supply their own imports. */
        let defaultOpen = (file, names) => {
          if (if (SubsetList.exists(
            tokens,
            (token, _) => {
              match(token) {
                WmLexer.WName([name]) => { SubsetList.exists(names, (n) => { n == name }) },
                _ => { false }
              }
            }
          )) {
            match(ModuleProject.identify(directory ++ "/subset_" ++ file ++ ".wm")) {
              SubsetResult.Ok(_) => { true },
              SubsetResult.Err(_) => { false }
            }
          } else { false }) {
            [
              (WmLexer.WKey("from"), 0),
              (WmLexer.WScon(Syntax.SString("basis/" ++ file ++ ".wm")), 0),
              (WmLexer.WKey("import"), 0),
              (WmLexer.WKey("*"), 0),
              (WmLexer.WKey(";"), 0)
            ]
          } else { [] }
        };
        let defaults = SubsetList.concat([
          defaultOpen("option_value", ["Option", "Some", "None"]),
          defaultOpen("result", ["Result", "Ok", "Err"])
        ]);
        SubsetList.concat([
          defaults,
          SubsetList.concat(SubsetList.map(uses(tokens, bareUses(tokens, [])), header)),
          tokens
        ])
      }
    }
  }
};

/* Discovery reads only the supported import header. Preparation still validates aliases,
   private scope and later imports using the same canonical identities. */
let headerPaths = (path, src, tokens) => {
  let rec scan = (tokens) => {
    match(tokens) {
      [
        (WmLexer.WKey("from"), Var(pos)),
        (WmLexer.WScon(Syntax.SString(specifier)), _),
        (WmLexer.WKey("import"), _),
        (WmLexer.WKey("*"), _),
        ..rest
      ] => {
        let remaining = match(rest) {
          [
            (WmLexer.WKey("as"), _),
            (WmLexer.WName([_]), _),
            (WmLexer.WKey(";"), _),
            ..tail
          ] => { Some(tail) },
          [(WmLexer.WKey(";"), _), ..tail] => { Some(tail) },
          _ => { None }
        };
        match(remaining) {
          None => {
            failure(path, src, "reverse discovery requires header namespace imports", pos)
          },
          Some(tail) => {
            if (SubsetBool.not(validSpecifier(specifier))) {
              failure(
                path,
                src,
                "imports require explicit relative .wm paths or basis/ modules in the local source profile",
                pos
              )
            } else {
              SubsetResult.map(scan(tail), (paths) => { [(specifier, pos), ..paths] })
            }
          }
        }
      },
      [
        (WmLexer.WKey("from"), Var(pos)),
        (WmLexer.WScon(Syntax.SString(specifier)), _),
        (WmLexer.WKey("import"), _),
        (WmLexer.WKey("{"), _),
        ..rest
      ] => {
        let rec close = (tokens) => {
          match(tokens) {
            [(WmLexer.WKey("}"), _), (WmLexer.WKey(";"), _), ..tail] => { Some(tail) },
            [(WmLexer.WKey("}"), _), .._] => { None },
            [] => { None },
            [_, ..tail] => { close(tail) }
          }
        };
        match(close(rest)) {
          None => { failure(path, src, "unterminated `import { ... }`", pos) },
          Some(tail) => {
            if (SubsetBool.not(validSpecifier(specifier))) {
              failure(
                path,
                src,
                "imports require explicit relative .wm paths or basis/ modules in the local source profile",
                pos
              )
            } else {
              SubsetResult.map(scan(tail), (paths) => { [(specifier, pos), ..paths] })
            }
          }
        }
      },
      [(WmLexer.WKey("from"), Var(pos)), .._] => {
        failure(path, src, "reverse discovery requires header namespace imports", pos)
      },
      [(WmLexer.WName(["export"]), _), (WmLexer.WKey("from"), Var(pos)), ..rest] => { scan([(WmLexer.WKey("from"), pos), ..rest]) },
      _ => { SubsetResult.Ok([]) }
    }
  };
  scan(tokens)
};

let discover = (basis, roots) => {
  let rec visit = (resolved, active, seen) => {
    let ModuleProject.Resolved(id, path) = resolved;
    if (SubsetList.exists(seen, (key, _, _) => { ModuleProject.same(key, id) })) { SubsetResult.Ok(seen) } else {
      SubsetResult.andThen(
        SubsetResult.mapErr(
          SubsetIo.readFile(path),
          (error) => { Error(path, "", SubsetIo.errorText(error), 0) }
        ),
        (bytes) => {
          let src = CompilerText.stringOf(bytes);
          match(WmLexer.lex(src)) {
            WmLexer.LexError(message, pos) => { failure(path, src, message, pos) },
            WmLexer.Tokens(tokens, _) => {
              SubsetResult.andThen(
                headerPaths(path, src, implicitBasis(basis, path, tokens)),
                (paths) => {
                  let rec walk = (paths, seen) => {
                    match(paths) {
                      [] => { SubsetResult.Ok(seen) },
                      [(Var(specifier), Var(pos)), ..rest] => {
                        match(resolve(basis, resolved, specifier)) {
                          SubsetResult.Err(error) => {
                            failure(
                              path,
                              src,
                              "cannot resolve import \"" ++ specifier ++ "\": " ++ SubsetIo.errorText(error),
                              pos
                            )
                          },
                          SubsetResult.Ok(child) => {
                            let ModuleProject.Resolved(target, _) = child;
                            if (SubsetList.exists(
                              [resolved, ..active],
                              match {
                                ModuleProject.Resolved(key, _) => { ModuleProject.same(key, target) }
                              }
                            )) {
                              failure(path, src, ModuleProject.cycle([resolved, ..active], child), pos)
                            } else {
                              SubsetResult.andThen(visit(child, [resolved, ..active], seen), (seen) => { walk(rest, seen) })
                            }
                          }
                        }
                      }
                    }
                  };
                  walk(paths, [(id, path, src), ..seen])
                }
              )
            }
          }
        }
      )
    }
  };
  let rec loadRoots = (roots, seen) => {
    match(roots) {
      [] => {
        SubsetResult.Ok(SubsetList.map(SubsetList.reverse(seen), (_, path, src) => { (path, src) }))
      },
      [path, ..rest] => {
        match(ModuleProject.identify(path)) {
          SubsetResult.Err(error) => { failure(path, "", SubsetIo.errorText(error), 0) },
          SubsetResult.Ok(resolved) => {
            SubsetResult.andThen(visit(resolved, [], seen), (seen) => { loadRoots(rest, seen) })
          }
        }
      }
    }
  };
  loadRoots(roots, [])
};

let plan = (sources) => {
  let rec identify = (sources, inputs) => {
    match(sources) {
      [] => { SubsetResult.Ok(SubsetList.reverse(inputs)) },
      [(Var(path), Var(src)), ..rest] => {
        match(ModuleProject.identify(path)) {
          SubsetResult.Err(error) => { failure(path, src, SubsetIo.errorText(error), 0) },
          SubsetResult.Ok(resolved) => {
            let ModuleProject.Resolved(id, _) = resolved;
            if (SubsetList.exists(
              inputs,
              match {
                Input(ModuleProject.Resolved(key, _), _, _) => { ModuleProject.same(key, id) }
              }
            )) { identify(rest, inputs) } else { identify(rest, [Input(resolved, path, src), ..inputs]) }
          }
        }
      }
    }
  };
  let rec allocate = (inputs, used, units) => {
    match(inputs) {
      [] => { SubsetList.reverse(units) },
      [input, ..rest] => {
        let Input(_, path, _) = input;
        let stem = if (CompilerText.isSuffix(path, ".wm")) {
          CompilerText.slice(translateBase(path), 0, CompilerText.size(translateBase(path)) - 3)
        } else { translateBase(path) };
        let rec choose = (suffix) => {
          let candidate = stem ++ suffix;
          let structureName = WmParse.structureName(candidate ++ ".wm");
          if (if (SubsetList.exists(used, (n, f) => { if (n == structureName) { true } else { f == candidate } })) { true } else {
            SubsetList.exists(
              rest,
              match {
                Input(_, path, _) => { WmParse.structureName(path) == structureName }
              }
            )
          }) { choose(suffix ++ "Module") } else { (structureName, candidate) }
        };
        let (structureName, filename) = choose("");
        allocate(
          rest,
          [(structureName, filename), ..used],
          [Unit(input, structureName, filename ++ ".sml"), ..units]
        )
      }
    }
  }
  and translateBase = (path) => {
    match(SubsetList.reverse(CompilerText.fields(path, (c) => { c == '/' }))) {
      [base, .._] => { base },
      [] => { path }
    }
  };
  match(Basis.initial) {
    Unify.Err(message, pos) => { failure("translation", "", message, pos) },
    Unify.Ok(Env.Env(structures, _, _), _) => {
      SubsetResult.map(
        identify(sources, []),
        (inputs) => {
          allocate(inputs, SubsetList.map(structures, (name, _) => { (name, "") }), [])
        }
      )
    }
  }
};

/* Inline record types, `Point{ a: Int32 }` in a type, are shorthand for a `record Point`
   declared just before the statement (docs/syntax-guide.md). Each one is hoisted before its
   top-level statement and replaced by `Point` (with its parameters, `Box<T>`). A repeated or
   already declared name is reused. One inside a block is hoisted as `private`, since Workman
   keeps it out of the module's surface. */
let hoistInlineRecords = (tokens) => {
  let rec declaredNames = (ts) => {
    match(ts) {
      [(WmLexer.WKey("record"), _), (WmLexer.WName([name]), _), ..rest] => { [name, ..declaredNames(rest)] },
      [_, ..rest] => { declaredNames(rest) },
      [] => { [] }
    }
  };
  // Type parameters after `<`, up to and including `>`.
  let rec angle = (ts, acc) => {
    match(ts) {
      [(WmLexer.WKey(">"), Var(p)), ..rest] => {
        Some(SubsetList.reverse([(WmLexer.WKey(">"), p), ..acc]), rest)
      },
      [(WmLexer.WName([v]), Var(p)), ..rest] => { angle(rest, [(WmLexer.WName([v]), p), ..acc]) },
      [(WmLexer.WKey(","), Var(p)), ..rest] => { angle(rest, [(WmLexer.WKey(","), p), ..acc]) },
      _ => { None }
    }
  };
  // The tokens before the `}` closing a field list, and the tokens after it.
  let rec fieldList = (ts, depth, acc) => {
    match(ts) {
      [(WmLexer.WKey("}"), Var(p)), ..rest] => {
        if (depth == 0) { Some(SubsetList.reverse(acc), rest) } else { fieldList(rest, depth - 1, [(WmLexer.WKey("}"), p), ..acc]) }
      },
      [(WmLexer.WKey("{"), Var(p)), ..rest] => { fieldList(rest, depth + 1, [(WmLexer.WKey("{"), p), ..acc]) },
      [(WmLexer.WKey(".{"), Var(p)), ..rest] => { fieldList(rest, depth + 1, [(WmLexer.WKey(".{"), p), ..acc]) },
      [(WmLexer.WEOF, _), .._] => { None },
      [] => { None },
      [t, ..rest] => { fieldList(rest, depth, [t, ..acc]) }
    }
  };
  // An empty inline record `Empty{}` is only recognized after `:` or `->`.
  let typePosition = (prev) => {
    match(prev) {
      Some(WmLexer.WKey(":")) => { true },
      Some(WmLexer.WKey("->")) => { true },
      _ => { false }
    }
  };
  let inlineRecord = (prev, ts) => {
    match(ts) {
      [(WmLexer.WName([name]), Var(p)), ..rest] => {
        if (SubsetBool.not(CompilerText.firstIs(name, SubsetChar.isUpper))) { None } else {
          let parameters = match(rest) {
            [(WmLexer.WKey("<"), Var(q)), ..more] => {
              match(angle(more, [])) {
                Some(ps, after) => { Some([(WmLexer.WKey("<"), q), ..ps], after) },
                None => { None }
              }
            },
            _ => { Some([], rest) }
          };
          match(parameters) {
            None => { None },
            Some(params, after) => {
              match(after) {
                [
                  (WmLexer.WKey("{"), _),
                  (WmLexer.WName([label]), Var(lp)),
                  (WmLexer.WKey(":"), Var(cp)),
                  ..more
                ] => {
                  match(fieldList([(WmLexer.WName([label]), lp), (WmLexer.WKey(":"), cp), ..more], 0, [])) {
                    Some(fields, remaining) => { Some(name, p, params, fields, remaining) },
                    None => { None }
                  }
                },
                [(WmLexer.WKey("{"), _), (WmLexer.WKey("}"), _), ..remaining] => {
                  if (typePosition(prev)) { Some(name, p, params, [], remaining) } else { None }
                },
                _ => { None }
              }
            }
          }
        }
      },
      _ => { None }
    }
  };
  /* Rewrites one statement: its tokens reversed, the hoisted declarations in order, and the
     names declared so far. */
  let rec rewrite = (ts, prev, braces, out, hoisted, seen) => {
    match(ts) {
      [] => { (out, hoisted, seen) },
      [(Var(token), Var(p)), ..rest] => {
        match(inlineRecord(prev, ts)) {
          Some(name, q, params, fields, remaining) => {
            let (fieldsOut, hoisted, seen) = rewrite(fields, None, braces, [], hoisted, seen);
            let known = SubsetList.exists(seen, (n) => { n == name });
            let declaration = SubsetList.concat([
              if (braces > 0) { [(WmLexer.WName(["private"]), q)] } else { [] },
              [(WmLexer.WKey("record"), q), (WmLexer.WName([name]), q)],
              params,
              [(WmLexer.WKey("="), q), (WmLexer.WKey("{"), q)],
              SubsetList.reverse(fieldsOut),
              [(WmLexer.WKey("}"), q), (WmLexer.WKey(";"), q)]
            ]);
            let hoisted = if (known) { hoisted } else { SubsetList.append(hoisted, [declaration]) };
            let seen = if (known) { seen } else { [name, ..seen] };
            let reference = [(WmLexer.WName([name]), q), ..params];
            rewrite(
              remaining,
              Some(WmLexer.WName([name])),
              braces,
              SubsetList.append(SubsetList.reverse(reference), out),
              hoisted,
              seen
            )
          },
          None => {
            let braces = match(token) {
              WmLexer.WKey("{") => { braces + 1 },
              WmLexer.WKey(".{") => { braces + 1 },
              WmLexer.WKey("}") => { braces - 1 },
              _ => { braces }
            };
            rewrite(rest, Some(token), braces, [(token, p), ..out], hoisted, seen)
          }
        }
      }
    }
  };
  // Top-level statements end at a `;` outside brackets.
  let opens = (token) => {
    match(token) {
      WmLexer.WKey("{") => { true },
      WmLexer.WKey(".{") => { true },
      WmLexer.WKey("(") => { true },
      WmLexer.WKey("[") => { true },
      _ => { false }
    }
  };
  let closes = (token) => {
    match(token) {
      WmLexer.WKey("}") => { true },
      WmLexer.WKey(")") => { true },
      WmLexer.WKey("]") => { true },
      _ => { false }
    }
  };
  let rec statements = (ts, depth, current, acc) => {
    match(ts) {
      [] => {
        SubsetList.reverse(if (SubsetList.isEmpty(current)) { acc } else { [SubsetList.reverse(current), ..acc] })
      },
      [(Var(token), Var(p)), ..rest] => {
        if (if (depth == 0) { token == WmLexer.WKey(";") } else { false }) {
          statements(rest, 0, [], [SubsetList.reverse([(token, p), ..current]), ..acc])
        } else {
          statements(
            rest,
            if (opens(token)) { depth + 1 } else { if (closes(token)) { depth - 1 } else { depth } },
            [(token, p), ..current],
            acc
          )
        }
      }
    }
  };
  let (output, _) = SubsetList.foldLeft(
    statements(tokens, 0, [], []),
    ([], declaredNames(tokens)),
    (statement, (output, seen)) => {
      let (out, hoisted, seen) = rewrite(statement, None, 0, [], [], seen);
      (
        SubsetList.append(output, SubsetList.append(SubsetList.concat(hoisted), SubsetList.reverse(out))),
        seen
      )
    }
  );
  output
};

let prepare = (basis, units, unit) => {
  let Unit(Input(resolved, path, src), _, _) = unit;
  let dependency = (specifier, pos) => {
    if (SubsetBool.not(validSpecifier(specifier))) {
      failure(
        path,
        src,
        "imports require explicit relative .wm paths or basis/ modules in the local source profile",
        pos
      )
    } else {
      match(resolve(basis, resolved, specifier)) {
        SubsetResult.Err(error) => {
          failure(
            path,
            src,
            "cannot resolve import \"" ++ specifier ++ "\": " ++ SubsetIo.errorText(error),
            pos
          )
        },
        SubsetResult.Ok(ModuleProject.Resolved(target, _)) => {
          match(SubsetList.find(units, (child) => { ModuleProject.same(identity(child), target) })) {
            None => {
              failure(
                path,
                src,
                "import dependency is not in the supplied source list: " ++ specifier,
                pos
              )
            },
            Some(child) => { SubsetResult.Ok(child) }
          }
        }
      }
    }
  };
  /* The items of `{ a, B as C, }` after its `{`, as (original, alias, position), and the
     tokens after the closing `};`. */
  let rec namedItems = (tokens, items) => {
    match(tokens) {
      [(WmLexer.WKey("}"), _), (WmLexer.WKey(";"), _), ..rest] => { SubsetResult.Ok(SubsetList.reverse(items), rest) },
      [
        (WmLexer.WName([original]), Var(pos)),
        (WmLexer.WKey("as"), _),
        (WmLexer.WName([alias]), _),
        ..rest
      ] => { namedItem(rest, [(original, alias, pos), ..items]) },
      [(WmLexer.WName([original]), Var(pos)), ..rest] => { namedItem(rest, [(original, original, pos), ..items]) },
      [(_, Var(pos)), .._] => {
        failure(path, src, "expected an imported name in `import { ... }`", pos)
      },
      [] => { failure(path, src, "unterminated `import { ... }`", 0) }
    }
  }
  and namedItem = (tokens, items) => {
    match(tokens) {
      [(WmLexer.WKey(","), _), ..rest] => { namedItems(rest, items) },
      _ => { namedItems(tokens, items) }
    }
  };
  /* Whether an earlier named import already bound this value: `opens` holds the injected
     `let name = X.original;` tokens in reverse. */
  let rec boundValue = (opens, alias) => {
    match(opens) {
      [(WmLexer.WName([n]), _), (WmLexer.WKey("let"), _), ..rest] => { if (n == alias) { true } else { boundValue(rest, alias) } },
      [_, ..rest] => { boundValue(rest, alias) },
      [] => { false }
    }
  };
  /* `import *` opens the module. A plain import is private in Workman, so its open is
     marked `private`; `export from` keeps it public. */
  let rec openAll = (specifier, pos, hidden, rest, edges, aliases, named, opens, exported) => {
    SubsetResult.andThen(
      dependency(specifier, pos),
      (child) => {
        let marked = if (hidden) { [(WmLexer.WName(["private"]), pos), ..opens] } else { opens };
        let opened = [(WmLexer.WOpen([[name(child)]]), pos), ..marked];
        let known = SubsetList.exists(
          edges,
          match {
            Edge(_, _, _, target) => { ModuleProject.same(target, identity(child)) }
          }
        );
        if (known) { imports(rest, edges, aliases, named, opened, exported) } else {
          // No alias: an open alone doesn't make the module's name usable as a qualifier.
          imports(
            rest,
            [Edge(specifier, pos, name(child), identity(child)), ..edges],
            aliases,
            named,
            opened,
            exported
          )
        }
      }
    )
  }
  and imports = (tokens, edges, aliases, named, opens, exported) => {
    match(tokens) {
      [
        (WmLexer.WKey("from"), Var(pos)),
        (WmLexer.WScon(Syntax.SString(specifier)), _),
        (WmLexer.WKey("import"), _),
        (WmLexer.WKey("*"), _),
        (WmLexer.WKey("as"), _),
        (WmLexer.WName([alias]), _),
        (WmLexer.WKey(";"), _),
        ..rest
      ] => {
        if (SubsetBool.not(CompilerText.firstIs(alias, SubsetChar.isUpper))) {
          failure(
            path,
            src,
            "namespace aliases must start with an uppercase letter in the initial translation profile",
            pos
          )
        } else {
          if (SubsetList.exists(aliases, (a, _) => { a == alias })) {
            failure(path, src, "duplicate namespace alias " ++ alias, pos)
          } else {
            SubsetResult.andThen(
              dependency(specifier, pos),
              (child) => {
                imports(
                  rest,
                  [Edge(specifier, pos, alias, identity(child)), ..edges],
                  [(alias, name(child)), ..aliases],
                  named,
                  opens,
                  exported
                )
              }
            )
          }
        }
      },
      [
        (WmLexer.WKey("from"), Var(pos)),
        (WmLexer.WScon(Syntax.SString(specifier)), _),
        (WmLexer.WKey("import"), _),
        (WmLexer.WKey("*"), _),
        (WmLexer.WKey(";"), _),
        ..rest
      ] => {
        openAll(specifier, pos, true, rest, edges, aliases, named, opens, exported)
      },
      // `open` already adds to the module's public environment, so this needs nothing further.
      [
        (WmLexer.WName(["export"]), _),
        (WmLexer.WKey("from"), Var(pos)),
        (WmLexer.WScon(Syntax.SString(specifier)), _),
        (WmLexer.WKey("import"), _),
        (WmLexer.WKey("*"), _),
        (WmLexer.WKey(";"), _),
        ..rest
      ] => {
        openAll(specifier, pos, false, rest, edges, aliases, named, opens, exported)
      },
      /* `import { a, B as C }`. A constructor or type is uppercase and can never be a alias
         binding, so its uses are qualified in place. A value may be shadowed, rebound by a
         pattern or spelled like a record label, so it becomes `let a = X.a;` instead. */
      [
        (WmLexer.WKey("from"), Var(pos)),
        (WmLexer.WScon(Syntax.SString(specifier)), _),
        (WmLexer.WKey("import"), _),
        (WmLexer.WKey("{"), _),
        ..rest
      ] => {
        SubsetResult.andThen(
          dependency(specifier, pos),
          (child) => {
            SubsetResult.andThen(
              namedItems(rest, []),
              (items, rest) => {
                let target = name(child);
                let known = SubsetList.exists(
                  edges,
                  match {
                    Edge(_, _, _, key) => { ModuleProject.same(key, identity(child)) }
                  }
                );
                let edges = if (known) { edges } else { [Edge(specifier, pos, target, identity(child)), ..edges] };
                let rec add = (items, named, opens) => {
                  match(items) {
                    [] => { SubsetResult.Ok(named, opens) },
                    [(Var(original), Var(alias), Var(itemPos)), ..more] => {
                      if (if (if (SubsetList.exists(named, (n, _) => { n == alias })) { true } else { SubsetList.exists(aliases, (a, _) => { a == alias }) }) { true } else { boundValue(opens, alias) }) {
                        failure(path, src, "duplicate imported name " ++ alias, itemPos)
                      } else {
                        if (CompilerText.firstIs(alias, SubsetChar.isUpper)) { add(more, [(alias, [target, original]), ..named], opens) } else {
                          add(
                            more,
                            named,
                            [
                              (WmLexer.WKey(";"), itemPos),
                              (WmLexer.WName([target, original]), itemPos),
                              (WmLexer.WKey("="), itemPos),
                              (WmLexer.WName([alias]), itemPos),
                              (WmLexer.WKey("let"), itemPos),
                              // A named import is private in Workman.
                              (WmLexer.WName(["private"]), itemPos),
                              ..opens
                            ]
                          )
                        }
                      }
                    }
                  }
                };
                SubsetResult.andThen(
                  add(items, named, opens),
                  (named, opens) => { imports(rest, edges, aliases, named, opens, exported) }
                )
              }
            )
          }
        )
      },
      [(WmLexer.WKey("from"), Var(pos)), .._] => {
        failure(
          path,
          src,
          "reverse translation currently requires header namespace imports: from \"./file.wm\" import * as Name;",
          pos
        )
      },
      // `structure Alias = Target`. The body's uses are rewritten like a private alias's.
      [
        (WmLexer.WName(["export"]), _),
        (WmLexer.WKey("from"), Var(pos)),
        (WmLexer.WScon(Syntax.SString(specifier)), Var(specifierPos)),
        (WmLexer.WKey("import"), Var(importPos)),
        (WmLexer.WKey("*"), Var(starPos)),
        (WmLexer.WKey("as"), Var(asPos)),
        (WmLexer.WName([alias]), Var(aliasPos)),
        (WmLexer.WKey(";"), Var(endPos)),
        ..rest
      ] => {
        SubsetResult.andThen(
          dependency(specifier, pos),
          (child) => {
            imports(
              [
                (WmLexer.WKey("from"), pos),
                (WmLexer.WScon(Syntax.SString(specifier)), specifierPos),
                (WmLexer.WKey("import"), importPos),
                (WmLexer.WKey("*"), starPos),
                (WmLexer.WKey("as"), asPos),
                (WmLexer.WName([alias]), aliasPos),
                (WmLexer.WKey(";"), endPos),
                ..rest
              ],
              edges,
              aliases,
              named,
              opens,
              [(pos, alias, name(child)), ..exported]
            )
          }
        )
      },
      [(WmLexer.WName(["export"]), _), (WmLexer.WKey("from"), Var(pos)), .._] => {
        failure(
          path,
          src,
          "only `export from \"./file.wm\" import *;` and `import * as Name;` have an SML counterpart",
          pos
        )
      },
      _ => {
        let rec rewrite = (tokens, acc) => {
          match(tokens) {
            [] => { SubsetResult.Ok(SubsetList.reverse(acc)) },
            [(WmLexer.WKey("from"), Var(pos)), .._] => {
              failure(
                path,
                src,
                "imports must precede ordinary declarations in the initial translation profile",
                pos
              )
            },
            [(WmLexer.WName([head, ..tail]), Var(pos)), ..rest] => {
              match(SubsetList.find(named, (alias, _) => { alias == head })) {
                Some(_, qualified) => {
                  rewrite(rest, [(WmLexer.WName(SubsetList.append(qualified, tail)), pos), ..acc])
                },
                None => {
                  match(SubsetList.find(aliases, (alias, _) => { alias == head })) {
                    None => {
                      if (if (SubsetBool.not(SubsetList.isEmpty(tail))) { SubsetList.exists(units, (u) => { name(u) == head }) } else { false }) {
                        failure(
                          path,
                          src,
                          "namespace " ++ head ++ " is not explicitly imported under that name",
                          pos
                        )
                      } else { rewrite(rest, [(WmLexer.WName([head, ..tail]), pos), ..acc]) }
                    },
                    Some(_, target) => {
                      /* A carrier group's namespace, `Result|a, b|`, is the module. Any other
                         bare alias keeps its spelling, marked with its target: as a value it
                         stands for the module's carrier, while in a type or pattern it is the
                         plain name (WmParse.peek). */
                      if (SubsetList.isEmpty(tail)) {
                        match(rest) {
                          [(WmLexer.WKey("|"), _), .._] => { rewrite(rest, [(WmLexer.WName([target]), pos), ..acc]) },
                          [(WmLexer.WKey("<"), _), .._] => { rewrite(rest, [(WmLexer.WName([head]), pos), ..acc]) },
                          _ => {
                            rewrite(rest, [(WmLexer.WName(["`alias", head, target]), pos), ..acc])
                          }
                        }
                      } else {
                        rewrite(rest, [(WmLexer.WName([target, ..tail]), pos), ..acc])
                      }
                    }
                  }
                }
              }
            },
            [token, ..rest] => { rewrite(rest, [token, ..acc]) }
          }
        };
        SubsetResult.map(
          rewrite(tokens, []),
          (body) => {
            (
              SubsetList.reverse(edges),
              SubsetList.reverse(exported),
              SubsetList.append(SubsetList.reverse(opens), body)
            )
          }
        )
      }
    }
  };
  match(WmLexer.lex(src)) {
    WmLexer.LexError(message, pos) => { failure(path, src, message, pos) },
    WmLexer.Tokens(tokens, comments) => {
      SubsetResult.map(
        imports(implicitBasis(basis, path, tokens), [], [], [], [], []),
        (edges, exported, body) => {
          Source(
            unit,
            edges,
            exported,
            WmLexer.Tokens(
              hoistInlineRecords(body),
              SubsetList.filter(
                comments,
                (_, body, _) => {
                  if (match(ModuleImports.marked(body)) {
                    None => { true },
                    Some(_) => { false }
                  }) { SubsetBool.not(ModuleImports.isGeneratedHeader(body)) } else { false }
                }
              )
            )
          )
        }
      )
    }
  }
};

let order = (sources) => {
  let rec visit = (source, active, completed) => {
    let unit = sourceUnit(source);
    if (SubsetList.exists(
      completed,
      (s) => { ModuleProject.same(identity(sourceUnit(s)), identity(unit)) }
    )) { SubsetResult.Ok(completed) } else {
      let rec walk = (edges, completed) => {
        match(edges) {
          [] => { SubsetResult.Ok([source, ..completed]) },
          [Edge(specifier, pos, _, target), ..rest] => {
            if (SubsetList.exists([unit, ..active], (u) => { ModuleProject.same(identity(u), target) })) {
              failure(
                pathOf(unit),
                textOf(unit),
                "import cycle: " ++ SubsetString.concatWith(
                  SubsetList.append(SubsetList.map(SubsetList.reverse([unit, ..active]), pathOf), [specifier]),
                  " -> "
                ),
                pos
              )
            } else {
              match(SubsetList.find(sources, (s) => { ModuleProject.same(identity(sourceUnit(s)), target) })) {
                None => {
                  failure(pathOf(unit), textOf(unit), "internal error: missing resolved dependency", pos)
                },
                Some(child) => {
                  SubsetResult.andThen(visit(child, [unit, ..active], completed), (done) => { walk(rest, done) })
                }
              }
            }
          }
        }
      };
      walk(edgesOf(source), completed)
    }
  };
  let rec roots = (remaining, completed) => {
    match(remaining) {
      [] => { SubsetResult.Ok(SubsetList.reverse(completed)) },
      [source, ..rest] => {
        SubsetResult.andThen(visit(source, [], completed), (done) => { roots(rest, done) })
      }
    }
  };
  roots(sources, [])
};

let imported = (units, unit, edges) => {
  let rec loop = (edges, seen) => {
    match(edges) {
      [] => { SubsetResult.Ok(SubsetList.reverse(seen)) },
      [Edge(_, pos, _, target), ..rest] => {
        match(SubsetList.find(units, (child) => { ModuleProject.same(identity(child), target) })) {
          None => {
            failure(pathOf(unit), textOf(unit), "internal error: missing resolved dependency", pos)
          },
          Some(child) => {
            loop(
              rest,
              if (SubsetList.exists(seen, (u) => { ModuleProject.same(identity(u), target) })) { seen } else { [child, ..seen] }
            )
          }
        }
      }
    }
  };
  loop(edges, [])
};

type Adapter = | Adapter<ModuleProject.ModuleId, String, String>;

let structureIdentifier = (value) => {
  match(Lexer.lex(value)) {
    Lexer.Tokens([(Lexer.TId(identifier), _), (Lexer.TEOF, _)], _) => {
      if (identifier == value) {
        SubsetChar.isAlpha(CompilerText.sub(CompilerText.source(identifier), 0))
      } else { false }
    },
    _ => { false }
  }
};

let adapters = (units, specifications) => {
  let rec resolve = (remaining, seen) => {
    match(remaining) {
      [] => { SubsetResult.Ok(SubsetList.reverse(seen)) },
      [(Var(checker), Var(native), Var(exported)), ..rest] => {
        if (SubsetBool.not(structureIdentifier(exported))) {
          failure(checker, "", "native adapter export must be an SML structure identifier", 0)
        } else {
          SubsetResult.andThen(
            match(ModuleProject.identify(checker)) {
              SubsetResult.Err(error) => { failure(checker, "", SubsetIo.errorText(error), 0) },
              SubsetResult.Ok(ModuleProject.Resolved(id, _)) => {
                if (SubsetBool.not(SubsetList.exists(units, (unit) => { ModuleProject.same(identity(unit), id) }))) {
                  failure(checker, "", "native adapter checker is not in the entry graph", 0)
                } else {
                  if (SubsetList.exists(
                    seen,
                    match {
                      Adapter(key, _, _) => { ModuleProject.same(id, key) }
                    }
                  )) {
                    failure(checker, "", "duplicate native adapter selection", 0)
                  } else {
                    match(ModuleProject.identify(native)) {
                      SubsetResult.Err(error) => { failure(native, "", SubsetIo.errorText(error), 0) },
                      SubsetResult.Ok(ModuleProject.Resolved(_, path)) => {
                        match(SubsetIo.readFile(path)) {
                          SubsetResult.Err(error) => { failure(native, "", SubsetIo.errorText(error), 0) },
                          SubsetResult.Ok(_) => { SubsetResult.Ok(Adapter(id, path, exported)) }
                        }
                      }
                    }
                  }
                }
              }
            },
            (adapter) => { resolve(rest, [adapter, ..seen]) }
          )
        }
      }
    }
  };
  resolve(specifications, [])
};

/* One basis instance per canonical module. A module's body receives the standard Basis
   and only its direct dependencies; the `in` part exports only its own structure.
   Native implementations use source import aliases in separately captured basis scopes. */
let mlb = (units, sources, modules, entry, adapters) => {
  let scopeName = (name) => { "SubsetBuild_" ++ name };
  let rec emit = (modules) => {
    match(modules) {
      [] => { SubsetResult.Ok("") },
      [(Var(name), Var(dependencies), _), ..rest] => {
        match(SubsetList.find(units, (unit) => { nameOf(unit) == name })) {
          None => {
            failure("translation", "", "missing build module " ++ name, 0)
          },
          Some(unit) => {
            let selected = SubsetList.find(
              adapters,
              match {
                Adapter(id, _, _) => { ModuleProject.same(identity(unit), id) }
              }
            );
            let body = match(selected) {
              None => {
                SubsetResult.Ok("      open SubsetBuild_Standard" ++ SubsetString.concat(SubsetList.map(dependencies, (name) => { " " ++ scopeName(name) })) ++ "\n    in\n      \"" ++ CompilerText.escapeSmlString(output(unit)) ++ "\"\n")
              },
              Some(Adapter(_, native, exported)) => {
                match(SubsetList.find(
                  sources,
                  (source) => {
                    ModuleProject.same(identity(sourceUnit(source)), identity(unit))
                  }
                )) {
                  None => {
                    failure(pathOf(unit), "", "missing native adapter imports", 0)
                  },
                  Some(source) => {
                    let rec aliases = (edges) => {
                      match(edges) {
                        [] => { SubsetResult.Ok("", "") },
                        [Edge(_, pos, alias, target), ..rest] => {
                          if (SubsetBool.not(structureIdentifier(alias))) {
                            failure(
                              pathOf(unit),
                              textOf(unit),
                              "native adapter import alias must be an SML structure identifier",
                              pos
                            )
                          } else {
                            match(SubsetList.find(units, (child) => { ModuleProject.same(identity(child), target) })) {
                              None => {
                                failure(pathOf(unit), "", "missing native adapter dependency", 0)
                              },
                              Some(child) => {
                                SubsetResult.map(
                                  aliases(rest),
                                  (declarations, opens) => {
                                    (
                                      "      basis SubsetNative_" ++ alias ++ " = bas local open " ++ scopeName(nameOf(child)) ++ " in structure " ++ alias ++ " = " ++ nameOf(child) ++ " end end\n" ++ declarations,
                                      " SubsetNative_" ++ alias ++ opens
                                    )
                                  }
                                )
                              }
                            }
                          }
                        }
                      }
                    };
                    SubsetResult.map(
                      aliases(edgesOf(source)),
                      (declarations, opens) => {
                        "      open SubsetBuild_Standard\n" ++ declarations ++ "      open SubsetBuild_Standard" ++ opens ++ "\n    in\n      local\n        \"" ++ CompilerText.escapeSmlString(native) ++ "\"\n      in\n        structure " ++ name ++ " = " ++ exported ++ "\n      end\n"
                      }
                    )
                  }
                }
              }
            };
            SubsetResult.andThen(
              body,
              (body) => {
                SubsetResult.map(
                  emit(rest),
                  (text) => {
                    "  basis " ++ scopeName(name) ++ " = bas\n    local\n" ++ body ++ "    end\n  end\n" ++ text
                  }
                )
              }
            )
          }
        }
      }
    }
  }
  and nameOf = (unit) => { name(unit) };
  SubsetResult.map(
    emit(modules),
    (text) => {
      "local\n  basis SubsetBuild_Standard = bas $(SML_LIB)/basis/basis.mlb end\n" ++ text ++ "in\n  open SubsetBuild_Standard " ++ scopeName(name(entry)) ++ "\nend\n"
    }
  )
};

let metadata = (dependencies) => {
  if (SubsetList.isEmpty(dependencies)) { "" } else {
    "(* @subsetml\n" ++ SubsetString.concat(SubsetList.map(
      dependencies,
      (unit) => {
        "from \"./" ++ output(unit) ++ "\" import * as " ++ name(unit) ++ ";\n"
      }
    )) ++ "*)\n\n"
  }
};
