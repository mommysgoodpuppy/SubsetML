// Module references after lexical resolution, including type-only dependencies.
let moduleReferences = (program) => {
  let flat = (xs, f) => { SubsetList.concat(SubsetList.map(xs, f)) };
  let id = (qs, _) => {
    match(qs) {
      [head, .._] => { [head] },
      [] => { [] }
    }
  };
  let rec ty = (t) => {
    match(t) {
      TyCon(args, name) => { SubsetList.append(id(name), flat(args, ty)) },
      TyTuple(ts) => { flat(ts, ty) },
      TyArrow(a, b) => { SubsetList.append(ty(a), ty(b)) },
      TyRecord(fs) => { flat(fs, (_, t) => { ty(t) }) },
      _ => { [] }
    }
  };
  let rec pat = (p) => {
    match(p) {
      PId(_, name) => { id(name) },
      PPinned(_, name) => { id(name) },
      PComputed(_, e) => { exp(e) },
      PApp(_, name, p) => { SubsetList.append(id(name), pat(p)) },
      PRecord(_, fs) => { flat(fs, (_, p) => { pat(p) }) },
      PTuple(ps) => { flat(ps, pat) },
      PList(ps) => { flat(ps, pat) },
      PTyped(p, t) => { SubsetList.append(pat(p), ty(t)) },
      _ => { [] }
    }
  }
  and exp = (e) => {
    match(e) {
      EId(_, name) => { id(name) },
      ERecord(_, fs) => { flat(fs, (_, e) => { exp(e) }) },
      ETuple(es) => { flat(es, exp) },
      EList(es) => { flat(es, exp) },
      ESeq(es) => { flat(es, exp) },
      ELet(ds, es) => { SubsetList.append(flat(ds, dec), flat(es, exp)) },
      EApp(a, b) => { SubsetList.append(exp(a), exp(b)) },
      ETyped(e, t) => { SubsetList.append(exp(e), ty(t)) },
      EAndalso(a, b) => { SubsetList.append(exp(a), exp(b)) },
      EOrelse(a, b) => { SubsetList.append(exp(a), exp(b)) },
      EIf(c, a, b) => { flat([c, a, b], exp) },
      ECase(e, rs) => { SubsetList.append(exp(e), rules(rs)) },
      EFn(rs) => { rules(rs) },
      ECopy(_, a, b, t) => { SubsetList.concat([exp(a), exp(b), ty(t)]) },
      _ => { [] }
    }
  }
  and rules = (rs) => { flat(rs, (p, e) => { SubsetList.append(pat(p), exp(e)) }) }
  and dec = (d) => {
    match(d) {
      DVal(_, _, plain, recs) => { rules(SubsetList.append(plain, recs)) },
      DType(_, bs) => { flat(bs, (_, _, t) => { ty(t) }) },
      DDatatype(_, bs) => {
        flat(
          bs,
          (_, _, cs) => {
            flat(
              cs,
              (_, _, t) => {
                match(t) {
                  Some(t) => { ty(t) },
                  None => { [] }
                }
              }
            )
          }
        )
      },
      DOpen(_, paths) => {
        flat(
          paths,
          (path) => {
            match(path) {
              [head, .._] => { [head] },
              [] => { [] }
            }
          }
        )
      },
      DLocal(_, hidden, body) => { flat(SubsetList.append(hidden, body), dec) }
    }
  };
  let names = flat(
    program,
    (phrase) => {
      match(phrase) {
        TopExp(_, e) => { exp(e) },
        TopDecs(ss) => {
          flat(
            ss,
            (s) => {
              match(s) {
                SDec(d) => { dec(d) },
                SStructure(_, bs) => {
                  flat(
                    bs,
                    (_, aliases, ds) => {
                      SubsetList.append(SubsetList.map(aliases, (_, _, target) => { target }), flat(ds, dec))
                    }
                  )
                }
              }
            }
          )
        }
      }
    }
  );
  SubsetList.foldLeft(
    names,
    [],
    (n, found) => { if (member(found, n)) { found } else { [n, ..found] } }
  )
};

/* Closed native projects need no unused library function definitions. In particular, a
   generic WM display function has no SML implementation until its argument's display is
   known. Retain every entry/user function and every library initializer; remove only
   unused library lambda bindings. Reference collection is deliberately conservative about
   local shadowing and opens. No effectful initializer is a candidate for removal. */
let pruneLibraries = (libraries, modules) => {
  let flat = (xs, f) => { SubsetList.concat(SubsetList.map(xs, f)) };
  let rec patternRefs = (p) => {
    match(p) {
      PComputed(_, e) => { expressionRefs(e) },
      PPinned(_, id) => { [id] },
      PId(_, (Var(qs), Var(n))) => { if (SubsetList.isEmpty(qs)) { [] } else { [(qs, n)] } },
      PApp(_, id, p) => { [id, ..patternRefs(p)] },
      PRecord(_, fs) => { flat(fs, (_, p) => { patternRefs(p) }) },
      PTuple(ps) => { flat(ps, patternRefs) },
      PList(ps) => { flat(ps, patternRefs) },
      PTyped(p, _) => { patternRefs(p) },
      _ => { [] }
    }
  }
  and expressionRefs = (e) => {
    match(e) {
      EId(_, id) => { [id] },
      ERecord(_, fs) => { flat(fs, (_, e) => { expressionRefs(e) }) },
      ETuple(es) => { flat(es, expressionRefs) },
      EList(es) => { flat(es, expressionRefs) },
      ESeq(es) => { flat(es, expressionRefs) },
      ELet(ds, es) => {
        SubsetList.append(flat(ds, declarationRefs), flat(es, expressionRefs))
      },
      EApp(a, b) => { SubsetList.append(expressionRefs(a), expressionRefs(b)) },
      ETyped(e, _) => { expressionRefs(e) },
      EAndalso(a, b) => { SubsetList.append(expressionRefs(a), expressionRefs(b)) },
      EOrelse(a, b) => { SubsetList.append(expressionRefs(a), expressionRefs(b)) },
      EIf(c, a, b) => { flat([c, a, b], expressionRefs) },
      ECase(e, rs) => { SubsetList.append(expressionRefs(e), ruleRefs(rs)) },
      EFn(rs) => { ruleRefs(rs) },
      ECopy(_, a, b, _) => { SubsetList.append(expressionRefs(a), expressionRefs(b)) },
      _ => { [] }
    }
  }
  and ruleRefs = (rs) => {
    flat(rs, (p, e) => { SubsetList.append(patternRefs(p), expressionRefs(e)) })
  }
  and declarationRefs = (d) => {
    match(d) {
      DVal(_, _, plain, recs) => { ruleRefs(SubsetList.append(plain, recs)) },
      DLocal(_, hidden, body) => { flat(SubsetList.append(hidden, body), declarationRefs) },
      _ => { [] }
    }
  };
  let functionNames = (d) => {
    match(d) {
      DVal(_, _, plain, recs) => {
        let bs = SubsetList.append(plain, recs);
        if (SubsetList.all(
          bs,
          match {
            (PId(_, ([], _)), EFn(_)) => { true },
            _ => { false }
          }
        )) {
          flat(
            bs,
            match {
              (PId(_, ([], Var(n))), _) => { [n] },
              _ => { [] }
            }
          )
        } else { [] }
      },
      _ => { [] }
    }
  };
  let rec flatten = (ds) => {
    flat(
      ds,
      (d) => {
        match(d) {
          DLocal(_, hidden, body) => { flatten(SubsetList.append(hidden, body)) },
          _ => { [d] }
        }
      }
    )
  };
  let contents = flat(
    modules,
    (owner, _, (_, _, prog, _)) => {
      flat(
        prog,
        (phrase) => {
          match(phrase) {
            TopDecs(ss) => {
              flat(
                ss,
                (s) => {
                  match(s) {
                    SStructure(_, bs) => {
                      flat(bs, (_, aliases, ds) => { [(owner, aliases, flatten(ds))] })
                    },
                    SDec(d) => { [(owner, [], flatten([d]))] }
                  }
                }
              )
            },
            TopExp(_, e) => { [(owner, [], [DVal(0, [], [(PWild, e)], [])])] }
          }
        }
      )
    }
  );
  let nodes = flat(
    contents,
    (owner, _, ds) => {
      flat(
        ds,
        (d) => {
          SubsetList.map(functionNames(d), (n) => { ((owner, n), declarationRefs(d)) })
        }
      )
    }
  );
  let opens = flat(
    contents,
    (owner, _, ds) => {
      flat(
        ds,
        (d) => {
          match(d) {
            DOpen(_, paths) => {
              flat(
                paths,
                match {
                  [target] => { [(owner, target)] },
                  _ => { [] }
                }
              )
            },
            _ => { [] }
          }
        }
      )
    }
  );
  let aliases = flat(
    contents,
    (owner, aliases, _) => {
      SubsetList.map(aliases, (_, alias, target) => { (owner, alias, target) })
    }
  );
  let rec qualify = (owner, (qs, n)) => {
    match(qs) {
      [] => { [(owner, n)] },
      [target] => { [(target, n)] },
      [head, alias, ..tail] => {
        match(SubsetList.find(
          aliases,
          (moduleName, name, _) => { if (moduleName == head) { name == alias } else { false } }
        )) {
          Some(_, _, target) => { qualify(owner, ([target, ..tail], n)) },
          None => { SubsetList.map(nodes, (key, _) => { key }) }
        }
      }
    }
  };
  let roots = flat(
    contents,
    (owner, _, ds) => {
      flat(
        ds,
        (d) => {
          if (if (member(libraries, owner)) { SubsetBool.not(SubsetList.isEmpty(functionNames(d))) } else { false }) { [] } else { flat(declarationRefs(d), (id) => { qualify(owner, id) }) }
        }
      )
    }
  );
  let roots = SubsetList.append(
    roots,
    flat(
      aliases,
      (_, _, target) => {
        flat(
          nodes,
          (key, _) => {
            let (owner, _) = key;
            if (owner == target) { [key] } else { [] }
          }
        )
      }
    )
  );
  let roots = SubsetList.append(
    roots,
    flat(
      opens,
      (owner, target) => {
        if (member(libraries, owner)) { [] } else { SubsetList.map(nodes, ((_, n), _) => { (target, n) }) }
      }
    )
  );
  let sameKey = (((a: String), (b: String)), ((c: String), (d: String))) => { if (a == c) { b == d } else { false } };
  let rec reach = (todo: List<(String, String)>, seen: List<(String, String)>) => {
    match(todo) {
      [] => { seen },
      [key, ..rest] => {
        if (SubsetList.exists(seen, (k) => { sameKey(k, key) })) { reach(rest, seen) } else {
          let (owner, n) = key;
          let direct = flat(
            SubsetList.filter(nodes, (k, _) => { sameKey(k, key) }),
            (_, ids) => { flat(ids, (id) => { qualify(owner, id) }) }
          );
          let opened = flat(
            SubsetList.filter(opens, (moduleName, _) => { moduleName == owner }),
            (_, target) => { [(target, n)] }
          );
          reach(SubsetList.concat([direct, opened, rest]), [key, ..seen])
        }
      }
    }
  };
  let used = reach(roots, []);
  let rec prune = (owner, ds) => {
    flat(
      ds,
      (d) => {
        match(d) {
          DLocal(p, hidden, body) => {
            let hidden = prune(owner, hidden);
            let body = prune(owner, body);
            if (SubsetList.isEmpty(hidden)) { body } else { [DLocal(p, hidden, body)] }
          },
          _ => {
            let names = functionNames(d);
            if (if (SubsetList.isEmpty(names)) { true } else {
              SubsetList.exists(
                names,
                (n) => {
                  SubsetList.exists(used, (key) => { sameKey(key, (owner, n)) })
                }
              )
            }) { [d] } else { [] }
          }
        }
      }
    )
  };
  SubsetList.map(
    modules,
    (owner, deps, (path, src, prog, cs)) => {
      (
        owner,
        deps,
        (
          path,
          src,
          if (member(libraries, owner)) {
            SubsetList.map(
              prog,
              (phrase) => {
                match(phrase) {
                  TopDecs(ss) => {
                    TopDecs(SubsetList.map(
                      ss,
                      (s) => {
                        match(s) {
                          SStructure(p, bs) => {
                            SStructure(p, SubsetList.map(bs, (n, aliases, ds) => { (n, aliases, prune(owner, ds)) }))
                          },
                          _ => { s }
                        }
                      }
                    ))
                  },
                  _ => { phrase }
                }
              }
            )
          } else { prog },
          cs
        )
      )
    }
  )
};
