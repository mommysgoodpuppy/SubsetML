/* @subsetml
from "./subset_option_value.sml" import * as SubsetOptionValue;
from "./syntax.sml" import * as Syntax;
from "./subset_string.sml" import * as SubsetString;
from "./subset_list.sml" import * as SubsetList;
from "./compiler_text.sml" import * as CompilerText;
from "./sml_list.sml" import * as SmlList;
*/

// Prints abstract syntax as S-expressions, for tests and debugging.

from "./subset_option_value.wm" import * as SubsetOptionValue;
from "./syntax.wm" import * as Syntax;
from "./subset_string.wm" import * as SubsetString;
from "./subset_list.wm" import * as SubsetList;
from "./compiler_text.wm" import * as CompilerText;
from "./sml_list.wm" import * as SmlList;

from "./subset_option_value.wm" import *;

from "./syntax.wm" import *;

let node = (name, parts) => { "(" ++ SubsetString.concatWith([name, ..parts], " ") ++ ")" };

let longid = (quals, id) => { SubsetString.concatWith(SubsetList.append(quals, [id]), ".") };

let scon = match {
  SInt(s) => { s },
  SReal(s) => { s },
  SString(s) => { "\"" ++ CompilerText.escapeSmlString(s) ++ "\"" },
  SChar(c) => { "#\"" ++ CompilerText.escapeSmlChar(c) ++ "\"" }
};

let rec ty = match {
  TyVar(v) => { v },
  TyCon([], id) => { longid(id) },
  TyCon(args, id) => { node(longid(id), SmlList.map(ty)(args)) },
  TyTuple(ts) => { node("*", SmlList.map(ty)(ts)) },
  TyArrow(a, b) => { node("->", [ty(a), ty(b)]) },
  TyRecord(fields) => {
    node("record", SmlList.map((l, t) => { node(l, [ty(t)]) })(fields))
  }
};

let rec pat = match {
  PWild => { "_" },
  PScon(_, c) => { scon(c) },
  PId(_, id) => { longid(id) },
  PPinned(_, id) => { node("pin", [longid(id)]) },
  PRecord(_, fields) => {
    node("record", SmlList.map((l, p) => { node(l, [pat(p)]) })(fields))
  },
  PTuple(ps) => { node("tuple", SmlList.map(pat)(ps)) },
  PList(ps) => { node("list", SmlList.map(pat)(ps)) },
  PApp(_, id, arg) => { node(longid(id), [pat(arg)]) },
  PTyped(p, t) => { node(":", [pat(p), ty(t)]) }
};

let tyvars = (vs) => { node("tyvars", vs) };

let con = match {
  (_, Var(c), None) => { c },
  (_, Var(c), Some(t)) => { node(c, [ty(t)]) }
};

let rec exp = match {
  EScon(_, c) => { scon(c) },
  EId(_, id) => { longid(id) },
  ERecord(_, fields) => {
    node("record", SmlList.map((l, e) => { node(l, [exp(e)]) })(fields))
  },
  ESelect(_, l) => { "#" ++ l },
  ECopy(_, source, _, _) => { exp(source) },
  ETuple(es) => { node("tuple", SmlList.map(exp)(es)) },
  EList(es) => { node("list", SmlList.map(exp)(es)) },
  ESeq(es) => { node("seq", SmlList.map(exp)(es)) },
  ELet(ds, es) => {
    node("let", [node("decs", SmlList.map(dec)(ds)), node("in", SmlList.map(exp)(es))])
  },
  EApp(f, a) => { node("app", [exp(f), exp(a)]) },
  ETyped(e, t) => { node(":", [exp(e), ty(t)]) },
  EAndalso(a, b) => { node("andalso", [exp(a), exp(b)]) },
  EOrelse(a, b) => { node("orelse", [exp(a), exp(b)]) },
  EIf(c, a, b) => { node("if", [exp(c), exp(a), exp(b)]) },
  ECase(e, m) => { node("case", [exp(e), ..SmlList.map(rule)(m)]) },
  EFn(m) => { node("fn", SmlList.map(rule)(m)) }
}

and rule = (p, e) => { node("=>", [pat(p), exp(e)]) }

and binding = (p, e) => { node("=", [pat(p), exp(e)]) }

and dec = match {
  DVal(_, vs, plain, recs) => {
    node(
      "val",
      SubsetList.concat([
        [tyvars(vs)],
        SmlList.map(binding)(plain),
        if (SmlList.null(recs)) { [] } else { [node("rec", SmlList.map(binding)(recs))] }
      ])
    )
  },
  DType(_, bs) => {
    node(
      "type",
      SmlList.map((vs, tycon, t) => { node(tycon, [tyvars(vs), ty(t)]) })(bs)
    )
  },
  DDatatype(_, bs) => {
    node(
      "datatype",
      SmlList.map((vs, tycon, cs) => { node(tycon, [tyvars(vs), ..SmlList.map(con)(cs)]) })(bs)
    )
  },
  DOpen(_, ids) => {
    node("open", SubsetList.map(ids, (id) => { SubsetString.concatWith(id, ".") }))
  }
};

let strdec = match {
  SDec(d) => { dec(d) },
  SStructure(_, bs) => {
    node(
      "structure",
      SmlList.map((name, ds) => { node(name, SmlList.map(dec)(ds)) })(bs)
    )
  }
};

let topdec = match {
  TopDecs(sds) => { SubsetString.concatWith(SubsetList.map(sds, strdec), " ") },
  TopExp(_, e) => { node("it", [exp(e)]) }
};
