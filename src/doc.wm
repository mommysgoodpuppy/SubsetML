/* Layout shared by the source printers.

   A document is a non-empty list of lines. Each line has an indentation relative to the
   document's first line, its text, and the source offset of the earliest node printed on it.
   The offsets let `render` put the source comments and blank lines back in place. */

from "./syntax.wm" import * as Syntax;
from "./sml_list.wm" import * as SmlList;
from "./sml_option.wm" import * as SmlOption;
from "./compiler_text.wm" import * as CompilerText;
from "./subset_list.wm" import * as SubsetList;
from "./subset_bytes.wm" import * as SubsetBytes;
from "./subset_char.wm" import * as SubsetChar;
from "./subset_result.wm" import * as SubsetResult;
from "./subset_source.wm" import * as SubsetSource;
from "./subset_string.wm" import * as SubsetString;

from "./syntax.wm" import *;

type Line = (Number, String, Option<Pos>);

type Doc = List<Line>;

// Lines up to this width stay on one line where the printers have a choice.
let width = 80;

let text = (s) => { [(0, s, None)] };

let atom = (p, s) => { [(0, s, Some(p))] };

let empty = text("");

let minTag = match {
  (None, Var(b)) => { b },
  (Var(a), None) => { a },
  (Some(a), Some(b)) => { Some(if ((a: Number) <= b) { a } else { b }) }
};

/* Horizontal composition: b continues the last line of a, and b's later lines are indented
   relative to that line. */
let cat = (a: Doc, b: Doc) => {
  match(SmlList.rev(a), b) {
    ([(Var(ia), Var(ta), Var(pa)), ..restA], [(_, Var(tb), Var(pb)), ..restB]) => {
      SmlList.revAppend(
        restA,
        [
          (ia, ta ++ tb, minTag(pa, pb)),
          ..SmlList.map((i, t, p) => { (i + ia, t, p) })(restB)
        ]
      )
    },
    _ => { List.append(a, b) }
  }
};

let cats = (ds) => { SmlList.foldl((d, acc) => { cat(acc, d) })(empty)(ds) };

let indent = (n: Number, d: Doc) => { SmlList.map((i, t, p) => { (i + n, t, p) })(d) };

// Vertical composition.
let stack = (ds) => { SmlList.concat(ds) };

// The text of a one-line document.
let flat = match {
  [(Var(ignoredIndent), Var(t), Var(ignoredTag))] => { Some(t) },
  _ => { None }
};

let isFlat = (d) => { SmlOption.isSome(flat(d)) };

let fits = (d) => {
  match(flat(d)) {
    Some(t) => { CompilerText.size(t) <= width },
    None => { false }
  }
};

// `ds` joined by `sep` on one line.
let join = (sep, ds) => {
  match(ds) {
    [] => { empty },
    [d, ..rest] => {
      SmlList.foldl((d, acc) => { cats([acc, text(sep), d]) })(d)(rest)
    }
  }
};

/* Items between delimiters, separated by `sep`: on one line when that fits, otherwise one
   item per line. */
let group = (openD, sep, closeD, ds) => {
  let oneLine = cats([text(openD), join(sep ++ " ", ds), text(closeD)]);
  if (if (fits(oneLine)) { true } else { SmlList.null(ds) }) { oneLine } else {
    let count = SubsetList.length(ds);
    let rec items = match {
      (_, []) => { [] },
      (Var(i), [d, ..rest]) => {
        [if (i < count - 1) { cat(d, text(sep)) } else { d }, ..items(i + 1, rest)]
      }
    };
    stack([text(openD), indent(2, stack(items(0, ds))), text(closeD)])
  }
};

// ---------------------------------------------------------------------------------------
// Rendering

let trim = (s) => {
  CompilerText.stringOf(SubsetBytes.trim(CompilerText.characters(s), SubsetChar.isSpace))
};

let spaces = (n) => {
  let SubsetResult.Ok(bytes) = SubsetList.repeat(' ', n);
  CompilerText.stringOf(bytes)
};

let isBlankText = (s) => { SmlList.all(SubsetChar.isSpace)(CompilerText.characters(s)) };

// Offset of the start of the line containing offset i.
let lineStart = (src, i) => {
  let rec back = (k) => {
    if (k <= 0) { 0 } else {
      if (CompilerText.sub(src, k - 1) == '\n') { k } else { back(k - 1) }
    }
  };
  back(if (i <= SubsetSource.length(src)) { i } else { SubsetSource.length(src) })
};

// Whether the source line before the one containing offset i is blank.
let blankLineBefore = (src, i) => {
  let start = lineStart(src, i);
  if (start > 0) {
    let prev = lineStart(src, start - 1);
    let SubsetResult.Ok(bytes) = SubsetSource.slice(src, prev, start - 1 - prev);
    SubsetList.all(bytes, SubsetChar.isSpace)
  } else { false }
};

// Lines of a comment, re-indented. `style` turns the comment's lines into output lines.
let commentLines = (src, (p, body, _), style) => {
  let column = p - lineStart(src, p);
  let strip = (bytes) => {
    let rec drop = match {
      ([], Var(remaining)) => { [] },
      ([c, ..rest], Var(remaining)) => {
        if (if (remaining > 0) { c == ' ' } else { false }) { drop(rest, remaining - 1) } else { [c, ..rest] }
      }
    };
    CompilerText.stringOf(drop(bytes, column))
  };
  let lines = SubsetBytes.fields(CompilerText.characters(body), (c) => { c == '\n' });
  match(lines) {
    [] => { style([]) },
    [first, ..rest] => {
      style([CompilerText.stringOf(first), ..SmlList.map(strip)(rest)])
    }
  }
};

/* Renders lines, inserting each comment before the first line tagged after it. A trailing
   comment joins the last tagged line instead. `style` formats a comment's lines. */
let render = (src, comments, style, lines) => {
  let src = CompilerText.source(src);
  // acc holds the output lines in reverse, each with whether it carries a tag.
  let appendTrailing = (acc, s) => {
    let rec go = match {
      ([], _) => { None },
      ([(Var(t), true), ..rest], Var(seen)) => {
        Some(SmlList.revAppend(seen, [(t ++ " " ++ s, true), ..rest]))
      },
      ([l, ..rest], Var(seen)) => { go(rest, [l, ..seen]) }
    };
    go(acc, [])
  };

  let blankIfNeeded = (acc, lastTag, p) => {
    match(acc) {
      [(Var(t), _), .._] => {
        if (if (if (blankLineBefore(src, p)) { lastTag < lineStart(src, p) } else { false }) { !isBlankText(t) } else { false }) { [("", false), ..acc] } else { acc }
      },
      [] => { acc }
    }
  };

  let emitComment = (acc, lastTag, ind, c) => {
    let (p, _, isTrailing) = c;
    match(isTrailing, appendTrailing(acc, SubsetString.concatWith(commentLines(src, c, style), " "))) {
      (true, Some(acc')) => { acc' },
      _ => {
        SmlList.foldl((l, acc) => { [(spaces(ind) ++ l, false), ..acc] })(blankIfNeeded(acc, lastTag, p))(commentLines(src, c, style))
      }
    }
  };

  let rec flush = (acc, lastTag, ind, limit, cs) => {
    match(cs) {
      [c, ..rest] => {
        let (p, ignoredBody, ignoredTrailing) = c;
        if (p < limit) {
          flush(emitComment(acc, lastTag, ind, c), p, ind, limit, rest)
        } else { (acc, lastTag, cs) }
      },
      [] => { (acc, lastTag, cs) }
    }
  };

  /* A file's leading comment is always followed by one blank line, whatever the source
     had, so that translating back and forth keeps the same layout. */
  let afterHeader = (acc) => {
    match(acc) {
      [(Var(t), _), .._] => { if (isBlankText(t)) { acc } else { [("", false), ..acc] } },
      [] => { acc }
    }
  };

  let rec go = (ls, acc, lastTag, cs, seenCode) => {
    match(ls) {
      [] => {
        let (acc', ignoredTag, ignoredComments) = flush(acc, lastTag, 0, SubsetSource.length(src) + 1, cs);
        acc'
      },
      [(Var(ind), Var(t), None), ..rest] => {
        go(rest, [(spaces(ind) ++ t, false), ..acc], lastTag, cs, seenCode)
      },
      [(Var(ind), Var(t), Some(p)), ..rest] => {
        let (acc1, lastTag1, cs1) = flush(acc, lastTag, ind, p, cs);
        let acc2 = if (seenCode) { blankIfNeeded(acc1, lastTag1, p) } else { afterHeader(acc1) };
        go(
          rest,
          [(spaces(ind) ++ t, true), ..acc2],
          if (p >= lastTag1) { p } else { lastTag1 },
          cs1,
          true
        )
      }
    }
  };
  SubsetString.concat(SmlList.map((t, _) => { t ++ "\n" })(SmlList.rev(go(lines, [], -1, comments, false))))
};
