    (#"\216", "\\216"), (#"\217", "\\217"), (#"\218", "\\218"), (#"\219", "\\219"),
    (#"\220", "\\220"), (#"\221", "\\221"), (#"\222", "\\222"), (#"\223", "\\223"),
    (#"\224", "\\224"), (#"\225", "\\225"), (#"\226", "\\226"), (#"\227", "\\227"),
    (#"\228", "\\228"), (#"\229", "\\229"), (#"\230", "\\230"), (#"\231", "\\231"),
    (#"\232", "\\232"), (#"\233", "\\233"), (#"\234", "\\234"), (#"\235", "\\235"),
    (#"\236", "\\236"), (#"\237", "\\237"), (#"\238", "\\238"), (#"\239", "\\239"),
    (#"\240", "\\240"), (#"\241", "\\241"), (#"\242", "\\242"), (#"\243", "\\243"),
    (#"\244", "\\244"), (#"\245", "\\245"), (#"\246", "\\246"), (#"\247", "\\247"),
    (#"\248", "\\248"), (#"\249", "\\249"), (#"\250", "\\250"), (#"\251", "\\251"),
    (#"\252", "\\252"), (#"\253", "\\253"), (#"\254", "\\254"), (#"\255", "\\255")]

  val escapeByte = fn c =>
    case SubsetList.find (spellings, fn (byte, spelling) => byte = c) of
      NONE => SubsetResult.Err (NonByte 0.0)
    | SOME entry => let val (byte, spelling) = entry in SubsetResult.Ok spelling end

  val escapeBytes = fn bytes =>
    let
      val rec go = fn
          ([], offset, parts) => SubsetResult.Ok (SubsetString.concat (SubsetList.reverse parts))
        | (c :: rest, offset, parts) =>
            case escapeByte c of
              SubsetResult.Err error => SubsetResult.Err (NonByte offset)
            | SubsetResult.Ok spelling => go (rest, offset + 1.0, spelling :: parts)
    in go (bytes, 0.0, []) end

  val escapeString = fn value =>
    case SubsetString.fromNative value of
      SubsetResult.Err (SubsetString.NonByte offset) => SubsetResult.Err (NonByte offset)
    | SubsetResult.Ok bytes => escapeBytes bytes
end
