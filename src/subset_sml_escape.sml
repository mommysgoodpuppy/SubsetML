(* Portable SML literal contents for byte characters; quotation marks are supplied by callers. *)
structure SubsetSmlEscape = struct
  datatype error = NonByte of real
  val spellings = [
    (#"\000", "\\^@"), (#"\001", "\\^A"), (#"\002", "\\^B"), (#"\003", "\\^C"),
    (#"\004", "\\^D"), (#"\005", "\\^E"), (#"\006", "\\^F"), (#"\007", "\\a"),
    (#"\008", "\\b"), (#"\009", "\\t"), (#"\010", "\\n"), (#"\011", "\\v"),
    (#"\012", "\\f"), (#"\013", "\\r"), (#"\014", "\\^N"), (#"\015", "\\^O"),
    (#"\016", "\\^P"), (#"\017", "\\^Q"), (#"\018", "\\^R"), (#"\019", "\\^S"),
    (#"\020", "\\^T"), (#"\021", "\\^U"), (#"\022", "\\^V"), (#"\023", "\\^W"),
    (#"\024", "\\^X"), (#"\025", "\\^Y"), (#"\026", "\\^Z"), (#"\027", "\\^["),
    (#"\028", "\\^\\"), (#"\029", "\\^]"), (#"\030", "\\^^"), (#"\031", "\\^_"),
    (#"\032", " "), (#"\033", "!"), (#"\034", "\\\""), (#"\035", "#"),
    (#"\036", "$"), (#"\037", "%"), (#"\038", "&"), (#"\039", "'"),
    (#"\040", "("), (#"\041", ")"), (#"\042", "*"), (#"\043", "+"),
    (#"\044", ","), (#"\045", "-"), (#"\046", "."), (#"\047", "/"),
    (#"\048", "0"), (#"\049", "1"), (#"\050", "2"), (#"\051", "3"),
    (#"\052", "4"), (#"\053", "5"), (#"\054", "6"), (#"\055", "7"),
    (#"\056", "8"), (#"\057", "9"), (#"\058", ":"), (#"\059", ";"),
    (#"\060", "<"), (#"\061", "="), (#"\062", ">"), (#"\063", "?"),
    (#"\064", "@"), (#"\065", "A"), (#"\066", "B"), (#"\067", "C"),
    (#"\068", "D"), (#"\069", "E"), (#"\070", "F"), (#"\071", "G"),
    (#"\072", "H"), (#"\073", "I"), (#"\074", "J"), (#"\075", "K"),
    (#"\076", "L"), (#"\077", "M"), (#"\078", "N"), (#"\079", "O"),
    (#"\080", "P"), (#"\081", "Q"), (#"\082", "R"), (#"\083", "S"),
    (#"\084", "T"), (#"\085", "U"), (#"\086", "V"), (#"\087", "W"),
    (#"\088", "X"), (#"\089", "Y"), (#"\090", "Z"), (#"\091", "["),
    (#"\092", "\\\\"), (#"\093", "]"), (#"\094", "^"), (#"\095", "_"),
    (#"\096", "`"), (#"\097", "a"), (#"\098", "b"), (#"\099", "c"),
    (#"\100", "d"), (#"\101", "e"), (#"\102", "f"), (#"\103", "g"),
    (#"\104", "h"), (#"\105", "i"), (#"\106", "j"), (#"\107", "k"),
    (#"\108", "l"), (#"\109", "m"), (#"\110", "n"), (#"\111", "o"),
    (#"\112", "p"), (#"\113", "q"), (#"\114", "r"), (#"\115", "s"),
    (#"\116", "t"), (#"\117", "u"), (#"\118", "v"), (#"\119", "w"),
    (#"\120", "x"), (#"\121", "y"), (#"\122", "z"), (#"\123", "{"),
    (#"\124", "|"), (#"\125", "}"), (#"\126", "~"), (#"\127", "\\127"),
    (#"\128", "\\128"), (#"\129", "\\129"), (#"\130", "\\130"), (#"\131", "\\131"),
    (#"\132", "\\132"), (#"\133", "\\133"), (#"\134", "\\134"), (#"\135", "\\135"),
    (#"\136", "\\136"), (#"\137", "\\137"), (#"\138", "\\138"), (#"\139", "\\139"),
    (#"\140", "\\140"), (#"\141", "\\141"), (#"\142", "\\142"), (#"\143", "\\143"),
    (#"\144", "\\144"), (#"\145", "\\145"), (#"\146", "\\146"), (#"\147", "\\147"),
    (#"\148", "\\148"), (#"\149", "\\149"), (#"\150", "\\150"), (#"\151", "\\151"),
    (#"\152", "\\152"), (#"\153", "\\153"), (#"\154", "\\154"), (#"\155", "\\155"),
    (#"\156", "\\156"), (#"\157", "\\157"), (#"\158", "\\158"), (#"\159", "\\159"),
    (#"\160", "\\160"), (#"\161", "\\161"), (#"\162", "\\162"), (#"\163", "\\163"),
    (#"\164", "\\164"), (#"\165", "\\165"), (#"\166", "\\166"), (#"\167", "\\167"),
    (#"\168", "\\168"), (#"\169", "\\169"), (#"\170", "\\170"), (#"\171", "\\171"),
    (#"\172", "\\172"), (#"\173", "\\173"), (#"\174", "\\174"), (#"\175", "\\175"),
    (#"\176", "\\176"), (#"\177", "\\177"), (#"\178", "\\178"), (#"\179", "\\179"),
    (#"\180", "\\180"), (#"\181", "\\181"), (#"\182", "\\182"), (#"\183", "\\183"),
    (#"\184", "\\184"), (#"\185", "\\185"), (#"\186", "\\186"), (#"\187", "\\187"),
    (#"\188", "\\188"), (#"\189", "\\189"), (#"\190", "\\190"), (#"\191", "\\191"),
