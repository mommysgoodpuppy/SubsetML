/* @subsetml
from "./subset_natural.sml" import * as SubsetNatural;
*/

/* Persistent binary trie over nonnegative signed integers. Each child stores
   the remaining key bits, so insertion never constructs a 2^31 scale. */

type Map<a> = Empty | Leaf<I32, a> | Branch<Map<a>, Map<a>>;
let empty = Empty;
let rec find = (tree, key) => {
  match(tree) {
    Empty => { None },
    Leaf(stored, value) => { if (stored == key) { Some(value) } else { None } },
    Branch(left, right) => {
      find(
        if (I32.mod(key, (2: I32)) == (0: I32)) { left } else { right },
        I32.div(key, (2: I32))
      )
    }
  }
};
let rec insert = (tree, key, value) => {
  match(tree) {
    Empty => { Leaf(key, value) },
    Leaf(stored, old) => {
      if (stored == key) { Leaf(key, value) } else {
        insert(insert(Branch(Empty, Empty), stored, old), key, value)
      }
    },
    Branch(left, right) => {
      if (I32.mod(key, (2: I32)) == (0: I32)) { Branch(insert(left, I32.div(key, (2: I32)), value), right) } else { Branch(left, insert(right, I32.div(key, (2: I32)), value)) }
    }
  }
};
