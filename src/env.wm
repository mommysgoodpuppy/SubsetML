/* @subsetml
from "./types.sml" import * as Types;
from "./sml_list.sml" import * as SmlList;
*/

// Static environments (Definition §4.2): structures, types and values, newest binding first.

from "./types.wm" import * as Types;
from "./sml_list.wm" import * as SmlList;

from "./types.wm" import *;

// Value identifier status: a variable or a value constructor (no exceptions in SubsetML).
type Status = SValue | SCon;

/* A type structure: a type function (arity, and a body over TGen 0 .. arity-1) and the
   value constructors when it is a datatype. */
type Tystr = | TyStr<Number, Ty, List<(String, Scheme)>>;

// Structures (each marked if it comes from the Basis), types, and values.
type Env =
  | Env<List<(String, (Env, Bool))>, List<(String, Tystr)>, List<(String, (Scheme, Status))>>;

let empty = Env([], [], []);

// `plus (a, b)`: b's bindings shadow a's.
let plus = match {
  (Env(s1, t1, v1), Env(s2, t2, v2)) => {
    Env(List.append(s2, s1), List.append(t2, t1), List.append(v2, v1))
  }
};

let assoc = (key, entries) => {
  match(SmlList.find((k, _) => { k == key })(entries)) {
    Some(entry) => {
      let (key, v) = entry;
      Some(v)
    },
    None => { None }
  }
};

// The environment of a structure path, with whether it comes from the Basis.
let rec structureAt = (env, path) => {
  match(path) {
    [] => { Some(env, false) },
    [name, ..rest] => {
      let Env(strs, _, _) = env;
      match(assoc(name, strs)) {
        Some(entry) => {
          let (inner, basis) = entry;
          match(structureAt(inner, rest)) {
            Some(foundEntry) => {
              let (found, innerBasis) = foundEntry;
              Some(found, if (basis) { true } else { innerBasis })
            },
            None => { None }
          }
        },
        None => { None }
      }
    }
  }
};

let value = (env, (quals, x)) => {
  match(structureAt(env, quals)) {
    Some(entry) => {
      let (Env(strs, tys, vals), basis) = entry;
      assoc(x, vals)
    },
    None => { None }
  }
};

let tycon = (env, (quals, x)) => {
  match(structureAt(env, quals)) {
    Some(entry) => {
      let (Env(strs, tys, vals), basis) = entry;
      assoc(x, tys)
    },
    None => { None }
  }
};

let withValues = (vals) => { Env([], [], vals) };
let withTypes = (tys) => { Env([], tys, []) };
let withStructure = (name, env, basis) => { Env([(name, (env, basis))], [], []) };

// The label sets of the record type declarations in scope (spec R3).
let recordLabelSets = match {
  Env(_, tys, _) => {
    SmlList.concat(SmlList.map(match {
      (_, TyStr(_, TRecord(fields), _)) => { [SmlList.map((l, _) => { l })(fields)] },
      _ => { [] }
    })(tys))
  }
};
