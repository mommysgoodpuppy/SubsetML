      PScon(_, SInt(_)) => { PTyped(p, integerTy) },
      PRecord(q, fs) => { PRecord(q, SmlList.map((l, p) => { (l, lowerPat(p)) })(fs)) },
      PTuple(ps) => { PTuple(SmlList.map(lowerPat)(ps)) },
