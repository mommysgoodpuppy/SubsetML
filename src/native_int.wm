// Legacy source-list command keeps its prelude in the first output file.
let emit = (files) => {
  Unify.bind(project(files))((prelude, outputs) => (st) => {
    Unify.Ok(
      match(outputs) {
        [] => { [] },
        [(Var(path), Var(text)), ..rest] => { [(path, prelude ++ text), ..rest] }
