  (* A character's code; above 255 for a character outside the byte range. *)
  val charCode = fn (c : char) =>
    let
      val rec go = fn
          ([], code) => code
        | (x :: xs, code) => if c = x then code else go (xs, code + 1)
    in go (byteChars, 0) end

  (* Requires 0 <= code <= 255. *)
  val codeChar = fn (code : int) =>
    let
      val rec go = fn
          ([], remaining) => #"\000"
        | (c :: rest, remaining) => if remaining <= 0 then c else go (rest, remaining - 1)
    in go (byteChars, code) end

  (* Requires every code to be from 0 to 255. *)
  val fromCodes = fn (codes : int list) =>
    let
      val rec piece = fn
          ([], remaining) => ""
        | (s :: rest, remaining) => if remaining <= 0 then s else piece (rest, remaining - 1)
      val rec go = fn
          ([], acc) => acc
        | (code :: rest, acc) => go (rest, acc ^ piece (byteStrings, code))
    in go (codes, "") end
end
