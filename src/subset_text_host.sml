    #"\032", #"\033", #"\034", #"\035", #"\036", #"\037", #"\038", #"\039",
    #"\040", #"\041", #"\042", #"\043", #"\044", #"\045", #"\046", #"\047",
    #"\048", #"\049", #"\050", #"\051", #"\052", #"\053", #"\054", #"\055",
    #"\056", #"\057", #"\058", #"\059", #"\060", #"\061", #"\062", #"\063",
    #"\064", #"\065", #"\066", #"\067", #"\068", #"\069", #"\070", #"\071",
