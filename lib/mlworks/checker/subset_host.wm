from "basis/option_value.wm" import * as SubsetOptionValue;
from "basis/result.wm" import * as SubsetResult;

/* Type declarations expressed as checked stubs. Select the native adapter;
   these bodies deliberately cannot perform host operations. */

let canonicalPath = (name: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<String, String>)
};
let readFile = (name: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<String, String>)
};
let writeFile = (data: String, name: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Void, String>)
};
let writeStdout = (data: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Void, String>)
};
let writeStderr = (data: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Void, String>)
};
let arguments = () => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<List<String>, String>)
};
type Status = | Status<I32>;
let success = Status(0);
let failure = Status(1);
let isSuccess = (status: Status) => { match(status) { Status(code) => { code == 0 } } };
let system = (command: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Status, String>)
};
let getEnv = (name: String) => {
  (SubsetOptionValue.None: SubsetOptionValue.Option<String>)
};
let exit = (status: Status) => { void };
let terminate = (status: Status) => { void };
let makeDir = (name: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Void, String>)
};
let removeDir = (name: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Void, String>)
};
let removeFile = (name: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Void, String>)
};
let rename = (source: String, destination: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Void, String>)
};
let isDir = (name: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<Bool, String>)
};
let listDir = (name: String) => {
  (SubsetResult.Err("native adapter required"): SubsetResult.Result<List<String>, String>)
};
